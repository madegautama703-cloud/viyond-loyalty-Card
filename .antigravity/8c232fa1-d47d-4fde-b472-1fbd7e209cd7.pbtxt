        use_fast_apply: true
        replacement_chunks {
          target_content: "      if (idx < ${activeCustomer.currentStamps}) {\n        const img = document.createElement(\'img\');\n        img.src = \'/stamp-icon.png\';\n        img.style.width = \'110%\';\n        img.style.height = \'110%\';\n        img.style.objectFit = \'contain\';\n        slot.appendChild(img);\n      }"
          replacement_content: "      if (idx < ${activeCustomer.currentStamps}) {\n        const img = document.createElement(\'img\');\n        img.src = idx % 2 === 0 ? \'/stamp-roti.png\' : \'/stamp-kopi.png\';\n        img.style.width = \'110%\';\n        img.style.height = \'110%\';\n        img.style.objectFit = \'contain\';\n        slot.appendChild(img);\n      }"
          start_line: 797
          end_line: 807
        }
        replacement_chunks {
          target_content: "                            {STAMP_SLOTS.map((slot) => {\n                              const isStamped =\n                                slot.index <= activeCustomer.currentStamps;\n                              return (\n                                <button\n                                  key={slot.index}\n                                  type=\"button\"\n                                  onClick={(e) =>\n                                    setExactStampCount(\n                                      activeCustomer.id,\n                                      slot.index,\n                                      e\n                                    )\n                                  }\n                                  title={`${t.toggleStampTitle}${slot.index}`}\n                                  aria-label={`Stamp circle ${slot.index}`}\n                                  className={`${slot.gridClass} relative w-full h-full rounded-full flex items-center justify-center cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-[#4A4928] transition-transform active:scale-95`}\n                                >\n                                  {isStamped && (\n                                    <img\n                                      src=\"/stamp-icon.png\"\n                                      alt={`Stamp ${slot.index}`}\n                                      className=\"w-[110%] h-[110%] max-w-none object-contain pointer-events-none select-none transition-all duration-300 scale-100\"\n                                    />\n                                  )}\n                                </button>\n                              );\n                            })}"
          replacement_content: "                            {STAMP_SLOTS.map((slot, index) => {\n                              const isStamped =\n                                slot.index <= activeCustomer.currentStamps;\n                              const stampSrc =\n                                index % 2 === 0\n                                  ? \'/stamp-roti.png\'\n                                  : \'/stamp-kopi.png\';\n                              return (\n                                <button\n                                  key={slot.index}\n                                  type=\"button\"\n                                  onClick={(e) =>\n                                    setExactStampCount(\n                                      activeCustomer.id,\n                                      slot.index,\n                                      e\n                                    )\n                                  }\n                                  title={`${t.toggleStampTitle}${slot.index}`}\n                                  aria-label={`Stamp circle ${slot.index}`}\n                                  className={`${slot.gridClass} relative w-full h-full rounded-full flex items-center justify-center cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-[#4A4928] transition-transform active:scale-95`}\n                                >\n                                  {isStamped && (\n                                    <img\n                                      src={stampSrc}\n                                      alt={`Stamp ${slot.index}`}\n                                      className=\"w-[110%] h-[110%] max-w-none object-contain pointer-events-none select-none transition-all duration-300 scale-100\"\n                                    />\n                                  )}\n                                </button>\n                              );\n                            })}"
          start_line: 1256
          end_line: 1286
        }
      }
