        use_fast_apply: true
        replacement_chunks {
          target_content: "    positions.forEach((pos, idx) => {\n      const slot = document.createElement(\'div\');\n      slot.style.gridRowStart = pos.r;\n      slot.style.gridColumnStart = pos.c;\n      slot.style.position = \'relative\';\n      if (idx < ${activeCustomer.currentStamps}) {\n        const img = document.createElement(\'img\');\n        img.src = idx % 2 === 0 ? \'/stamp-roti.png\' : \'/stamp-kopi.png\';\n        img.style.width = \'110%\';\n        img.style.height = \'110%\';\n        img.style.objectFit = \'contain\';\n        slot.appendChild(img);\n      }\n      grid.appendChild(slot);\n    });"
          replacement_content: "    positions.forEach((pos, idx) => {\n      const slot = document.createElement(\'div\');\n      slot.style.gridRowStart = pos.r;\n      slot.style.gridColumnStart = pos.c;\n      slot.style.position = \'relative\';\n      slot.style.overflow = \'visible\';\n      slot.style.padding = \'8%\';\n      slot.style.display = \'flex\';\n      slot.style.alignItems = \'center\';\n      slot.style.justifyContent = \'center\';\n      if (idx < ${activeCustomer.currentStamps}) {\n        const img = document.createElement(\'img\');\n        img.src = idx % 2 === 0 ? \'/stamp-roti.png\' : \'/stamp-kopi.png\';\n        img.style.width = \'100%\';\n        img.style.height = \'100%\';\n        img.style.objectFit = \'contain\';\n        img.style.display = \'block\';\n        slot.appendChild(img);\n      }\n      grid.appendChild(slot);\n    });"
          start_line: 793
          end_line: 809
        }
        replacement_chunks {
          target_content: "                          <div\n                            className=\"absolute z-10 grid grid-cols-5 grid-rows-2\"\n                            style={{\n                              left: \'14.45%\',\n                              top: \'31.06%\',\n                              width: \'71.07%\',\n                              height: \'44.20%\',\n                              columnGap: \'4.15%\',\n                              rowGap: \'14.80%\',\n                            }}\n                          >\n                            {STAMP_SLOTS.map((slot, index) => {\n                              const isStamped =\n                                slot.index <= activeCustomer.currentStamps;\n                              const stampSrc =\n                                index % 2 === 0\n                                  ? \'/stamp-roti.png\'\n                                  : \'/stamp-kopi.png\';\n                              return (\n                                <button\n                                  key={slot.index}\n                                  type=\"button\"\n                                  onClick={(e) =>\n                                    setExactStampCount(\n                                      activeCustomer.id,\n                                      slot.index,\n                                      e\n                                    )\n                                  }\n                                  title={`${t.toggleStampTitle}${slot.index}`}\n                                  aria-label={`Stamp circle ${slot.index}`}\n                                  className={`${slot.gridClass} relative w-full h-full rounded-full flex items-center justify-center cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-[#4A4928] transition-transform active:scale-95`}\n                                >\n                                  {isStamped && (\n                                    <img\n                                      src={stampSrc}\n                                      alt={`Stamp ${slot.index}`}\n                                      className=\"w-[110%] h-[110%] max-w-none object-contain pointer-events-none select-none transition-all duration-300 scale-100\"\n                                    />\n                                  )}\n                                </button>\n                              );\n                            })}\n                          </div>"
          replacement_content: "                          <div\n                            className=\"absolute z-10 grid grid-cols-5 grid-rows-2 overflow-visible\"\n                            style={{\n                              left: \'14.45%\',\n                              top: \'31.06%\',\n                              width: \'71.07%\',\n                              height: \'44.20%\',\n                              columnGap: \'4.15%\',\n                              rowGap: \'14.80%\',\n                            }}\n                          >\n                            {STAMP_SLOTS.map((slot, index) => {\n                              const isStamped =\n                                slot.index <= activeCustomer.currentStamps;\n                              const stampSrc =\n                                index % 2 === 0\n                                  ? \'/stamp-roti.png\'\n                                  : \'/stamp-kopi.png\';\n                              return (\n                                <button\n                                  key={slot.index}\n                                  type=\"button\"\n                                  onClick={(e) =>\n                                    setExactStampCount(\n                                      activeCustomer.id,\n                                      slot.index,\n                                      e\n                                    )\n                                  }\n                                  title={`${t.toggleStampTitle}${slot.index}`}\n                                  aria-label={`Stamp circle ${slot.index}`}\n                                  className={`${slot.gridClass} relative w-full h-full rounded-full overflow-visible p-[8%] flex items-center justify-center cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-[#4A4928] transition-transform active:scale-95`}\n                                >\n                                  {isS