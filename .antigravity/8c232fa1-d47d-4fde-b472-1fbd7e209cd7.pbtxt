            lines {
              text: "function generateRandomCustomerId(): string {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const blockA = Math.floor(1000 + Math.random() * 9000);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const blockB = Math.floor(100 + Math.random() * 900);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const letters = \'ABCDEFGHJKLMNPQRSTUVWXYZ\';"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const checkChar = letters.charAt(Math.floor(Math.random() * letters.length));"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  return `VSP-${blockA}-${blockB}${checkChar}`;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  return `SIS-${blockA}-${blockB}${checkChar}`;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
