              text: "    <div style=\"font-size:13px;color:#94A3B8;\">Pass Actions \302\267 ${activeCustomer.id}</div>"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    <div style=\"font-size:13px;color:#94A3B8;\">${t.drawerHeader} \302\267 ${activeCustomer.id}</div>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
