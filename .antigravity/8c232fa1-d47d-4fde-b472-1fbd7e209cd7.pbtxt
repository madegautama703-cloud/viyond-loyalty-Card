      thinking_signature: "\022\245\005\n\242\005\001i\024}\023\236\310\332\246%\232\236,T\302\317\307$7\247\236\3305\271\356G\t\211\332$s\2445\251\241\224\240\277,\373Sn\204\375\004\203\334\240?7\023\221\341[\r\033\374\204\022\033\262\021\241\271\243\341j\346V \323\365\233\f\330\"\304\332\\\315S2\216h\304\210\271\221\335\bDM\025\340\305ut\235\255\271\216\026\003\020\"\236\371\fY\254!,\270\377\245t2\002\310\333\205\311\235\226x\234`.\237N\300\026\345G\251\370\030\343\036\360e\004\366\260\033\274.P\256@nM\234sJ\253\331;\305\026]\347^L\246!\350\314\334\350Iu\020\314\005c\303\370R\223\021\314W\271\0066\324\340\023\237\245\224 \\\330\r\375\260\301v?`Cre\310#\241y\177\330`\3263\302A\311\036@\3020N\273%j\\\332\003\035^\375\374 \035/q+Z\307\207|\233\a\363j\300C[\323\305\030Q\212[\223G\312\202\346p/\216\241\331(h\024O\245\234\354\354\242\027\206@p\316p\n\275\316\323\177p\213\343\314\351\'\304v\373\2544\3667\355\341\235\300\301Cq\005\320\030[\355\203\252U+ZJ\341\211`P\277\000c\033\241)\277\217\260N\265\023\310.Z\211r\370\257\200G^\026\264:Y\336c\350X\016\220M%\203A[Von#\204~\257\320\001T\274\312\021\0009_\351\321`s\003\365\263\031\0251\233\314.\241;\037r\332\326\02053k\230,k\333c\t\027f\351\343L\264\020%uj\252\030\227I2\216\324\315(p\034\031y,\357|T\226B\326\342G\263p*3\320i\n\247\213T<{\253\247\364\264\006\350\371\231:\0332\257\356m\341\374\354\036\222\026\270\254Q\345\273R\276\255\252<\341\212l\026\332\266]\207\272\306\"\001\265\254\214\264!Y\354\367&\361\275\344)\002\230nD\357$\"0\272\262>\361!9\2472\204\276\351\261/Ue\2610^\342\312\273\212\317\363n\302\275\025\266\333\r \204;\312\233\312\376\314kg\016\346\027\177\b\212\300\333\223\366\234i\3726=\225A\314\2512\213\337\304\027\177Re\353\275\203C8\202\'\304\365\301\225\350\262\275\263\267\305\020aO\374\362\214g~\320\306\251\264P\330$U\203\214\\\355C\273\v\032\325\3754Y\320\016\227\005\327%a\307n)3\362\205M\316/\246o\031\344\360\217\357\373\260.N\272h\361t\2135\262\355\335\317\316\016\031\212K!(\t~\3601(<\020\354\025"
