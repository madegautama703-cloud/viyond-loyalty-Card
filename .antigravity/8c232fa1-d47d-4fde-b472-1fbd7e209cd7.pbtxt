    command_line: "node -e \'\nconst fs = require(\"fs\");\nconst zlib = require(\"zlib\");\n\nfunction decodePng(filePath) {\n  const buf = fs.readFileSync(filePath);\n  const w = buf.readUInt32BE(16);\n  const h = buf.readUInt32BE(20);\n  let offset = 8;\n  const idatChunks = [];\n  while (offset < buf.length) {\n    const len = buf.readUInt32BE(offset);\n    const type = buf.toString(\"ascii\", offset + 4, offset + 8);\n    if (type === \"IDAT\") {\n      idatChunks.push(buf.subarray(offset + 8, offset + 8 + len));\n    }\n    offset += 12 + len;\n  }\n  const raw = zlib.inflateSync(Buffer.concat(idatChunks));\n  const bpp = 4;\n  const stride = w * bpp;\n  const pixels = Buffer.alloc(w * h * bpp);\n\n  function paeth(a, b, c) {\n    const p = a + b - c;\n    const pa = Math.abs(p - a);\n    const pb = Math.abs(p - b);\n    const pc = Math.abs(p - c);\n    if (pa <= pb && pa <= pc) return a;\n    if (pb <= pc) return b;\n    return c;\n  }\n\n  for (let y = 0; y < h; y++) {\n    const filter = raw[y * (stride + 1)];\n    const rowIn = y * (stride + 1) + 1;\n    const rowOut = y * stride;\n    for (let i = 0; i < stride; i++) {\n      const x = raw[rowIn + i];\n      const a = i >= bpp ? pixels[rowOut + i - bpp] : 0;\n      const b = y > 0 ? pixels[rowOut - stride + i] : 0;\n      const c = (y > 0 && i >= bpp) ? pixels[rowOut - stride + i - bpp] : 0;\n      let val = x;\n      if (filter === 1) val = (x + a) & 0xff;\n      else if (filter === 2) val = (x + b) & 0xff;\n      else if (filter === 3) val = (x + ((a + b) >> 1)) & 0xff;\n      else if (filter === 4) val = (x + paeth(a, b, c)) & 0xff;\n      pixels[rowOut + i] = val;\n    }\n  }\n  return { w, h, pixels };\n}\n\nconst empty = decodePng(\"public/kartu-belakang-kosong.png\");\nconst stamped = decodePng(\"public/assets/aistudio/kartu_belakang_a1c1455d.png\");\n\n// 1. Find white box in bottom right (R>250, G>250, B>250)\nlet minX = empty.w, maxX = 0, minY = empty.h, maxY = 0;\nfor (let y = Math.floor(empty.h * 0.6); y < empty.h; y++) {\n  for (let x = Math.floor(empty.w * 0.7); x < empty.w; x++) {\n    const idx = (y * empty.w + x) * 4;\n    if (empty.pixels[idx] > 250 && empty.pixels[idx+1] > 250 && empty.pixels[idx+2] > 250) {\n      if (x < minX) minX = x;\n      if (x > maxX) maxX = x;\n      if (y < minY) minY = y;\n      if (y > maxY) maxY = y;\n    }\n  }\n}\nconsole.log(\"QR White Box:\", {\n  minX, maxX, minY, maxY,\n  leftPct: (minX / empty.w * 100).toFixed(2),\n  topPct: (minY / empty.h * 100).toFixed(2),\n  widthPct: ((maxX - minX) / empty.w * 100).toFixed(2),\n  heightPct: ((maxY - minY) / empty.h * 100).toFixed(2),\n});\n\n// 2. Find the circles in row 1 (y around 0.25..0.55) and row 2 (y around 0.50..0.80)\n// Scan horizontal line at y = 0.40 * h for dark olive pixels (R < 120)\nconst yRow1 = Math.floor(empty.h * 0.404);\nconst darkX1 = [];\nfor (let x = 0; x < empty.w; x++) {\n  const idx = (yRow1 * empty.w + x) * 4;\n  if (empty.pixels[idx] < 120 && empty.pixels[idx+3] > 128) darkX1.push(x);\n}\n// Group darkX1 into clusters\nfunction cluster(arr) {\n  const groups = [];\n  for (const v of arr) {\n    if (!groups.length || v - groups[groups.length-1][groups[groups.length-1].length-1] > 15) {\n      groups.push([v]);\n    } else {\n      groups[groups.length-1].push(v);\n    }\n  }\n  return groups.map(g => Math.round((g[0] + g[g.length-1]) / 2));\n}\nconst edgesRow1 = cluster(darkX1);\nconsole.log(\"Row 1 circle X edges at y=\" + yRow1 + \":\", edgesRow1);\nfor (let i = 0; i < edgesRow1.length; i += 2) {\n  const left = edgesRow1[i], right = edgesRow1[i+1];\n  const cx = (left + right) / 2;\n  const d = right - left;\n  console.log(`Circle R1_${i/2 + 1}: cx=${(cx/empty.w*100).toFixed(2)}%, left=${(left/empty.w*100).toFixed(2)}%, width=${(d/empty.w*100).toFixed(2)}%`);\n}\n\nconst yRow2 = Math.floor(empty.h * 0.658);\nconst darkX2 = [];\nfor (let x = 0; x < Math.floor(empty.w * 0.75); x++) {\n  const idx = (yRow2 * empty.w + x) * 4;\n  if (empty.pixels[idx] < 120 && empty.pixels[idx+3] > 128) darkX2.push(x);\n}\nconst edgesRow2 = cluster(darkX2);\nconsole.log(\"Row 2 circle X edges at y=\" + yRow2 + \":\", edgesRow2);\nfor (let i = 0; i < edgesRow2.length; i += 2) {\n  const left = edgesRow2[i], right = edgesRow2[i+1];\n  const cx = (left + right) / 2;\n  const d = right - left;\n  console.log(`Circle R2_${i/2 + 1}: cx=${(cx/empty.w*100).toFixed(2)}%, left=${(left/empty.w*100).toFixed(2)}%, width=${(d/empty.w*100).toFixed(2)}%`);\n}\n\n// Find vertical edges of Circle 1 at x = Math.round((edgesRow1[0] + edgesRow1[1])/2)\nconst cx1 = Math.round((edgesRow1[0] + edgesRow1[1]) / 2);\nconst darkY1 = [];\nfor (let y = Math.floor(empty.h * 0.25); y < Math.floor(empty.h * 0.85); y++) {\n  const idx = (y * empty.w + cx1) * 4;\n  if (empty.pixels[idx] < 120 && empty.pixels[idx+3] > 128) darkY1.push(y);\n}\nconsole.log(\"Circle 1 Y edges:\", cluster(darkY1).map(y => ({ y, pct: (y/empty.h*100).toFixed(2) + \"%\" })));\n\nconst cx2 = Math.round((edgesRow2[0] + edgesRow2[1]) / 2);\nconst darkY2 = [];\nfor (let y = Math.floor(empty.h * 0.25); y < Math.floor(empty.h * 0.85); y++) {\n  const idx = (y * empty.w + cx2) * 4;\n  if (empty.pixels[idx] < 120 && empty.pixels[idx+3] > 128) darkY2.push(y);\n}\nconsole.log(\"Circle Row1 & Row2 Y edges at col 2:\", cluster(darkY2).map(y => ({ y, pct: (y/empty.h*100).toFixed(2) + \"%\" })));\n\'"
