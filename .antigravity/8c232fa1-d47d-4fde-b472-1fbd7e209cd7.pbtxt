            lines {
              text: "  <script>"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    let cid = localStorage.getItem(\'vespera_anon_customer_id\');"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    if (!cid) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      cid = \'VSP-\' + Math.floor(1000 + Math.random() * 9000) + \'-\' + Math.floor(100 + Math.random() * 900) + \'K\';"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      localStorage.setItem(\'vespera_anon_customer_id\', cid);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    document.getElementById(\'cidLabel\').textContent = \'ID: \' + cid;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    document.getElementById(\'frontCid\').textContent = cid;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    document.getElementById(\'qrImg\').src = \'https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=\' + encodeURIComponent(cid);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const flipper = document.getElementById(\'cardFlipper\');"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const drawer = document.getElementById(\'actionDrawer\');"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const stampGrid = document.getElementById(\'stampGrid\');"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    let flipped = false;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    for (let i = 1; i <= 10; i++) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const el = document.createElement(\'div\');"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      el.className = \'stamp\' + (i <= ${activeCustomer.currentStamps} ? \' active\' : \'\');"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      el.textContent = i <= ${activeCustomer.currentStamps} ? \'\342\230\205\' : String(i).padStart(2, \'0\');"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      stampGrid.appendChild(el);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    function toggleFlip() {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      flipped = !flipped;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      flipper.classList.toggle(\'flipped\', flipped);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      drawer.classList.toggle(\'open\', flipped);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    document.getElementById(\'cardTilt\').addEventListener(\'click\', toggleFlip);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    document.getElementById(\'flipBtn\').addEventListener(\'click\', toggleFlip);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  </script>"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
