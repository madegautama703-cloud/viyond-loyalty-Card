      create_file {
        instruction: "\'use client\';\n\nimport React, { useState, useEffect, useRef, useMemo } from \'react\';\nimport {\n  RotateCw,\n  Smartphone,\n  Sparkles,\n  Check,\n  Plus,\n  Minus,\n  Award,\n  Mail,\n  Search,\n  Download,\n  Sliders,\n  ChevronDown,\n  X,\n  Globe,\n  Home,\n  Share,\n  WifiOff,\n  HardDrive,\n} from \'lucide-react\';\n\ntype Language = \'id\' | \'en\';\n\ninterface BeforeInstallPromptEvent extends Event {\n  prompt: () => Promise<void>;\n  userChoice: Promise<{ outcome: \'accepted\' | \'dismissed\'; platform: string }>;\n}\n\ninterface CustomerRecord {\n  id: string;\n  name: string;\n  email: string;\n  tier: string;\n  currentStamps: number;\n  totalRedeemedStamps: number;\n  lastVisit: string;\n  isLocalDevice?: boolean;\n}\n\nconst STORAGE_KEYS = {\n  CUSTOMER_ID: \'vespera_anon_customer_id\',\n  CURRENT_STAMPS: \'vespera_anon_current_stamps\',\n  REDEEMED_STAMPS: \'vespera_anon_redeemed_stamps\',\n  BACKUP_EMAIL: \'vespera_anon_backup_email\',\n  PWA_SHORTCUT_PINNED: \'vespera_pwa_shortcut_pinned\',\n};\n\nfunction generateRandomCustomerId(): string {\n  const blockA = Math.floor(1000 + Math.random() * 9000);\n  const blockB = Math.floor(100 + Math.random() * 900);\n  const letters = \'ABCDEFGHJKLMNPQRSTUVWXYZ\';\n  const checkChar = letters.charAt(Math.floor(Math.random() * letters.length));\n  return `VSP-${blockA}-${blockB}${checkChar}`;\n}\n\nconst MOCK_B2B_CUSTOMERS: CustomerRecord[] = [\n  {\n    id: \'VSP-8842-901K\',\n    name: \'Elena Rostova\',\n    email: \'elena.rostova@atelier-mail.com\',\n    tier: \'Obsidian Member\',\n    currentStamps: 7,\n    totalRedeemedStamps: 40,\n    lastVisit: \'2026-10-30\',\n  },\n  {\n    id: \'VSP-3109-442M\',\n    name: \'Marcus Vance\',\n    email: \'m.vance@kinetix.io\',\n    tier: \'Titanium Member\',\n    currentStamps: 10,\n    totalRedeemedStamps: 70,\n    lastVisit: \'2026-10-29\',\n  },\n  {\n    id: \'VSP-6591-208J\',\n    name: \'Sora Takahashi\',\n    email: \'sora@studio-takahashi.jp\',\n    tier: \'Obsidian Member\',\n    currentStamps: 4,\n    totalRedeemedStamps: 20,\n    lastVisit: \'2026-10-28\',\n  },\n  {\n    id: \'VSP-1940-773R\',\n    name: \'Julian Sterling\',\n    email: \'j.sterling@sterlingarch.co\',\n    tier: \'Platinum Member\',\n    currentStamps: 9,\n    totalRedeemedStamps: 50,\n    lastVisit: \'2026-10-27\',\n  },\n  {\n    id: \'VSP-5028-619D\',\n    name: \'Amara Okafor\',\n    email: \'amara@lumina-design.org\',\n    tier: \'Titanium Member\',\n    currentStamps: 2,\n    totalRedeemedStamps: 10,\n    lastVisit: \'2026-10-25\',\n  },\n];\n\nconst TRANSLATIONS = {\n  id: {\n    navFront: \'Tampak Depan\',\n    navGrid: \'Grid 10 Stempel\',\n    navPwa: \'Pintasan PWA\',\n    navB2B: \'Buku Besar B2B\',\n    ctaIssueStamp: \'Tambah +1 Stempel\',\n    stampsActive: \'Stempel Aktif\',\n    totalRedeemedLabel: \'Total Ditukar\',\n    localSavedBadge: \'Tersimpan Permanen di Perangkat (Anonim)\',\n    modeSplit: \'Kartu + B2B\',\n    modePass: \'Fokus Kartu\',\n    modeDashboard: \'Dasbor B2B\',\n    exportHtml: \'Ekspor HTML\',\n    stageFrontLabel: \'Sisi Depan \302\267 Emblem Titanium Sikat\',\n    stageBackLabel: \'Sisi Belakang \302\267 Grid 10 Stempel & QR\',\n    tiltLabel: \'Kemiringan\',\n    flipToFront: \'Balik ke Depan\',\n    flipToBack: \'Balik ke Belakang\',\n    cardAriaLabel:\n      \'Kartu Loyalitas Digital Logam. Ketuk atau tekan Enter untuk membalik antara sisi depan dan 10 stempel di belakang.\',\n    cardFrontTag: \'KARTU TITANIUM\',\n    cardFrontSubtitle: \'ROASTERY ARSITEKTURAL\',\n    cardholderLabel: \'Kartu Perangkat Anonim\',\n    tapToFlip: \'Ketuk untuk balik\',\n    stampLedgerTitle: \'BUKU STEMPEL\',\n    toggleStampTitle: \'Ubah Stempel #\',\n    completeRewardReady: \'10 / 10 Lengkap \302\267 Hadiah Siap Ditukar\',\n    stampsCollectedOf10: (count: number) => `${count} dari 10 Stempel Terkumpul`,\n    presentQrToRedeem: \'Tunjukkan kode QR untuk klaim kopi reserve gratis\',\n    moreForReward: (rem: number) =>\n      `${rem} stempel lagi untuk kopi reserve gratis`,\n    stageFooterHint:\n      \'Klik permukaan kartu untuk membalik 3D \302\267 Klik lingkaran di belakang untuk atur stempel\',\n    drawerActiveBelow: \'Menu Tarik Aktif di Bawah \342\206\223\',\n    flipForWalletActions: \'Balik ke Belakang untuk Menu Pintasan & Cadangan\',\n    studioTitle: \'Studio Kartu & Kontrol Giroskop\',\n    studioSubtitle:\n      \'Penyimpanan lokal anonim otomatis tanpa login, penerbitan stempel, & orientasi 3-sumbu\',\n    gyroLinked: \'Sensor Terhubung\',\n    pairMotionSensor: \'Hubungkan Sensor Gerak\',\n    activeCardholderProfile: \'Profil Kartu Aktif (Lokal & B2B)\',\n    localDeviceMemberName: \'Tamu Perangkat Ini (Anonim)\',\n    stampsWord: \'stempel\',\n    stampProgress: \'Progres Stempel\',\n    lifetimeRedeemed: \'Total Ditukar Seumur Hidup\',\n    btnRemove: \'Kurangi\',\n    btnStampPlus: \'Stempel +1\',\n    btnRedeem10: \'Tukar 10\',\n    gyroSimulatorTitle: \'Simulator Kemiringan DeviceOrientation\',\n    resetAxis: \'Reset Sumbu\',\n    pitchLabel: \'Pitch (Sumbu-X Beta)\',\n    rollLabel: \'Roll (Sumbu-Y Gamma)\',\n    drawerHintOpen: \'Menu tarik pintasan PWA & cadangan aktif di bagian bawah layar.\',\n    drawerHintClosed:\n      \'Balik kartu ke sisi belakang untuk memunculkan menu Tambahkan ke Layar Utama.\',\n    showFrontFace: \'Lihat Sisi Depan\',\n    flipAndOpenDrawer: \'Balik & Buka Menu\',\n    b2bTitle: \'Direktori Stempel & Penukaran Pelanggan B2B\',\n    b2bSubtitle:\n      \'Buku besar merchant langsung yang melacak ID pelanggan anonim, progres kartu aktif, dan total stempel yang ditukarkan.\',\n    kpiRegistered: \'Total ID Kartu Aktif\',\n    kpiTotalRedeemed: \'Total Stempel Ditukarkan\',\n    kpiActiveUnredeemed: \'Stempel Aktif Belum Ditukar\',\n    kpiRewardsReady: \'Hadiah Siap Klaim (10/10)\',\n    searchPlaceholder: \'Cari pelanggan, ID (VSP-...), atau status perangkat...\',\n    filterAll: \'Semua Kartu\',\n    filterReady: \'Siap Klaim (10/10)\',\n    filterVip: \'40+ Ditukar\',\n    thCustomerName: \'Nama / Perangkat Pelanggan\',\n    thCustomerId: \'ID Pelanggan\',\n    thActiveGrid: \'Grid Kartu Aktif\',\n    thTotalRedeemed: \'Total Stempel Ditukar\',\n    thMerchantActions: \'Aksi Merchant\',\n    noRecordsMatch: \'Tidak ada data pelanggan yang cocok dengan\',\n    activeOn3dCard: \'\302\267 Aktif di Kartu 3D\',\n    localDeviceTag: \'Perangkat Ini \302\267 localStorage\',\n    drawerHeader: \'Pintasan Aplikasi & Cadangan Kartu\',\n    flipFrontToDismiss: \'Balik ke Depan untuk Menutup\',\n    btnAddToHomeScreen: \'Add to Home Screen\',\n    btnAddToHomeScreenSub: \'Tambahkan ke Layar Utama (PWA)\',\n    btnEmailBackup: \'Email Backup\',\n    btnEmailBackupSub: \'Cadangan Email\',\n    modalPwaTitle: \'Tambahkan ke Layar Utama (Pintasan PWA)\',\n    modalEmailTitle: \'Cadangan Email Kartu Terenkripsi\',\n    modalLocalIdLabel: \'ID Pelanggan Anonim (localStorage)\',\n    modalStorageState: \'Status Penyimpanan\',\n    modalStoragePermanent: \'Permanen \302\267 Tanpa Login\',\n    modalSyncedBalance: \'Saldo Stempel Saat Ini\',\n    pwaInstructionsTitle: \'Cara Memasang Pintasan Aplikasi Web (PWA):\',\n    pwaIosStep1:\n      \'1. Di Safari iOS, ketuk ikon Bagikan (Share) di bilah bawah.\',\n    pwaIosStep2:\n      \'2. Pilih \"Tambahkan ke Layar Utama\" (Add to Home Screen) untuk akses instan.\',\n    pwaAndroidStep:\n      \'Di Chrome / Android / Desktop: Ketuk tombol \"Pasang Pintasan PWA Sekarang\" di bawah atau pilih \"Install Vespera\" pada menu browser.\',\n    btnClose: \'Tutup\',\n    btnCancel: \'Batal\',\n    btnInstallPwaNow: \'Pasang Pintasan PWA Sekarang\',\n    emailModalDesc:\n      \'Kirim tautan pemulihan terenkripsi berisi kode QR unik dan saldo stempel lokal Anda\',\n    emailModalToAddress: \'ke alamat email Anda:\',\n    recipientEmailLabel: \'Email Penerima Cadangan\',\n    btnSendRecovery: \'Kirim Kartu Pemulihan\',\n    offlineBanner:\n      \'Mode Offline \342\200\224 ID Kartu & Stempel Anda tetap aman di penyimpanan lokal.\',\n    toastIssuedStamp: (delta: number, id: string) =>\n      `Berhasil menambahkan +${delta} stempel ke ${id}`,\n    toastNeed10Stamps:\n      \'Kumpulkan seluruh 10 stempel untuk menukarkan hadiah gratis\',\n    toastRedeemed10: (name: string) =>\n      `Berhasil menukar 10 stempel untuk ${name} (+10 tercatat di buku B2B)`,\n    toastExportHtml: \'Berhasil mengunduh file tunggal HTML mandiri\',\n    toastGyroLinked: \'Sensor gerak DeviceOrientation berhasil terhubung\',\n    toastGyroDeclined:\n      \'Izin sensor ditolak \342\200\224 menggunakan kemiringan sentuh interaktif\',\n    toastGyroActive:\n      \'Pendengar DeviceOrientation aktif \342\200\224 miringkan ponsel atau geser kartu\',\n    toastGyroSimulated: \'Menggunakan simulator kursor & giroskop interaktif\',\n    toastPwaInstalled: (id: string) =>\n      `Pintasan PWA Vespera (${id}) berhasil dipasang ke Layar Utama`,\n    toastEmailSent: (id: string, email: string) =>\n      `Cadangan kartu (${id}) dikirim ke ${email}`,\n    toastLangChanged: \'Bahasa diubah ke Bahasa Indonesia\',\n  },\n  en: {\n    navFront: \'Card Front\',\n    navGrid: \'10-Stamp Grid\',\n    navPwa: \'PWA Shortcut\',\n    navB2B: \'B2B Ledger\',\n    ctaIssueStamp: \'Issue +1 Stamp\',\n    stampsActive: \'Stamps Active\',\n    totalRedeemedLabel: \'Total Redeemed\',\n    localSavedBadge: \'Saved Permanently in Browser (Anonymous)\',\n    modeSplit: \'Pass + B2B Split\',\n    modePass: \'Card Focus\',\n    modeDashboard: \'B2B Dashboard Mode\',\n    exportHtml: \'Export HTML\',\n    stageFrontLabel: \'Front Face \302\267 Brushed Titanium Emblem\',\n    stageBackLabel: \'Back Face \302\267 10-Stamp Grid & QR\',\n    tiltLabel: \'Tilt\',\n    flipToFront: \'Flip to Front\',\n    flipToBack: \'Flip to Back\',\n    cardAriaLabel:\n      \'Digital Loyalty Metal Card. Tap or press Enter to flip between brand front and 10-stamp back.\',\n    cardFrontTag: \'TITANIUM RESERVE\',\n    cardFrontSubtitle: \'ARCHITECTURAL ROASTERY\',\n    cardholderLabel: \'Anonymous Device Pass\',\n    tapToFlip: \'Tap to flip\',\n    stampLedgerTitle: \'STAMP LEDGER\',\n    toggleStampTitle: \'Toggle Stamp #\',\n    completeRewardReady: \'10 / 10 Complete \302\267 Reward Ready\',\n    stampsCollectedOf10: (count: number) => `${count} of 10 Stamps Collected`,\n    presentQrToRedeem: \'Present QR code to redeem complimentary reserve\',\n    moreForReward: (rem: number) =>\n      `${rem} more for complimentary reserve roast`,\n    stageFooterHint:\n      \'Click card surface to flip 3D pass \302\267 Click any circular recess on the back to adjust stamps\',\n    drawerActiveBelow: \'Drawer Active Below \342\206\223\',\n    flipForWalletActions: \'Flip to Back for Home Screen & Backup Menu\',\n    studioTitle: \'Pass Studio & Gyro Controls\',\n    studioSubtitle:\n      \'Zero-login anonymous localStorage persistence, stamp issuance, & 3-axis orientation\',\n    gyroLinked: \'Gyro Linked\',\n    pairMotionSensor: \'Pair Motion Sensor\',\n    activeCardholderProfile: \'Active Pass Profile (Local & B2B)\',\n    localDeviceMemberName: \'This Device Guest (Anonymous)\',\n    stampsWord: \'stamps\',\n    stampProgress: \'Stamp Progress\',\n    lifetimeRedeemed: \'Lifetime Redeemed\',\n    btnRemove: \'Remove\',\n    btnStampPlus: \'Stamp +1\',\n    btnRedeem10: \'Redeem 10\',\n    gyroSimulatorTitle: \'DeviceOrientation Tilt Simulator\',\n    resetAxis: \'Reset Axis\',\n    pitchLabel: \'Pitch (Beta X-Axis)\',\n    rollLabel: \'Roll (Gamma Y-Axis)\',\n    drawerHintOpen:\n      \'Slide-up PWA Home Screen & Backup drawer is active at the bottom.\',\n    drawerHintClosed:\n      \'Flip the card to the back to reveal the Add to Home Screen & Email Backup drawer.\',\n    showFrontFace: \'Show Front Face\',\n    flipAndOpenDrawer: \'Flip & Open Drawer\',\n    b2bTitle: \'B2B Customer Stamp & Redemption Directory\',\n    b2bSubtitle:\n      \'Live merchant ledger tracking anonymous Customer IDs, active pass progress, and cumulative redeemed stamps.\',\n    kpiRegistered: \'Active Card IDs\',\n    kpiTotalRedeemed: \'Total Redeemed Stamps\',\n    kpiActiveUnredeemed: \'Active Unredeemed Stamps\',\n    kpiRewardsReady: \'Rewards Ready (10/10)\',\n    searchPlaceholder: \'Search by customer name, ID (VSP-...), or device...\',\n    filterAll: \'All Passes\',\n    filterReady: \'Reward Ready (10/10)\',\n    filterVip: \'40+ Redeemed\',\n    thCustomerName: \'Customer Name / Device\',\n    thCustomerId: \'Customer ID\',\n    thActiveGrid: \'Active Card Grid\',\n    thTotalRedeemed: \'Total Redeemed Stamps\',\n    thMerchantActions: \'Merchant Actions\',\n    noRecordsMatch: \'No customer records match\',\n    activeOn3dCard: \'\302\267 Active on 3D Card\',\n    localDeviceTag: \'This Browser \302\267 localStorage\',\n    drawerHeader: \'PWA Shortcut & Pass Backup\',\n    flipFrontToDismiss: \'Flip to Front to Dismiss\',\n    btnAddToHomeScreen: \'Add to Home Screen\',\n    btnAddToHomeScreenSub: \'Install PWA App Shortcut\',\n    btnEmailBackup: \'Email Backup\',\n    btnEmailBackupSub: \'Send Recovery Link\',\n    modalPwaTitle: \'Add to Home Screen (PWA Shortcut)\',\n    modalEmailTitle: \'Encrypted Pass Email Backup\',\n    modalLocalIdLabel: \'Anonymous Customer ID (localStorage)\',\n    modalStorageState: \'Storage Persistence\',\n    modalStoragePermanent: \'Permanent \302\267 No Login Required\',\n    modalSyncedBalance: \'Current Stamp Balance\',\n    pwaInstructionsTitle: \'How to Install as a Home Screen Web App:\',\n    pwaIosStep1:\n      \'1. In iOS Safari, tap the Share icon in the bottom navigation bar.\',\n    pwaIosStep2:\n      \'2. Scroll down and select \"Add to Home Screen\" for instant 1-tap access.\',\n    pwaAndroidStep:\n      \'On Chrome / Android / Desktop: Click \"Install PWA Shortcut Now\" below or choose \"Install Vespera\" from your browser menu.\',\n    btnClose: \'Close\',\n    btnCancel: \'Cancel\',\n    btnInstallPwaNow: \'Install PWA Shortcut Now\',\n    emailModalDesc:\n      \'Send an encrypted recovery link containing your unique QR code and local stamp balance\',\n    emailModalToAddress: \'to your email address:\',\n    recipientEmailLabel: \'Backup Recipient Email\',\n    btnSendRecovery: \'Send Recovery Pass\',\n    offlineBanner:\n      \'Offline Mode \342\200\224 Your anonymous Customer ID & stamps remain safely stored in localStorage.\',\n    toastIssuedStamp: (delta: number, id: string) =>\n      `Issued +${delta} stamp to ${id}`,\n    toastNeed10Stamps:\n      \'Collect all 10 stamps to redeem a complimentary reward\',\n    toastRedeemed10: (name: string) =>\n      `Redeemed 10 stamps for ${name} (+10 added to B2B ledger)`,\n    toastExportHtml: \'Downloaded standalone single-file HTML bundle\',\n    toastGyroLinked: \'DeviceOrientation motion sensor linked\',\n    toastGyroDeclined:\n      \'Motion permission declined \342\200\224 using interactive touch tilt\',\n    toastGyroActive:\n      \'DeviceOrientation listener active \342\200\224 tilt your device or drag card\',\n    toastGyroSimulated: \'Using interactive pointer & gyroscope simulator\',\n    toastPwaInstalled: (id: string) =>\n      `Vespera PWA shortcut (${id}) installed to Home Screen`,\n    toastEmailSent: (id: string, email: string) =>\n      `Backup pass (${id}) sent to ${email}`,\n    toastLangChanged: \'Language switched to English\',\n  },\n};\n\n// Deterministic 13x13 QR Matrix generator from Customer ID\nfunction generateQrMatrix(seedStr: string): boolean[][] {\n  const size = 13;\n  const grid: boolean[][] = Array.from({ length: size }, () =>\n    Array(size).fill(false)\n  );\n\n  const drawFinder = (r0: number, c0: number) => {\n    for (let r = 0; r < 4; r++) {\n      for (let c = 0; c < 4; c++) {\n        if (\n          r === 0 ||\n          r === 3 ||\n          c === 0 ||\n          c === 3 ||\n          (r >= 1 && r <= 2 && c >= 1 && c <= 2)\n        ) {\n          grid[r0 + r][c0 + c] = true;\n        }\n      }\n    }\n  };\n\n  drawFinder(0, 0);\n  drawFinder(0, size - 4);\n  drawFinder(size - 4, 0);\n\n  let hash = 2166136261;\n  for (let i = 0; i < seedStr.length; i++) {\n    hash ^= seedStr.charCodeAt(i);\n    hash = Math.imul(hash, 16777619);\n  }\n\n  for (let r = 0; r < size; r++) {\n    for (let c = 0; c < size; c++) {\n      const inTopLeft = r < 5 && c < 5;\n      const inTopRight = r < 5 && c >= size - 5;\n      const inBottomLeft = r >= size - 5 && c < 5;\n      if (inTopLeft || inTopRight || inBottomLeft) continue;\n\n      hash ^= (r * 31 + c * 17) & 0xff;\n      hash = Math.imul(hash, 16777619);\n      grid[r][c] = Math.abs(hash) % 10 < 5;\n    }\n  }\n  return grid;\n}\n\nexport default function DigitalLoyaltyApp() {\n  const [lang, setLang] = useState<Language>(\'id\');\n  const t = TRANSLATIONS[lang];\n\n  // Anonymous LocalStorage Customer State + Mock B2B Ledger\n  const [customers, setCustomers] = useState<CustomerRecord[]>(MOCK_B2B_CUSTOMERS);\n  const [selectedCustomerId, setSelectedCustomerId] = useState<string>(\n    MOCK_B2B_CUSTOMERS[0].id\n  );\n  const [localCustomerId, setLocalCustomerId] = useState<string>(\'\');\n\n  // PWA Install Prompt & Connectivity State\n  const [deferredPrompt, setDeferredPrompt] =\n    useState<BeforeInstallPromptEvent | null>(null);\n  const [isPwaInstalled, setIsPwaInstalled] = useState<boolean>(false);\n  const [isIOS, setIsIOS] = useState<boolean>(false);\n  const [isOnline, setIsOnline] = useState<boolean>(true);\n\n  // Card Interactivity State\n  const [isFlipped, setIsFlipped] = useState<boolean>(false);\n  const [tilt, setTilt] = useState<{ rx: number; ry: number; gx: number; gy: number }>({\n    rx: 0,\n    ry: 0,\n    gx: 50,\n    gy: 50,\n  });\n  const [gyroStatus, setGyroStatus] = useState<\'idle\' | \'active\' | \'simulated\'>(\'idle\');\n\n  // View / Dashboard Mode State\n  const [viewMode, setViewMode] = useState<\'pass\' | \'dashboard\' | \'split\'>(\'split\');\n  const [searchQuery, setSearchQuery] = useState<string>(\'\');\n  const [tableFilter, setTableFilter] = useState<\'all\' | \'ready\' | \'vip\'>(\'all\');\n\n  // Slide-Up Drawer Action Modal State (\'pwa\' | \'email\' | null)\n  const [actionModal, setActionModal] = useState<{\n    type: \'pwa\' | \'email\' | null;\n    emailInput?: string;\n  }>({ type: null });\n\n  const [toastMessage, setToastMessage] = useState<string | null>(null);\n  const cardStageRef = useRef<HTMLDivElement | null>(null);\n\n  const triggerToast = (msg: string) => {\n    setToastMessage(msg);\n  };\n\n  useEffect(() => {\n    if (!toastMessage) return;\n    const timer = setTimeout(() => setToastMessage(null), 3200);\n    return () => clearTimeout(timer);\n  }, [toastMessage]);\n\n  // 1. Anonymous Local Storage Initialization on First Page Load (Zero Login Required)\n  useEffect(() => {\n    try {\n      let storedId = window.localStorage.getItem(STORAGE_KEYS.CUSTOMER_ID);\n      if (!storedId) {\n        storedId = generateRandomCustomerId();\n        window.localStorage.setItem(STORAGE_KEYS.CUSTOMER_ID, storedId);\n      }\n\n      const rawStamps = window.localStorage.getItem(STORAGE_KEYS.CURRENT_STAMPS);\n      const parsedStamps =\n        rawStamps !== null ? Math.max(0, Math.min(10, parseInt(rawStamps, 10) || 0)) : 6;\n      if (rawStamps === null) {\n        window.localStorage.setItem(STORAGE_KEYS.CURRENT_STAMPS, String(parsedStamps));\n      }\n\n      const rawRedeemed = window.localStorage.getItem(STORAGE_KEYS.REDEEMED_STAMPS);\n      const parsedRedeemed =\n        rawRedeemed !== null ? Math.max(0, parseInt(rawRedeemed, 10) || 0) : 20;\n      if (rawRedeemed === null) {\n        window.localStorage.setItem(\n          STORAGE_KEYS.REDEEMED_STAMPS,\n          String(parsedRedeemed)\n        );\n      }\n\n      const savedEmail =\n        window.localStorage.getItem(STORAGE_KEYS.BACKUP_EMAIL) ||\n        \'guest.pass@local-device.io\';\n\n      const anonRecord: CustomerRecord = {\n        id: storedId,\n        name: \'Anonymous Local Pass\',\n        email: savedEmail,\n        tier: \'Titanium Local Pass\',\n        currentStamps: parsedStamps,\n        totalRedeemedStamps: parsedRedeemed,\n        lastVisit: \'2026-10-30\',\n        isLocalDevice: true,\n      };\n\n      setLocalCustomerId(storedId);\n      setCustomers([anonRecord, ...MOCK_B2B_CUSTOMERS]);\n      setSelectedCustomerId(storedId);\n    } catch {\n      // Fallback if localStorage is restricted\n      const fallbackId = \'VSP-9042-718K\';\n      setLocalCustomerId(fallbackId);\n    }\n  }, []);\n\n  // 2. Service Worker Registration, PWA Install Event & Online Status Listeners\n  useEffect(() => {\n    if (\'serviceWorker\' in navigator) {\n      navigator.serviceWorker.register(\'/sw.js\').catch(() => {});\n    }\n\n    const isStandalone =\n      window.matchMedia(\'(display-mode: standalone)\').matches ||\n      (window.navigator as unknown as { standalone?: boolean }).standalone ===\n        true ||\n      window.localStorage.getItem(STORAGE_KEYS.PWA_SHORTCUT_PINNED) === \'true\';\n    setIsPwaInstalled(isStandalone);\n\n    const ua = window.navigator.userAgent.toLowerCase();\n    setIsIOS(/iphone|ipad|ipod/.test(ua));\n    setIsOnline(window.navigator.onLine);\n\n    const handleBeforeInstallPrompt = (e: Event) => {\n      e.preventDefault();\n      setDeferredPrompt(e as BeforeInstallPromptEvent);\n    };\n\n    const handleAppInstalled = () => {\n      setIsPwaInstalled(true);\n      setDeferredPrompt(null);\n      try {\n        window.localStorage.setItem(STORAGE_KEYS.PWA_SHORTCUT_PINNED, \'true\');\n      } catch {}\n    };\n\n    const handleOnline = () => setIsOnline(true);\n    const handleOffline = () => setIsOnline(false);\n\n    window.addEventListener(\'beforeinstallprompt\', handleBeforeInstallPrompt);\n    window.addEventListener(\'appinstalled\', handleAppInstalled);\n    window.addEventListener(\'online\', handleOnline);\n    window.addEventListener(\'offline\', handleOffline);\n\n    return () => {\n      window.removeEventListener(\n        \'beforeinstallprompt\',\n        handleBeforeInstallPrompt\n      );\n      window.removeEventListener(\'appinstalled\', handleAppInstalled);\n      window.removeEventListener(\'online\', handleOnline);\n      window.removeEventListener(\'offline\', handleOffline);\n    };\n  }, []);\n\n  const activeCustomer = useMemo(\n    () =>\n      customers.find((c) => c.id === selectedCustomerId) || customers[0],\n    [customers, selectedCustomerId]\n  );\n\n  // Sync changes to local device pass into localStorage permanently\n  const persistLocalCustomerUpdate = (\n    customerId: string,\n    nextStamps: number,\n    nextRedeemed: number\n  ) => {\n    if (customerId !== localCustomerId) return;\n    try {\n      window.localStorage.setItem(STORAGE_KEYS.CURRENT_STAMPS, String(nextStamps));\n      window.localStorage.setItem(\n        STORAGE_KEYS.REDEEMED_STAMPS,\n        String(nextRedeemed)\n      );\n    } catch {}\n  };\n\n  // DeviceOrientation API Listener for Physical Phone Tilt\n  useEffect(() => {\n    const handleOrientation = (event: DeviceOrientationEvent) => {\n      if (event.beta === null || event.gamma === null) return;\n      const normalizedBeta = Math.max(-30, Math.min(30, event.beta - 40));\n      const normalizedGamma = Math.max(-30, Math.min(30, event.gamma));\n\n      const rx = Number((-normalizedBeta * 0.55).toFixed(2));\n      const ry = Number((normalizedGamma * 0.65).toFixed(2));\n      const gx = Math.round(50 + (normalizedGamma / 30) * 40);\n      const gy = Math.round(50 + (normalizedBeta / 30) * 40);\n\n      setGyroStatus(\'active\');\n      setTilt({ rx, ry, gx, gy });\n    };\n\n    window.addEventListener(\'deviceorientation\', handleOrientation, true);\n    return () => {\n      window.removeEventListener(\'deviceorientation\', handleOrientation, true);\n    };\n  }, []);\n\n  const requestGyroPermission = async () => {\n    try {\n      const DeviceOrientationEventTyped = DeviceOrientationEvent as unknown as {\n        requestPermission?: () => Promise<\'granted\' | \'denied\'>;\n      };\n      if (typeof DeviceOrientationEventTyped.requestPermission === \'function\') {\n        const permission = await DeviceOrientationEventTyped.requestPermission();\n        if (permission === \'granted\') {\n          setGyroStatus(\'active\');\n          triggerToast(t.toastGyroLinked);\n        } else {\n          triggerToast(t.toastGyroDeclined);\n        }\n      } else {\n        setGyroStatus(\'active\');\n        triggerToast(t.toastGyroActive);\n      }\n    } catch {\n      setGyroStatus(\'simulated\');\n      triggerToast(t.toastGyroSimulated);\n    }\n  };\n\n  const handleStagePointerMove = (e: React.PointerEvent<HTMLDivElement>) => {\n    if (!cardStageRef.current) return;\n    const rect = cardStageRef.current.getBoundingClientRect();\n    const xRel = (e.clientX - rect.left) / rect.width;\n    const yRel = (e.clientY - rect.top) / rect.height;\n\n    const ry = Number(((xRel - 0.5) * 26).toFixed(2));\n    const rx = Number(((0.5 - yRel) * 22).toFixed(2));\n    const gx = Math.round(xRel * 100);\n    const gy = Math.round(yRel * 100);\n\n    setTilt({ rx, ry, gx, gy });\n  };\n\n  const handleStagePointerLeave = () => {\n    if (gyroStatus !== \'simulated\') {\n      setTilt({ rx: 0, ry: 0, gx: 50, gy: 50 });\n    }\n  };\n\n  // Stamp Modification Handlers (synced to localStorage for the local device pass)\n  const updateCustomerStamps = (customerId: string, delta: number) => {\n    setCustomers((prev) =>\n      prev.map((c) => {\n        if (c.id !== customerId) return c;\n        const nextStamps = Math.max(0, Math.min(10, c.currentStamps + delta));\n        persistLocalCustomerUpdate(c.id, nextStamps, c.totalRedeemedStamps);\n        return {\n          ...c,\n          currentStamps: nextStamps,\n          lastVisit: \'2026-10-30\',\n        };\n      })\n    );\n    if (delta > 0) {\n      triggerToast(t.toastIssuedStamp(delta, customerId));\n    }\n  };\n\n  const setExactStampCount = (\n    customerId: string,\n    count: number,\n    e: React.MouseEvent\n  ) => {\n    e.stopPropagation();\n    setCustomers((prev) =>\n      prev.map((c) => {\n        if (c.id !== customerId) return c;\n        const target = c.currentStamps === count ? count - 1 : count;\n        const clamped = Math.max(0, Math.min(10, target));\n        persistLocalCustomerUpdate(c.id, clamped, c.totalRedeemedStamps);\n        return {\n          ...c,\n          currentStamps: clamped,\n          lastVisit: \'2026-10-30\',\n        };\n      })\n    );\n  };\n\n  const redeemCustomerReward = (customerId: string) => {\n    const target = customers.find((c) => c.id === customerId);\n    if (!target || target.currentStamps < 10) {\n      triggerToast(t.toastNeed10Stamps);\n      return;\n    }\n    setCustomers((prev) =>\n      prev.map((c) => {\n        if (c.id !== customerId) return c;\n        const nextRedeemed = c.totalRedeemedStamps + 10;\n        persistLocalCustomerUpdate(c.id, 0, nextRedeemed);\n        return {\n          ...c,\n          currentStamps: 0,\n          totalRedeemedStamps: nextRedeemed,\n          lastVisit: \'2026-10-30\',\n        };\n      })\n    );\n    triggerToast(\n      t.toastRedeemed10(\n        target.isLocalDevice ? t.localDeviceMemberName : target.name\n      )\n    );\n  };\n\n  // Handle \'Add to Home Screen\' button click\n  const handleAddToHomeScreenClick = async () => {\n    if (deferredPrompt) {\n      try {\n        await deferredPrompt.prompt();\n        const { outcome } = await deferredPrompt.userChoice;\n        if (outcome === \'accepted\') {\n          setIsPwaInstalled(true);\n          setDeferredPrompt(null);\n          try {\n            window.localStorage.setItem(STORAGE_KEYS.PWA_SHORTCUT_PINNED, \'true\');\n          } catch {}\n          triggerToast(t.toastPwaInstalled(activeCustomer.id));\n          return;\n        }\n      } catch {\n        // Fall through to guided PWA shortcut modal\n      }\n    }\n    setActionModal({ type: \'pwa\' });\n  };\n\n  // Filtered B2B Customers\n  const filteredCustomers = useMemo(() => {\n    return customers.filter((c) => {\n      const displayName = c.isLocalDevice ? t.localDeviceMemberName : c.name;\n      const matchesQuery =\n        displayName.toLowerCase().includes(searchQuery.toLowerCase()) ||\n        c.name.toLowerCase().includes(searchQuery.toLowerCase()) ||\n        c.id.toLowerCase().includes(searchQuery.toLowerCase()) ||\n        c.email.toLowerCase().includes(searchQuery.toLowerCase());\n      if (!matchesQuery) return false;\n      if (tableFilter === \'ready\') return c.currentStamps === 10;\n      if (tableFilter === \'vip\') return c.totalRedeemedStamps >= 40;\n      return true;\n    });\n  }, [customers, searchQuery, tableFilter, t.localDeviceMemberName]);\n\n  // Aggregate B2B Metrics\n  const b2bStats = useMemo(() => {\n    const totalMembers = customers.length;\n    const activeStamps = customers.reduce((acc, c) => acc + c.currentStamps, 0);\n    const totalRedeemed = customers.reduce(\n      (acc, c) => acc + c.totalRedeemedStamps,\n      0\n    );\n    const readyCount = customers.filter((c) => c.currentStamps === 10).length;\n    return { totalMembers, activeStamps, totalRedeemed, readyCount };\n  }, [customers]);\n\n  const qrMatrix = useMemo(\n    () => generateQrMatrix(activeCustomer.id),\n    [activeCustomer.id]\n  );\n\n  const activeDisplayName = activeCustomer.isLocalDevice\n    ? t.localDeviceMemberName\n    : activeCustomer.name;\n\n  // Generate and download a standalone single-file HTML version with anonymous localStorage + Add to Home Screen\n  const handleDownloadSingleFileHtml = () => {\n    const singleFileSource = `<!DOCTYPE html>\n<html lang=\"${lang}\">\n<head>\n<meta charset=\"UTF-8\" />\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n<meta name=\"theme-color\" content=\"#0B0D11\" />\n<meta name=\"apple-mobile-web-app-capable\" content=\"yes\" />\n<title>Vespera Metal Loyalty Card \342\200\224 Single File PWA</title>\n<style>\n  :root { --rx: 0deg; --ry: 0deg; --gx: 50%; --gy: 50%; }\n  * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, \"Plus Jakarta Sans\", sans-serif; }\n  body { background: #0B0D11; color: #F1F5F9; min-height: 100vh; display: flex; flex-direction: column; overflow-x: hidden; }\n  header { display: flex; align-items: center; justify-content: space-between; padding: 16px 28px; border-bottom: 1px solid rgba(255,255,255,0.08); flex-wrap: wrap; gap: 12px; }\n  .brand { font-weight: 700; letter-spacing: -0.02em; font-size: 18px; }\n  .btn { background: #F59E0B; color: #0B0D11; border: none; padding: 8px 16px; border-radius: 8px; font-weight: 600; font-size: 13px; cursor: pointer; }\n  .btn-outline { background: rgba(255,255,255,0.06); color: #F1F5F9; border: 1px solid rgba(255,255,255,0.14); }\n  main { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 32px 20px 140px; gap: 28px; }\n  @keyframes floatCard { 0%, 100% { transform: translateY(0px); } 50% { transform: translateY(-12px); } }\n  .float-wrap { animation: floatCard 5.5s ease-in-out infinite; perspective: 1400px; }\n  .card-tilt { width: min(420px, 92vw); aspect-ratio: 1.586 / 1; transform-style: preserve-3d; transform: rotateX(var(--rx)) rotateY(var(--ry)); transition: transform 0.12s ease-out; cursor: pointer; }\n  .card-flipper { width: 100%; height: 100%; position: relative; transform-style: preserve-3d; transition: transform 0.78s cubic-bezier(0.22, 1, 0.36, 1); }\n  .card-flipper.flipped { transform: rotateY(180deg); }\n  .card-face {\n    position: absolute; inset: 0; border-radius: 20px; backface-visibility: hidden; -webkit-backface-visibility: hidden; overflow: hidden;\n    background: repeating-linear-gradient(90deg, rgba(255,255,255,0.018) 0px, rgba(255,255,255,0.018) 1px, transparent 1px, transparent 3px),\n      linear-gradient(135deg, #2d333f 0%, #161920 35%, #303744 52%, #12151c 82%, #242934 100%);\n    border: 1px solid rgba(255,255,255,0.22); box-shadow: 0 28px 60px -12px rgba(0,0,0,0.75), inset 0 1px 1px rgba(255,255,255,0.3);\n    padding: 24px; display: flex; flex-direction: column; justify-content: space-between;\n  }\n  .card-face::before {\n    content: \"\"; position: absolute; inset: -40%;\n    background: conic-gradient(from 140deg at var(--gx) var(--gy), transparent 0deg, rgba(255,190,110,0.22) 60deg, rgba(96,210,255,0.26) 120deg, rgba(210,130,255,0.22) 180deg, transparent 240deg);\n    mix-blend-mode: color-dodge; pointer-events: none;\n  }\n  .card-back { transform: rotateY(180deg); }\n  .stamps { display: grid; grid-template-columns: repeat(5, 1fr); gap: 10px; margin: 12px 0; z-index: 2; }\n  .stamp { aspect-ratio: 1; border-radius: 50%; border: 1px solid rgba(255,255,255,0.2); display: flex; align-items: center; justify-content: center; font-size: 11px; font-family: monospace; background: rgba(0,0,0,0.35); }\n  .stamp.active { background: radial-gradient(circle, #fbbf24 0%, #b45309 100%); color: #0B0D11; font-weight: 700; border-color: #fde68a; }\n  .drawer {\n    position: fixed; left: 0; right: 0; bottom: 0; background: rgba(18, 22, 31, 0.96); backdrop-filter: blur(16px);\n    border-top: 1px solid rgba(255,255,255,0.14); border-radius: 24px 24px 0 0; padding: 16px 24px 28px;\n    transform: translateY(105%); transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);\n    display: flex; flex-direction: column; align-items: center; gap: 14px; z-index: 50;\n  }\n  .drawer.open { transform: translateY(0); }\n  .drawer-btns { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; width: 100%; max-width: 480px; }\n  .drawer-btns button { flex: 1; min-width: 180px; padding: 12px 16px; border-radius: 12px; border: 1px solid rgba(255,255,255,0.15); background: #1E2430; color: #fff; font-weight: 600; cursor: pointer; }\n  .mono { font-family: monospace; font-variant-numeric: tabular-nums; }\n</style>\n</head>\n<body>\n  <header>\n    <div class=\"brand\">Vespera Atelier</div>\n    <button class=\"btn\" id=\"flipBtn\">${t.flipToBack}</button>\n  </header>\n  <main>\n    <div class=\"float-wrap\">\n      <div class=\"card-tilt\" id=\"cardTilt\">\n        <div class=\"card-flipper\" id=\"cardFlipper\">\n          <div class=\"card-face card-front\">\n            <div style=\"display:flex;justify-content:space-between;align-items:center;z-index:2;\">\n              <span class=\"mono\" style=\"font-size:11px;letter-spacing:0.16em;color:#94A3B8;\">${t.cardFrontTag}</span>\n              <span class=\"mono\" style=\"font-size:11px;color:#F59E0B;\">LOCAL PASS</span>\n            </div>\n            <div style=\"text-align:center;z-index:2;\">\n              <div style=\"width:46px;height:46px;border-radius:50%;border:2px solid #F59E0B;margin:0 auto 10px;display:flex;align-items:center;justify-content:center;font-weight:700;color:#F59E0B;\">V</div>\n              <div style=\"font-size:20px;font-weight:700;letter-spacing:0.18em;\">VESPERA</div>\n              <div style=\"font-size:11px;color:#94A3B8;margin-top:4px;\">${t.cardFrontSubtitle}</div>\n            </div>\n            <div style=\"display:flex;justify-content:space-between;font-size:11px;color:#94A3B8;z-index:2;\">\n              <span id=\"anonName\">${activeDisplayName}</span>\n              <span>${t.tapToFlip} \342\206\222</span>\n            </div>\n          </div>\n          <div class=\"card-face card-back\">\n            <div style=\"display:flex;justify-content:space-between;align-items:center;z-index:2;\">\n              <span style=\"font-weight:700;font-size:12px;letter-spacing:0.1em;\">${t.stampLedgerTitle}</span>\n              <span class=\"mono\" style=\"font-size:12px;color:#FDE68A;\" id=\"cidLabel\">ID: ${activeCustomer.id}</span>\n            </div>\n            <div class=\"stamps\" id=\"stampGrid\"></div>\n            <div style=\"display:flex;justify-content:space-between;align-items:flex-end;z-index:2;\">\n              <div style=\"font-size:13px;font-weight:600;color:#F8FAFC;\">${t.stampsCollectedOf10(activeCustomer.currentStamps)}</div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </main>\n  <div class=\"drawer\" id=\"actionDrawer\">\n    <div style=\"width:40px;height:5px;background:rgba(255,255,255,0.25);border-radius:99px;\"></div>\n    <div class=\"drawer-btns\">\n      <button id=\"pwaBtn\">Add to Home Screen</button>\n      <button id=\"emailBtn\" style=\"background:#F59E0B;color:#0B0D11;\">Email Backup</button>\n    </div>\n  </div>\n  <script>\n    let cid = localStorage.getItem(\'vespera_anon_customer_id\');\n    if (!cid) {\n      cid = \'VSP-\' + Math.floor(1000 + Math.random() * 9000) + \'-\' + Math.floor(100 + Math.random() * 900) + \'K\';\n      localStorage.setItem(\'vespera_anon_customer_id\', cid);\n    }\n    document.getElementById(\'cidLabel\').textContent = \'ID: \' + cid;\n    const flipper = document.getElementById(\'cardFlipper\');\n    const drawer = document.getElementById(\'actionDrawer\');\n    const stampGrid = document.getElementById(\'stampGrid\');\n    let flipped = false;\n    for (let i = 1; i <= 10; i++) {\n      const el = document.createElement(\'div\');\n      el.className = \'stamp\' + (i <= ${activeCustomer.currentStamps} ? \' active\' : \'\');\n      el.textContent = i <= ${activeCustomer.currentStamps} ? \'\342\230\205\' : String(i).padStart(2, \'0\');\n      stampGrid.appendChild(el);\n    }\n    function toggleFlip() {\n      flipped = !flipped;\n      flipper.classList.toggle(\'flipped\', flipped);\n      drawer.classList.toggle(\'open\', flipped);\n    }\n    document.getElementById(\'cardTilt\').addEventListener(\'click\', toggleFlip);\n    document.getElementById(\'flipBtn\').addEventListener(\'click\', toggleFlip);\n  </script>\n</body>\n</html>`;\n\n    const blob = new Blob([singleFileSource], { type: \'text/html\' });\n    const url = URL.createObjectURL(blob);\n    const a = document.createElement(\'a\');\n    a.href = url;\n    a.download = `vespera-loyalty-pwa-${lang}.html`;\n    document.body.appendChild(a);\n    a.click();\n    document.body.removeChild(a);\n    URL.revokeObjectURL(url);\n    triggerToast(t.toastExportHtml);\n  };\n\n  return (\n    <div className=\"min-h-screen bg-[#0B0D11] text-slate-100 flex flex-col relative overflow-x-hidden\">\n      {/* Embedded Keyframes & 3D Metal / Holographic Styles */}\n      <style>{`\n        @keyframes floatCardContinuous {\n          0%, 100% {\n            transform: translate3d(0, 0px, 0) rotateZ(0deg);\n          }\n          50% {\n            transform: translate3d(0, -14px, 0) rotateZ(0.35deg);\n          }\n        }\n        @keyframes holoShimmer {\n          0%, 100% {\n            background-position: 0% 50%;\n          }\n          50% {\n            background-position: 100% 50%;\n          }\n        }\n        .metal-card-floating {\n          animation: floatCardContinuous 5.6s cubic-bezier(0.45, 0.05, 0.55, 0.95) infinite;\n          will-change: transform;\n        }\n        .perspective-stage {\n          perspective: 1400px;\n        }\n        .card-3d-tilt {\n          transform-style: preserve-3d;\n          transition: transform 140ms cubic-bezier(0.16, 1, 0.3, 1);\n          will-change: transform;\n        }\n        .card-3d-flipper {\n          position: relative;\n          width: 100%;\n          height: 100%;\n          transform-style: preserve-3d;\n          transition: transform 760ms cubic-bezier(0.22, 1, 0.36, 1);\n          will-change: transform;\n        }\n        .card-3d-flipper.is-flipped {\n          transform: rotateY(180deg);\n        }\n        .card-face-metal {\n          position: absolute;\n          inset: 0;\n          border-radius: 22px;\n          backface-visibility: hidden;\n          -webkit-backface-visibility: hidden;\n          overflow: hidden;\n          background:\n            repeating-linear-gradient(\n              90deg,\n              rgba(255, 255, 255, 0.016) 0px,\n              rgba(255, 255, 255, 0.016) 1px,\n              transparent 1px,\n              transparent 3px\n            ),\n            repeating-linear-gradient(\n              0deg,\n              rgba(255, 255, 255, 0.01) 0px,\n              rgba(255, 255, 255, 0.01) 1px,\n              transparent 1px,\n              transparent 4px\n            ),\n            linear-gradient(\n              135deg,\n              #313846 0%,\n              #181c24 28%,\n              #2d3442 48%,\n              #12151c 74%,\n              #282f3d 100%\n            );\n          box-shadow:\n            0 30px 65px -15px rgba(0, 0, 0, 0.85),\n            0 0 0 1px rgba(255, 255, 255, 0.2),\n            inset 0 1px 1px rgba(255, 255, 255, 0.35),\n            inset 0 -1px 2px rgba(0, 0, 0, 0.65);\n        }\n        .card-face-back {\n          transform: rotateY(180deg);\n        }\n        .holographic-sheen {\n          background: linear-gradient(\n            125deg,\n            transparent 18%,\n            rgba(255, 196, 112, 0.16) 33%,\n            rgba(94, 234, 212, 0.20) 44%,\n            rgba(129, 140, 248, 0.20) 54%,\n            rgba(244, 114, 182, 0.16) 64%,\n            transparent 80%\n          );\n          background-size: 220% 220%;\n          animation: holoShimmer 7s ease-in-out infinite;\n          mix-blend-mode: color-dodge;\n        }\n        @media (prefers-reduced-motion: reduce) {\n          .metal-card-floating,\n          .holographic-sheen {\n            animation: none !important;\n          }\n        }\n      `}</style>\n\n      {/* Top Bar Contract: Zone 1 (Wordmark) \342\200\224 Zone 2 (4 Single-line Nav Links) \342\200\224 Zone 3 (1 Primary Action) */}\n      <header className=\"sticky top-0 z-30 flex items-center justify-between gap-8 px-6 lg:px-10 h-14 bg-[#0B0D11]/90 backdrop-blur-md border-b border-slate-800/80\">\n        <a\n          href=\"#top\"\n          className=\"text-base font-bold tracking-tight text-slate-100 whitespace-nowrap shrink-0\"\n        >\n          Vespera Atelier\n        </a>\n\n        <nav className=\"hidden md:flex items-center gap-7 text-sm font-medium text-slate-400\">\n          <button\n            type=\"button\"\n            onClick={() => {\n              setViewMode(\'split\');\n              setIsFlipped(false);\n            }}\n            className=\"hover:text-slate-100 transition-colors whitespace-nowrap shrink-0 cursor-pointer\"\n          >\n            {t.navFront}\n          </button>\n          <button\n            type=\"button\"\n            onClick={() => {\n              setViewMode(\'split\');\n              setIsFlipped(true);\n            }}\n            className=\"hover:text-slate-100 transition-colors whitespace-nowrap shrink-0 cursor-pointer\"\n          >\n            {t.navGrid}\n          </button>\n          <button\n            type=\"button\"\n            onClick={() => {\n              setIsFlipped(true);\n              handleAddToHomeScreenClick();\n            }}\n            className=\"hover:text-slate-100 transition-colors whitespace-nowrap shrink-0 cursor-pointer\"\n          >\n            {t.navPwa}\n          </button>\n          <button\n            type=\"button\"\n            onClick={() =>\n              setViewMode((prev) =>\n                prev === \'dashboard\' ? \'split\' : \'dashboard\'\n              )\n            }\n            className=\"hover:text-slate-100 transition-colors whitespace-nowrap shrink-0 cursor-pointer\"\n          >\n            {t.navB2B}\n          </button>\n        </nav>\n\n        <div className=\"flex items-center gap-3 shrink-0\">\n          <button\n            type=\"button\"\n            onClick={() => updateCustomerStamps(activeCustomer.id, 1)}\n            className=\"px-4 py-2 text-xs font-semibold text-slate-950 bg-amber-400 hover:bg-amber-300 rounded-lg transition-colors whitespace-nowrap shrink-0 cursor-pointer\"\n          >\n            {t.ctaIssueStamp}\n          </button>\n        </div>\n      </header>\n\n      {/* Workspace Control Bar (Below the Top Bar) */}\n      <div className=\"border-b border-slate-800/60 bg-[#0F1218]\">\n        <div className=\"max-w-7xl mx-auto px-6 lg:px-10 py-3 flex flex-wrap items-center justify-between gap-4\">\n          {/* Clean Unboxed Metadata showing Anonymous LocalStorage Status */}\n          <div className=\"flex flex-wrap items-center gap-2 text-xs text-slate-400\">\n            <span className=\"text-slate-200 font-medium\">\n              {activeDisplayName}\n            </span>\n            <span aria-hidden=\"true\">\302\267</span>\n            <span className=\"font-mono tabular-nums text-amber-300/95 font-semibold\">\n              {activeCustomer.id}\n            </span>\n            <span aria-hidden=\"true\">\302\267</span>\n            <span className=\"font-mono tabular-nums\">\n              {activeCustomer.currentStamps} / 10 {t.stampsActive}\n            </span>\n            {activeCustomer.isLocalDevice && (\n              <>\n                <span aria-hidden=\"true\">\302\267</span>\n                <span className=\"text-emerald-400/90\">\n                  {t.localSavedBadge}\n                </span>\n              </>\n            )}\n          </div>\n\n          {/* Interactive Language Selector, Workspace Mode Toggles & Single-File HTML Export */}\n          <div className=\"flex flex-wrap items-center gap-2.5\">\n            <div\n              role=\"group\"\n              aria-label=\"Pilihan Bahasa / Language Selector\"\n              className=\"flex items-center gap-1 p-1 bg-slate-900 border border-slate-800 rounded-lg\"\n            >\n              <Globe className=\"w-3.5 h-3.5 text-amber-400 ml-1.5 mr-0.5 shrink-0\" />\n              <button\n                type=\"button\"\n                onClick={() => {\n                  setLang(\'id\');\n                  triggerToast(TRANSLATIONS.id.toastLangChanged);\n                }}\n                className={`px-2.5 py-1 text-xs font-semibold rounded-md transition-colors whitespace-nowrap shrink-0 cursor-pointer ${\n                  lang === \'id\'\n                    ? \'bg-amber-400 text-slate-950 shadow-xs\'\n                    : \'text-slate-400 hover:text-slate-200\'\n                }`}\n              >\n                ID \302\267 Indonesia\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => {\n                  setLang(\'en\');\n                  triggerToast(TRANSLATIONS.en.toastLangChanged);\n                }}\n                className={`px-2.5 py-1 text-xs font-semibold rounded-md transition-colors whitespace-nowrap shrink-0 cursor-pointer ${\n                  lang === \'en\'\n                    ? \'bg-amber-400 text-slate-950 shadow-xs\'\n                    : \'text-slate-400 hover:text-slate-200\'\n                }`}\n              >\n                EN \302\267 English\n              </button>\n            </div>\n\n            <div\n              role=\"group\"\n              aria-label=\"Workspace View Mode\"\n              className=\"flex items-center gap-1 p-1 bg-slate-900 border border-slate-800 rounded-lg\"\n            >\n              <button\n                type=\"button\"\n                onClick={() => setViewMode(\'split\')}\n                className={`px-3 py-1 text-xs font-medium rounded-md transition-colors whitespace-nowrap shrink-0 cursor-pointer ${\n                  viewMode === \'split\'\n                    ? \'bg-slate-800 text-slate-100 shadow-xs\'\n                    : \'text-slate-400 hover:text-slate-200\'\n                }`}\n              >\n                {t.modeSplit}\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => setViewMode(\'pass\')}\n                className={`px-3 py-1 text-xs font-medium rounded-md transition-colors whitespace-nowrap shrink-0 cursor-pointer ${\n                  viewMode === \'pass\'\n                    ? \'bg-slate-800 text-slate-100 shadow-xs\'\n                    : \'text-slate-400 hover:text-slate-200\'\n                }`}\n              >\n                {t.modePass}\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => setViewMode(\'dashboard\')}\n                className={`px-3 py-1 text-xs font-medium rounded-md transition-colors whitespace-nowrap shrink-0 cursor-pointer ${\n                  viewMode === \'dashboard\'\n                    ? \'bg-slate-800 text-slate-100 shadow-xs\'\n                    : \'text-slate-400 hover:text-slate-200\'\n                }`}\n              >\n                {t.modeDashboard}\n              </button>\n            </div>\n\n            <button\n              type=\"button\"\n              onClick={handleDownloadSingleFileHtml}\n              className=\"hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-slate-300 hover:text-white bg-slate-900 hover:bg-slate-800 border border-slate-800 rounded-lg transition-colors whitespace-nowrap shrink-0 cursor-pointer\"\n              title={t.exportHtml}\n            >\n              <Download className=\"w-3.5 h-3.5 text-amber-400\" />\n              <span>{t.exportHtml}</span>\n            </button>\n          </div>\n        </div>\n      </div>\n\n      {/* Main Content Container */}\n      <main\n        id=\"top\"\n        className=\"flex-1 max-w-7xl w-full mx-auto px-6 lg:px-10 py-8 pb-44 space-y-12\"\n      >\n        {/* SECTION 1: 3D METAL LOYALTY CARD & INTERACTIVE TELEMETRY */}\n        {viewMode !== \'dashboard\' && (\n          <section className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch\">\n            {/* Left 7 Columns: 3D Floating Metal Card Stage */}\n            <div\n              ref={cardStageRef}\n              onPointerMove={handleStagePointerMove}\n              onPointerLeave={handleStagePointerLeave}\n              className=\"lg:col-span-7 relative rounded-2xl bg-[#11151E] border border-slate-800/80 p-6 sm:p-10 flex flex-col items-center justify-between min-h-[460px] select-none overflow-hidden\"\n            >\n              {/* Subtle Ambient Stage Illumination */}\n              <div\n                aria-hidden=\"true\"\n                className=\"pointer-events-none absolute -top-28 left-1/2 -translate-x-1/2 w-[480px] h-[260px] rounded-full opacity-25 blur-3xl\"\n                style={{\n                  background:\n                    \'radial-gradient(circle, rgba(251,191,36,0.35) 0%, rgba(56,189,248,0.18) 55%, transparent 80%)\',\n                }}\n              />\n\n              {/* Top Stage Bar */}\n              <div className=\"w-full flex items-center justify-between gap-4 z-10\">\n                <div className=\"text-xs text-slate-400 flex items-center gap-2\">\n                  <span className=\"font-medium text-slate-200\">\n                    {isFlipped ? t.stageBackLabel : t.stageFrontLabel}\n                  </span>\n                  <span aria-hidden=\"true\">\302\267</span>\n                  <span className=\"font-mono tabular-nums text-slate-400\">\n                    {t.tiltLabel} {tilt.rx.toFixed(1)}\302\260 / {tilt.ry.toFixed(1)}\302\260\n                  </span>\n                </div>\n\n                <button\n                  type=\"button\"\n                  onClick={() => setIsFlipped((prev) => !prev)}\n                  className=\"inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium bg-slate-800/90 hover:bg-slate-700 text-slate-100 border border-slate-700 transition-colors whitespace-nowrap shrink-0 cursor-pointer min-h-[36px]\"\n                >\n                  <RotateCw className=\"w-3.5 h-3.5 text-amber-400\" />\n                  <span>{isFlipped ? t.flipToFront : t.flipToBack}</span>\n                </button>\n              </div>\n\n              {/* Centerpiece: Continuous Floating Wrapper -> DeviceOrientation 3D Tilt -> 3D Flip Card */}\n              <div className=\"my-8 w-full flex items-center justify-center z-10 perspective-stage\">\n                <div className=\"metal-card-floating w-full max-w-[430px]\">\n                  <div\n                    role=\"button\"\n                    tabIndex={0}\n                    aria-label={t.cardAriaLabel}\n                    onClick={() => setIsFlipped((prev) => !prev)}\n                    onKeyDown={(e) => {\n                      if (e.key === \'Enter\' || e.key === \' \') {\n                        e.preventDefault();\n                        setIsFlipped((prev) => !prev);\n                      }\n                    }}\n                    className=\"card-3d-tilt w-full aspect-[1.586/1] cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-400 rounded-[22px]\"\n                    style={{\n                      transform: `rotateX(${tilt.rx}deg) rotateY(${tilt.ry}deg)`,\n                    }}\n                  >\n                    <div\n                      className={`card-3d-flipper ${isFlipped ? \'is-flipped\' : \'\'}`}\n                    >\n                      {/* ================= CARD FRONT FACE ================= */}\n                      <div className=\"card-face-metal p-6 sm:p-7 flex flex-col justify-between\">\n                        {/* Dynamic Holographic Foil Overlay */}\n                        <div\n                          aria-hidden=\"true\"\n                          className=\"holographic-sheen pointer-events-none absolute inset-0 opacity-75\"\n                        />\n\n                        {/* Dynamic Specular Glare following DeviceOrientation / Pointer */}\n                        <div\n                          aria-hidden=\"true\"\n                          className=\"pointer-events-none absolute inset-0 transition-opacity duration-200\"\n                          style={{\n                            background: `radial-gradient(circle at ${tilt.gx}% ${tilt.gy}%, rgba(255, 255, 255, 0.24) 0%, rgba(251, 191, 36, 0.08) 28%, transparent 62%)`,\n                          }}\n                        />\n\n                        {/* Front Top Row: Milled Serial & Tier */}\n                        <div className=\"relative z-10 flex items-center justify-between\">\n                          <div className=\"flex items-center gap-2\">\n                            <div className=\"w-7 h-5 rounded-sm bg-gradient-to-br from-amber-200 via-amber-400 to-amber-700 border border-amber-100/40 shadow-inner flex items-center justify-center\">\n                              <div className=\"w-4 h-3 border border-amber-950/40 rounded-[2px]\" />\n                            </div>\n                            <span className=\"font-mono tabular-nums text-[11px] tracking-widest text-slate-300/90\">\n                              {t.cardFrontTag}\n                            </span>\n                          </div>\n\n                          <span className=\"font-mono tabular-nums text-[11px] text-amber-300/90\">\n                            {activeCustomer.id}\n                          </span>\n                        </div>\n\n                        {/* Front Center: Minimalist Architectural Brand Logo */}\n                        <div className=\"relative z-10 my-auto flex flex-col items-center justify-center text-center py-2\">\n                          <div className=\"relative w-14 h-14 rounded-full border border-amber-300/50 bg-slate-950/50 flex items-center justify-center shadow-lg\">\n                            <div className=\"w-9 h-9 rounded-full border border-amber-400/80 flex items-center justify-center rotate-45\">\n                              <div className=\"w-3.5 h-3.5 bg-amber-400 rotate-45\" />\n                            </div>\n                          </div>\n                          <div className=\"mt-3 text-xl sm:text-2xl font-bold tracking-[0.26em] text-slate-100 pl-[0.26em]\">\n                            VESPERA\n                          </div>\n                          <div className=\"mt-0.5 text-[11px] tracking-[0.18em] text-slate-400\">\n                            {t.cardFrontSubtitle}\n                          </div>\n                        </div>\n\n                        {/* Front Bottom Row: Cardholder Name & Tap Prompt */}\n                        <div className=\"relative z-10 flex items-end justify-between text-xs\">\n                          <div>\n                            <div className=\"text-[10px] text-slate-400\">\n                              {t.cardholderLabel}\n                            </div>\n                            <div className=\"font-semibold text-slate-100 tracking-wide\">\n                              {activeDisplayName}\n                            </div>\n                          </div>\n                          <div className=\"text-[11px] text-amber-300/90 font-medium flex items-center gap-1\">\n                            <span>{t.tapToFlip}</span>\n                            <RotateCw className=\"w-3 h-3\" />\n                          </div>\n                        </div>\n                      </div>\n\n                      {/* ================= CARD BACK FACE ================= */}\n                      <div className=\"card-face-metal card-face-back p-5 sm:p-6 flex flex-col justify-between\">\n                        {/* Holographic & Specular Layers on Back */}\n                        <div\n                          aria-hidden=\"true\"\n                          className=\"holographic-sheen pointer-events-none absolute inset-0 opacity-65\"\n                        />\n                        <div\n                          aria-hidden=\"true\"\n                          className=\"pointer-events-none absolute inset-0\"\n                          style={{\n                            background: `radial-gradient(circle at ${100 - tilt.gx}% ${tilt.gy}%, rgba(255, 255, 255, 0.2) 0%, transparent 60%)`,\n                          }}\n                        />\n\n                        {/* Back Top Row: Brand Monogram Left + Customer ID / Card Code Top Right */}\n                        <div className=\"relative z-10 flex items-center justify-between gap-2 border-b border-white/10 pb-2.5\">\n                          <div className=\"flex items-center gap-2\">\n                            <div className=\"w-5 h-5 rounded-full border border-amber-400/70 flex items-center justify-center text-[10px] font-bold text-amber-300\">\n                              V\n                            </div>\n                            <span className=\"text-xs font-semibold tracking-wider text-slate-200\">\n                              {t.stampLedgerTitle}\n                            </span>\n                          </div>\n\n                          {/* Customer ID / Card Code strictly on Top Right */}\n                          <div className=\"text-right\">\n                            <span className=\"text-[10px] text-slate-400 mr-1.5\">\n                              ID\n                            </span>\n                            <span className=\"font-mono tabular-nums text-xs font-semibold text-amber-300 tracking-wider\">\n                              {activeCustomer.id}\n                            </span>\n                          </div>\n                        </div>\n\n                        {/* Back Middle: 10-Stamp Grid (5 columns x 2 rows) */}\n                        <div className=\"relative z-10 my-auto py-2\">\n                          <div className=\"grid grid-cols-5 gap-2 sm:gap-2.5\">\n                            {Array.from({ length: 10 }, (_, idx) => {\n                              const stampNumber = idx + 1;\n                              const isStamped =\n                                stampNumber <= activeCustomer.currentStamps;\n                              return (\n                                <button\n                                  key={stampNumber}\n                                  type=\"button\"\n                                  onClick={(e) =>\n                                    setExactStampCount(\n                                      activeCustomer.id,\n                                      stampNumber,\n                                      e\n                                    )\n                                  }\n                                  title={`${t.toggleStampTitle}${stampNumber}`}\n                                  className={`aspect-square rounded-full flex items-center justify-center transition-all duration-200 cursor-pointer ${\n                                    isStamped\n                                      ? \'bg-gradient-to-br from-amber-300 via-amber-400 to-amber-600 text-slate-950 border border-amber-100 shadow-[0_0_15px_rgba(251,191,36,0.45)] scale-100\'\n                                      : \'bg-slate-950/55 text-slate-400 border border-white/15 hover:border-amber-400/50\'\n                                  }`}\n                                >\n                                  {isStamped ? (\n                                    <Sparkles className=\"w-4 h-4 stroke-[2.2]\" />\n                                  ) : (\n                                    <span className=\"font-mono tabular-nums text-[11px]\">\n                                      {String(stampNumber).padStart(2, \'0\')}\n                                    </span>\n                                  )}\n                                </button>\n                              );\n                            })}\n                          </div>\n                        </div>\n\n                        {/* Back Bottom Row: Stamp Status Left + Unique Mock QR Code Right */}\n                        <div className=\"relative z-10 flex items-end justify-between gap-3 pt-1\">\n                          <div className=\"space-y-0.5\">\n                            <div className=\"text-[11px] text-slate-300 font-medium\">\n                              {activeCustomer.currentStamps === 10\n                                ? t.completeRewardReady\n                                : t.stampsCollectedOf10(\n                                    activeCustomer.currentStamps\n                                  )}\n                            </div>\n                            <div className=\"text-[11px] text-slate-400\">\n                              {activeCustomer.currentStamps === 10\n                                ? t.presentQrToRedeem\n                                : t.moreForReward(\n                                    10 - activeCustomer.currentStamps\n                                  )}\n                            </div>\n                          </div>\n\n                          {/* Mock Unique QR Code rendered via crisp SVG */}\n                          <div\n                            className=\"bg-white p-1.5 rounded-lg shadow-md shrink-0 border border-slate-200\"\n                            title={`QR ${activeCustomer.id}`}\n                          >\n                            <svg\n                              viewBox=\"0 0 13 13\"\n                              className=\"w-11 h-11 sm:w-12 sm:h-12 block\"\n                              shapeRendering=\"crispEdges\"\n                              aria-label={`QR Code for ${activeCustomer.id}`}\n                            >\n                              {qrMatrix.map((row, rIdx) =>\n                                row.map((cell, cIdx) =>\n                                  cell ? (\n                                    <rect\n                                      key={`${rIdx}-${cIdx}`}\n                                      x={cIdx}\n                                      y={rIdx}\n                                      width={1}\n                                      height={1}\n                                      fill=\"#0B0D11\"\n                                    />\n                                  ) : null\n                                )\n                              )}\n                            </svg>\n                          </div>\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n              </div>\n\n              {/* Bottom Stage Helper Bar */}\n              <div className=\"w-full flex flex-wrap items-center justify-between gap-3 pt-3 border-t border-slate-800/80 text-xs text-slate-400 z-10\">\n                <span>{t.stageFooterHint}</span>\n                <span className=\"font-mono tabular-nums text-amber-300\">\n                  {isFlipped ? t.drawerActiveBelow : t.flipForWalletActions}\n                </span>\n              </div>\n            </div>\n\n            {/* Right 5 Columns: Interactive Pass Controls & DeviceOrientation Gyro Simulator */}\n            <div className=\"lg:col-span-5 rounded-2xl bg-[#11151E] border border-slate-800/80 p-6 flex flex-col justify-between space-y-6\">\n              <div className=\"space-y-5\">\n                <div className=\"flex items-center justify-between border-b border-slate-800 pb-4\">\n                  <div>\n                    <h1 className=\"text-lg font-bold text-slate-100\">\n                      {t.studioTitle}\n                    </h1>\n                    <p className=\"text-xs text-slate-400 mt-0.5\">\n                      {t.studioSubtitle}\n                    </p>\n                  </div>\n                  <button\n                    type=\"button\"\n                    onClick={requestGyroPermission}\n                    className=\"inline-flex items-center gap-1.5 px-3 py-2 rounded-lg text-xs font-medium bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 transition-colors cursor-pointer whitespace-nowrap shrink-0\"\n                  >\n                    <Smartphone className=\"w-3.5 h-3.5 text-amber-400\" />\n                    <span>\n                      {gyroStatus === \'active\'\n                        ? t.gyroLinked\n                        : t.pairMotionSensor}\n                    </span>\n                  </button>\n                </div>\n\n                {/* Anonymous LocalStorage Pass Indicator + Profile Switcher */}\n                <div className=\"space-y-2\">\n                  <div className=\"flex items-center justify-between text-xs\">\n                    <label\n                      htmlFor=\"member-select\"\n                      className=\"font-medium text-slate-300\"\n                    >\n                      {t.activeCardholderProfile}\n                    </label>\n                    <span className=\"font-mono tabular-nums text-[11px] text-emerald-400 flex items-center gap-1\">\n                      <HardDrive className=\"w-3 h-3\" />\n                      <span>localStorage: {localCustomerId}</span>\n                    </span>\n                  </div>\n                  <div className=\"relative\">\n                    <select\n                      id=\"member-select\"\n                      value={selectedCustomerId}\n                      onChange={(e) => setSelectedCustomerId(e.target.value)}\n                      className=\"w-full h-11 pl-3.5 pr-9 rounded-xl bg-slate-900 border border-slate-800 text-sm text-slate-100 focus:outline-none focus:border-amber-400 appearance-none cursor-pointer\"\n                    >\n                      {customers.map((c) => (\n                        <option key={c.id} value={c.id}>\n                          {c.isLocalDevice ? t.localDeviceMemberName : c.name} \342\200\224{\' \'}\n                          {c.id} ({c.currentStamps}/10 {t.stampsWord})\n                        </option>\n                      ))}\n                    </select>\n                    <ChevronDown className=\"w-4 h-4 text-slate-400 pointer-events-none absolute right-3.5 top-1/2 -translate-y-1/2\" />\n                  </div>\n                </div>\n\n                {/* Stamp Issuance & Redemption Controls */}\n                <div className=\"space-y-2.5 pt-1\">\n                  <div className=\"flex items-center justify-between text-xs\">\n                    <span className=\"text-slate-300 font-medium\">\n                      {t.stampProgress} ({activeCustomer.currentStamps} / 10)\n                    </span>\n                    <span className=\"font-mono tabular-nums text-slate-400\">\n                      {t.lifetimeRedeemed}: {activeCustomer.totalRedeemedStamps}\n                    </span>\n                  </div>\n\n                  {/* Clean Segmented Progress Bar */}\n                  <div className=\"grid grid-cols-10 gap-1.5 h-2.5\">\n                    {Array.from({ length: 10 }, (_, idx) => (\n                      <div\n                        key={idx}\n                        className={`rounded-sm transition-colors ${\n                          idx < activeCustomer.currentStamps\n                            ? \'bg-amber-400\'\n                            : \'bg-slate-800\'\n                        }`}\n                      />\n                    ))}\n                  </div>\n\n                  <div className=\"grid grid-cols-3 gap-2.5 pt-2\">\n                    <button\n                      type=\"button\"\n                      onClick={() => updateCustomerStamps(activeCustomer.id, -1)}\n                      disabled={activeCustomer.currentStamps <= 0}\n                      className=\"h-11 rounded-xl bg-slate-900 hover:bg-slate-800 disabled:opacity-40 border border-slate-800 text-xs font-medium text-slate-200 flex items-center justify-center gap-1.5 transition-colors cursor-pointer\"\n                    >\n                      <Minus className=\"w-3.5 h-3.5\" />\n                      <span>{t.btnRemove}</span>\n                    </button>\n\n                    <button\n                      type=\"button\"\n                      onClick={() => {\n                        updateCustomerStamps(activeCustomer.id, 1);\n                        if (!isFlipped) setIsFlipped(true);\n                      }}\n                      disabled={activeCustomer.currentStamps >= 10}\n                      className=\"h-11 rounded-xl bg-slate-800 hover:bg-slate-700 disabled:opacity-40 border border-slate-700 text-xs font-semibold text-amber-300 flex items-center justify-center gap-1.5 transition-colors cursor-pointer\"\n                    >\n                      <Plus className=\"w-3.5 h-3.5\" />\n                      <span>{t.btnStampPlus}</span>\n                    </button>\n\n                    <button\n                      type=\"button\"\n                      onClick={() => redeemCustomerReward(activeCustomer.id)}\n                      className={`h-11 rounded-xl text-xs font-semibold flex items-center justify-center gap-1.5 transition-colors cursor-pointer ${\n                        activeCustomer.currentStamps === 10\n                          ? \'bg-amber-400 hover:bg-amber-300 text-slate-950 shadow-md shadow-amber-500/10\'\n                          : \'bg-slate-900 text-slate-500 border border-slate-800\'\n                      }`}\n                    >\n                      <Award className=\"w-3.5 h-3.5\" />\n                      <span>{t.btnRedeem10}</span>\n                    </button>\n                  </div>\n                </div>\n\n                {/* DeviceOrientation Tilt Calibration Sliders */}\n                <div className=\"space-y-3 pt-4 border-t border-slate-800\">\n                  <div className=\"flex items-center justify-between\">\n                    <span className=\"text-xs font-medium text-slate-300 flex items-center gap-1.5\">\n                      <Sliders className=\"w-3.5 h-3.5 text-amber-400\" />\n                      <span>{t.gyroSimulatorTitle}</span>\n                    </span>\n                    <button\n                      type=\"button\"\n                      onClick={() => {\n                        setGyroStatus(\'idle\');\n                        setTilt({ rx: 0, ry: 0, gx: 50, gy: 50 });\n                      }}\n                      className=\"text-xs text-slate-400 hover:text-slate-200 cursor-pointer\"\n                    >\n                      {t.resetAxis}\n                    </button>\n                  </div>\n\n                  <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n                    <div className=\"space-y-1\">\n                      <div className=\"flex justify-between text-[11px] text-slate-400\">\n                        <span>{t.pitchLabel}</span>\n                        <span className=\"font-mono tabular-nums\">{tilt.rx}\302\260</span>\n                      </div>\n                      <input\n                        type=\"range\"\n                        min={-24}\n                        max={24}\n                        step={1}\n                        value={tilt.rx}\n                        onChange={(e) => {\n                          const rx = Number(e.target.value);\n                          setGyroStatus(\'simulated\');\n                          setTilt((prev) => ({\n                            ...prev,\n                            rx,\n                            gy: Math.round(50 - (rx / 24) * 40),\n                          }));\n                        }}\n                        className=\"w-full accent-amber-400 cursor-pointer\"\n                      />\n                    </div>\n\n                    <div className=\"space-y-1\">\n                      <div className=\"flex justify-between text-[11px] text-slate-400\">\n                        <span>{t.rollLabel}</span>\n                        <span className=\"font-mono tabular-nums\">{tilt.ry}\302\260</span>\n                      </div>\n                      <input\n                        type=\"range\"\n                        min={-24}\n                        max={24}\n                        step={1}\n                        value={tilt.ry}\n                        onChange={(e) => {\n                          const ry = Number(e.target.value);\n                          setGyroStatus(\'simulated\');\n                          setTilt((prev) => ({\n                            ...prev,\n                            ry,\n                            gx: Math.round(50 + (ry / 24) * 40),\n                          }));\n                        }}\n                        className=\"w-full accent-amber-400 cursor-pointer\"\n                      />\n                    </div>\n                  </div>\n                </div>\n              </div>\n\n              {/* Flip Action CTA */}\n              <div className=\"pt-4 border-t border-slate-800 flex items-center justify-between gap-3\">\n                <div className=\"text-xs text-slate-400\">\n                  {isFlipped ? t.drawerHintOpen : t.drawerHintClosed}\n                </div>\n                <button\n                  type=\"button\"\n                  onClick={() => setIsFlipped((prev) => !prev)}\n                  className=\"px-4 py-2.5 rounded-xl bg-slate-100 hover:bg-white text-slate-950 text-xs font-semibold transition-colors whitespace-nowrap shrink-0 cursor-pointer\"\n                >\n                  {isFlipped ? t.showFrontFace : t.flipAndOpenDrawer}\n                </button>\n              </div>\n            </div>\n          </section>\n        )}\n\n        {/* SECTION 2: TOGGLEABLE B2B MERCHANT DASHBOARD */}\n        {viewMode !== \'pass\' && (\n          <section\n            aria-label={t.b2bTitle}\n            className=\"rounded-2xl bg-[#11151E] border border-slate-800/80 p-6 sm:p-8 space-y-6\"\n          >\n            {/* Dashboard Header */}\n            <div className=\"flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-800 pb-6\">\n              <div>\n                <h2 className=\"text-xl font-bold text-slate-100\">{t.b2bTitle}</h2>\n                <p className=\"text-sm text-slate-400 mt-1\">{t.b2bSubtitle}</p>\n              </div>\n            </div>\n\n            {/* Clean Unboxed KPI Strip */}\n            <div className=\"grid grid-cols-2 lg:grid-cols-4 gap-6 py-2 border-b border-slate-800/80 pb-6\">\n              <div>\n                <div className=\"text-xs text-slate-400\">{t.kpiRegistered}</div>\n                <div className=\"text-2xl font-bold font-mono tabular-nums text-slate-100 mt-1\">\n                  {b2bStats.totalMembers}\n                </div>\n              </div>\n              <div>\n                <div className=\"text-xs text-slate-400\">{t.kpiTotalRedeemed}</div>\n                <div className=\"text-2xl font-bold font-mono tabular-nums text-amber-400 mt-1\">\n                  {b2bStats.totalRedeemed}\n                </div>\n              </div>\n              <div>\n                <div className=\"text-xs text-slate-400\">\n                  {t.kpiActiveUnredeemed}\n                </div>\n                <div className=\"text-2xl font-bold font-mono tabular-nums text-slate-100 mt-1\">\n                  {b2bStats.activeStamps}\n                </div>\n              </div>\n              <div>\n                <div className=\"text-xs text-slate-400\">{t.kpiRewardsReady}</div>\n                <div className=\"text-2xl font-bold font-mono tabular-nums text-emerald-400 mt-1\">\n                  {b2bStats.readyCount}\n                </div>\n              </div>\n            </div>\n\n            {/* Search & Filter Controls */}\n            <div className=\"flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4\">\n              <div className=\"relative flex-1 max-w-md\">\n                <Search className=\"w-4 h-4 text-slate-500 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none\" />\n                <input\n                  type=\"search\"\n                  value={searchQuery}\n                  onChange={(e) => setSearchQuery(e.target.value)}\n                  placeholder={t.searchPlaceholder}\n                  className=\"w-full h-10 pl-10 pr-4 rounded-xl bg-slate-900 border border-slate-800 text-sm text-slate-100 placeholder:text-slate-500 focus:outline-none focus:border-amber-400\"\n                />\n              </div>\n\n              <div className=\"flex items-center gap-1 p-1 bg-slate-900 border border-slate-800 rounded-lg self-start\">\n                <button\n                  type=\"button\"\n                  onClick={() => setTableFilter(\'all\')}\n                  className={`px-3 py-1.5 text-xs font-medium rounded-md transition-colors whitespace-nowrap shrink-0 cursor-pointer ${\n                    tableFilter === \'all\'\n                      ? \'bg-slate-800 text-slate-100\'\n                      : \'text-slate-400 hover:text-slate-200\'\n                  }`}\n                >\n                  {t.filterAll}\n                </button>\n                <button\n                  type=\"button\"\n                  onClick={() => setTableFilter(\'ready\')}\n                  className={`px-3 py-1.5 text-xs font-medium rounded-md transition-colors whitespace-nowrap shrink-0 cursor-pointer ${\n                    tableFilter === \'ready\'\n                      ? \'bg-slate-800 text-slate-100\'\n                      : \'text-slate-400 hover:text-slate-200\'\n                  }`}\n                >\n                  {t.filterReady}\n                </button>\n                <button\n                  type=\"button\"\n                  onClick={() => setTableFilter(\'vip\')}\n                  className={`px-3 py-1.5 text-xs font-medium rounded-md transition-colors whitespace-nowrap shrink-0 cursor-pointer ${\n                    tableFilter === \'vip\'\n                      ? \'bg-slate-800 text-slate-100\'\n                      : \'text-slate-400 hover:text-slate-200\'\n                  }`}\n                >\n                  {t.filterVip}\n                </button>\n              </div>\n            </div>\n\n            {/* B2B Customer Data Table */}\n            <div className=\"overflow-x-auto border border-slate-800 rounded-xl\">\n              <table className=\"w-full text-left border-collapse\">\n                <thead>\n                  <tr className=\"border-b border-slate-800 bg-slate-900/70 text-[12px] font-semibold text-slate-400\">\n                    <th className=\"py-3.5 px-4\">{t.thCustomerName}</th>\n                    <th className=\"py-3.5 px-4\">{t.thCustomerId}</th>\n                    <th className=\"py-3.5 px-4\">{t.thActiveGrid}</th>\n                    <th className=\"py-3.5 px-4 text-right\">\n                      {t.thTotalRedeemed}\n                    </th>\n                    <th className=\"py-3.5 px-4 text-right\">\n                      {t.thMerchantActions}\n                    </th>\n                  </tr>\n                </thead>\n                <tbody className=\"divide-y divide-slate-800/70 text-sm\">\n                  {filteredCustomers.length === 0 ? (\n                    <tr>\n                      <td\n                        colSpan={5}\n                        className=\"py-10 text-center text-slate-400 text-sm\"\n                      >\n                        {t.noRecordsMatch} &ldquo;{searchQuery}&rdquo;.\n                      </td>\n                    </tr>\n                  ) : (\n                    filteredCustomers.map((customer) => {\n                      const isSelected = customer.id === activeCustomer.id;\n                      const displayName = customer.isLocalDevice\n                        ? t.localDeviceMemberName\n                        : customer.name;\n                      return (\n                        <tr\n                          key={customer.id}\n                          onClick={() => setSelectedCustomerId(customer.id)}\n                          className={`transition-colors cursor-pointer ${\n                            isSelected\n                              ? \'bg-amber-400/[0.06] hover:bg-amber-400/[0.09]\'\n                              : \'hover:bg-slate-900/60\'\n                          }`}\n                        >\n                          <td className=\"py-3.5 px-4\">\n                            <div className=\"font-semibold text-slate-100 flex items-center gap-2\">\n                              <span>{displayName}</span>\n                              {isSelected && (\n                                <span className=\"text-[11px] font-normal text-amber-300\">\n                                  {t.activeOn3dCard}\n                                </span>\n                              )}\n                            </div>\n                            <div className=\"text-xs text-slate-400\">\n                              {customer.isLocalDevice\n                                ? `${t.localDeviceTag} \302\267 ${customer.email}`\n                                : `${customer.email} \302\267 ${customer.tier}`}\n                            </div>\n                          </td>\n\n                          <td className=\"py-3.5 px-4 font-mono tabular-nums text-xs text-slate-200\">\n                            {customer.id}\n                          </td>\n\n                          <td className=\"py-3.5 px-4\">\n                            <div className=\"flex items-center gap-2.5\">\n                              <span className=\"font-mono tabular-nums text-xs text-slate-300 w-12\">\n                                {customer.currentStamps} / 10\n                              </span>\n                              <div className=\"w-24 h-2 rounded-full bg-slate-800 overflow-hidden\">\n                                <div\n                                  className={`h-full transition-all ${\n                                    customer.currentStamps === 10\n                                      ? \'bg-emerald-400\'\n                                      : \'bg-amber-400\'\n                                  }`}\n                                  style={{\n                                    width: `${customer.currentStamps * 10}%`,\n                                  }}\n                                />\n                              </div>\n                            </div>\n                          </td>\n\n                          <td className=\"py-3.5 px-4 text-right font-mono tabular-nums font-semibold text-slate-100\">\n                            {customer.totalRedeemedStamps}\n                          </td>\n\n                          <td\n                            className=\"py-3.5 px-4 text-right\"\n                            onClick={(e) => e.stopPropagation()}\n                          >\n                            <div className=\"inline-flex items-center justify-end gap-2\">\n                              <button\n                                type=\"button\"\n                                onClick={() =>\n                                  updateCustomerStamps(customer.id, 1)\n                                }\n                                disabled={customer.currentStamps >= 10}\n                                className=\"px-2.5 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 disabled:opacity-40 text-xs font-medium text-slate-200 transition-colors cursor-pointer whitespace-nowrap\"\n                              >\n                                {t.btnStampPlus}\n                              </button>\n                              <button\n                                type=\"button\"\n                                onClick={() =>\n                                  redeemCustomerReward(customer.id)\n                                }\n                                disabled={customer.currentStamps < 10}\n                                className={`px-2.5 py-1.5 rounded-lg text-xs font-semibold transition-colors cursor-pointer whitespace-nowrap ${\n                                  customer.currentStamps === 10\n                                    ? \'bg-amber-400 hover:bg-amber-300 text-slate-950\'\n                                    : \'bg-slate-900 text-slate-500 border border-slate-800 opacity-50\'\n                                }`}\n                              >\n                                {t.btnRedeem10}\n                              </button>\n                            </div>\n                          </td>\n                        </tr>\n                      );\n                    })\n                  )}\n                </tbody>\n              </table>\n            </div>\n          </section>\n        )}\n      </main>\n\n      {/* =====================================================================\n          SLIDE-UP ACTION MENU DRAWER\n          Strictly triggered when the card flips to the back (isFlipped === true)\n          Contains \'Add to Home Screen\' (PWA shortcut) and \'Email Backup\'\n          (Apple Wallet & Google Wallet buttons removed as requested)\n      ===================================================================== */}\n      <aside\n        aria-label=\"PWA Home Screen and Backup Slide-Up Action Menu\"\n        aria-hidden={!isFlipped}\n        className={`fixed left-0 right-0 bottom-0 z-40 transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] ${\n          isFlipped\n            ? \'translate-y-0 pointer-events-auto\'\n            : \'translate-y-full pointer-events-none\'\n        }`}\n      >\n        <div className=\"max-w-2xl mx-auto px-4\">\n          <div className=\"rounded-t-3xl bg-[#141923]/95 backdrop-blur-xl border-t border-x border-slate-700/80 shadow-[0_-20px_50px_rgba(0,0,0,0.75)] px-6 pt-3 pb-6\">\n            {/* Drag Handle Affordance */}\n            <div className=\"w-10 h-1.5 bg-slate-600 rounded-full mx-auto mb-3\" />\n\n            <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-4\">\n              <div className=\"flex items-center gap-2 text-xs text-slate-300\">\n                <span className=\"font-semibold text-white\">\n                  {t.drawerHeader}\n                </span>\n                <span aria-hidden=\"true\">\302\267</span>\n                <span className=\"font-mono tabular-nums text-amber-300\">\n                  {activeCustomer.id}\n                </span>\n                <span aria-hidden=\"true\">\302\267</span>\n                <span className=\"text-slate-400\">\n                  {activeCustomer.currentStamps}/10 {t.stampsWord}\n                </span>\n              </div>\n\n              <button\n                type=\"button\"\n                onClick={() => setIsFlipped(false)}\n                className=\"text-xs text-slate-400 hover:text-slate-200 self-end sm:self-auto cursor-pointer\"\n              >\n                {t.flipFrontToDismiss}\n              </button>\n            </div>\n\n            {/* 2 Action Buttons: \'Add to Home Screen\' (PWA) & \'Email Backup\' */}\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n              <button\n                type=\"button\"\n                onClick={handleAddToHomeScreenClick}\n                className=\"min-h-[50px] px-4 py-3 rounded-xl bg-slate-950 hover:bg-slate-900 text-white border border-slate-700/90 flex items-center justify-center gap-2.5 text-xs font-semibold transition-all active:scale-[0.99] cursor-pointer whitespace-nowrap\"\n              >\n                <Home className=\"w-4 h-4 text-amber-400 shrink-0\" />\n                <span>{t.btnAddToHomeScreen}</span>\n                {isPwaInstalled && (\n                  <Check className=\"w-3.5 h-3.5 text-emerald-400 ml-1 shrink-0\" />\n                )}\n              </button>\n\n              <button\n                type=\"button\"\n                onClick={() =>\n                  setActionModal({\n                    type: \'email\',\n                    emailInput: activeCustomer.email,\n                  })\n                }\n                className=\"min-h-[50px] px-4 py-3 rounded-xl bg-amber-400 hover:bg-amber-300 text-slate-950 flex items-center justify-center gap-2.5 text-xs font-semibold transition-all active:scale-[0.99] cursor-pointer whitespace-nowrap\"\n              >\n                <Mail className=\"w-4 h-4 shrink-0\" />\n                <span>{t.btnEmailBackup}</span>\n              </button>\n            </div>\n          </div>\n        </div>\n      </aside>\n\n      {/* =====================================================================\n          INTERACTIVE MODAL FOR \'ADD TO HOME SCREEN\' (PWA) OR \'EMAIL BACKUP\'\n      ===================================================================== */}\n      {actionModal.type && (\n        <div\n          role=\"dialog\"\n          aria-modal=\"true\"\n          className=\"fixed inset-0 z-50 bg-black/70 backdrop-blur-xs flex items-center justify-center p-4\"\n          onClick={() => setActionModal({ type: null })}\n        >\n          <div\n            className=\"w-full max-w-md rounded-2xl bg-[#141923] border border-slate-700 p-6 space-y-5 shadow-2xl\"\n            onClick={(e) => e.stopPropagation()}\n          >\n            <div className=\"flex items-center justify-between border-b border-slate-800 pb-3\">\n              <h3 className=\"text-base font-bold text-slate-100\">\n                {actionModal.type === \'pwa\'\n                  ? t.modalPwaTitle\n                  : t.modalEmailTitle}\n              </h3>\n              <button\n                type=\"button\"\n                onClick={() => setActionModal({ type: null })}\n                className=\"p-1 text-slate-400 hover:text-white rounded-lg cursor-pointer\"\n              >\n                <X className=\"w-4 h-4\" />\n              </button>\n            </div>\n\n            {actionModal.type === \'pwa\' ? (\n              <div className=\"space-y-4\">\n                {/* Home Screen Icon & LocalStorage Pass Summary */}\n                <div className=\"p-4 rounded-xl bg-slate-900 border border-slate-800 space-y-2.5 text-xs\">\n                  <div className=\"flex items-center gap-3 pb-2 border-b border-slate-800\">\n                    <div className=\"w-11 h-11 rounded-xl bg-slate-950 border border-amber-400/50 flex items-center justify-center font-bold text-amber-400 text-base shrink-0\">\n                      V\n                    </div>\n                    <div>\n                      <div className=\"font-semibold text-slate-100 text-sm\">\n                        Vespera Metal Loyalty Pass\n                      </div>\n                      <div className=\"text-slate-400 text-[11px]\">\n                        PWA Standalone Shortcut \302\267 /manifest.webmanifest\n                      </div>\n                    </div>\n                  </div>\n                  <div className=\"flex justify-between\">\n                    <span className=\"text-slate-400\">{t.modalLocalIdLabel}</span>\n                    <span className=\"font-mono tabular-nums text-amber-300 font-semibold\">\n                      {activeCustomer.id}\n                    </span>\n                  </div>\n                  <div className=\"flex justify-between\">\n                    <span className=\"text-slate-400\">{t.modalStorageState}</span>\n                    <span className=\"text-emerald-400 font-medium\">\n                      {t.modalStoragePermanent}\n                    </span>\n                  </div>\n                  <div className=\"flex justify-between\">\n                    <span className=\"text-slate-400\">{t.modalSyncedBalance}</span>\n                    <span className=\"font-mono tabular-nums text-slate-200\">\n                      {activeCustomer.currentStamps} / 10 {t.stampsWord}\n                    </span>\n                  </div>\n                </div>\n\n                {/* Guided Install Steps for iOS Safari & Android/Desktop */}\n                <div className=\"p-3.5 rounded-xl bg-slate-950/80 border border-slate-800/90 space-y-2 text-xs text-slate-300 leading-relaxed\">\n                  <div className=\"font-semibold text-slate-100 flex items-center gap-1.5\">\n                    <Share className=\"w-3.5 h-3.5 text-amber-400\" />\n                    <span>{t.pwaInstructionsTitle}</span>\n                  </div>\n                  {isIOS ? (\n                    <div className=\"space-y-1 text-slate-300\">\n                      <p>{t.pwaIosStep1}</p>\n                      <p>{t.pwaIosStep2}</p>\n                    </div>\n                  ) : (\n                    <div className=\"space-y-1.5 text-slate-300\">\n                      <p>{t.pwaAndroidStep}</p>\n                      <p className=\"text-slate-400\">{t.pwaIosStep1}</p>\n                      <p className=\"text-slate-400\">{t.pwaIosStep2}</p>\n                    </div>\n                  )}\n                </div>\n\n                <div className=\"flex items-center justify-end gap-2\">\n                  <button\n                    type=\"button\"\n                    onClick={() => setActionModal({ type: null })}\n                    className=\"px-4 py-2 rounded-lg bg-slate-800 text-xs text-slate-300 hover:bg-slate-700 cursor-pointer\"\n                  >\n                    {t.btnClose}\n                  </button>\n                  <button\n                    type=\"button\"\n                    onClick={async () => {\n                      if (deferredPrompt) {\n                        await deferredPrompt.prompt();\n                      }\n                      setIsPwaInstalled(true);\n                      try {\n                        window.localStorage.setItem(\n                          STORAGE_KEYS.PWA_SHORTCUT_PINNED,\n                          \'true\'\n                        );\n                      } catch {}\n                      setActionModal({ type: null });\n                      triggerToast(t.toastPwaInstalled(activeCustomer.id));\n                    }}\n                    className=\"px-4 py-2 rounded-lg bg-amber-400 hover:bg-amber-300 text-slate-950 text-xs font-semibold cursor-pointer\"\n                  >\n                    {t.btnInstallPwaNow}\n                  </button>\n                </div>\n              </div>\n            ) : (\n              <form\n                onSubmit={(e) => {\n                  e.preventDefault();\n                  const targetEmail =\n                    actionModal.emailInput || activeCustomer.email;\n                  try {\n                    window.localStorage.setItem(\n                      STORAGE_KEYS.BACKUP_EMAIL,\n                      targetEmail\n                    );\n                  } catch {}\n                  setCustomers((prev) =>\n                    prev.map((c) =>\n                      c.id === activeCustomer.id\n                        ? { ...c, email: targetEmail }\n                        : c\n                    )\n                  );\n                  setActionModal({ type: null });\n                  triggerToast(\n                    t.toastEmailSent(activeCustomer.id, targetEmail)\n                  );\n                }}\n                className=\"space-y-4\"\n              >\n                <p className=\"text-xs text-slate-300 leading-relaxed\">\n                  {t.emailModalDesc} (\n                  <span className=\"font-mono tabular-nums text-amber-300\">\n                    {activeCustomer.id}\n                  </span>\n                  ) {t.emailModalToAddress}\n                </p>\n                <div>\n                  <label className=\"block text-xs text-slate-400 mb-1\">\n                    {t.recipientEmailLabel}\n                  </label>\n                  <input\n                    type=\"email\"\n                    required\n                    value={actionModal.emailInput ?? activeCustomer.email}\n                    onChange={(e) =>\n                      setActionModal((prev) => ({\n                        ...prev,\n                        emailInput: e.target.value,\n                      }))\n                    }\n                    className=\"w-full h-10 px-3 rounded-lg bg-slate-950 border border-slate-800 text-sm text-slate-100 focus:outline-none focus:border-amber-400\"\n                  />\n                </div>\n                <div className=\"flex items-center justify-end gap-2\">\n                  <button\n                    type=\"button\"\n                    onClick={() => setActionModal({ type: null })}\n                    className=\"px-4 py-2 rounded-lg bg-slate-800 text-xs text-slate-300 hover:bg-slate-700 cursor-pointer\"\n                  >\n                    {t.btnCancel}\n                  </button>\n                  <button\n                    type=\"submit\"\n                    className=\"px-4 py-2 rounded-lg bg-amber-400 hover:bg-amber-300 text-slate-950 text-xs font-semibold cursor-pointer\"\n                  >\n                    {t.btnSendRecovery}\n                  </button>\n                </div>\n              </form>\n            )}\n          </div>\n        </div>\n      )}\n\n      {/* Offline Connectivity Banner */}\n      {!isOnline && (\n        <div\n          role=\"status\"\n          className=\"fixed bottom-4 left-4 z-50 flex items-center gap-2 rounded-xl bg-amber-400 px-3.5 py-2 text-xs font-semibold text-slate-950 shadow-lg\"\n        >\n          <WifiOff className=\"w-4 h-4 shrink-0\" />\n          <span>{t.offlineBanner}</span>\n        </div>\n      )}\n\n      {/* Toast Feedback Banner */}\n      {toastMessage && (\n        <div\n          role=\"status\"\n          className=\"fixed top-16 right-6 z-50 flex items-center gap-2.5 px-4 py-3 rounded-xl bg-slate-900/95 border border-amber-400/40 text-xs font-medium text-slate-100 shadow-xl backdrop-blur-md\"\n        >\n          <Check className=\"w-4 h-4 text-amber-400 shrink-0\" />\n          <span>{toastMessage}</span>\n        </div>\n      )}\n    </div>\n  );\n}\n"
        path {
          absolute_uri: "file:///app/page.tsx"
        }
        overwrite: true
      }
    }
