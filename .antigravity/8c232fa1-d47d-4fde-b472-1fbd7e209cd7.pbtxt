    command_line: "node -e \'\nconst fs = require(\"fs\");\nconst zlib = require(\"zlib\");\n\nfunction decodePng(filePath) {\n  const buf = fs.readFileSync(filePath);\n  const w = buf.readUInt32BE(16);\n  const h = buf.readUInt32BE(20);\n  let offset = 8;\n  const idatChunks = [];\n  while (offset < buf.length) {\n    const len = buf.readUInt32BE(offset);\n    const type = buf.toString(\"ascii\", offset + 4, offset + 8);\n    if (type === \"IDAT\") idatChunks.push(buf.subarray(offset + 8, offset + 8 + len));\n    offset += 12 + len;\n  }\n  const raw = zlib.inflateSync(Buffer.concat(idatChunks));\n  const bpp = 4, stride = w * bpp;\n  const pixels = Buffer.alloc(w * h * bpp);\n  function paeth(a, b, c) {\n    const p = a + b - c, pa = Math.abs(p - a), pb = Math.abs(p - b), pc = Math.abs(p - c);\n    return (pa <= pb && pa <= pc) ? a : (pb <= pc ? b : c);\n  }\n  for (let y = 0; y < h; y++) {\n    const filter = raw[y * (stride + 1)];\n    const rowIn = y * (stride + 1) + 1, rowOut = y * stride;\n    for (let i = 0; i < stride; i++) {\n      const x = raw[rowIn + i];\n      const a = i >= bpp ? pixels[rowOut + i - bpp] : 0;\n      const b = y > 0 ? pixels[rowOut - stride + i] : 0;\n      const c = (y > 0 && i >= bpp) ? pixels[rowOut - stride + i - bpp] : 0;\n      let val = x;\n      if (filter === 1) val = (x + a) & 0xff;\n      else if (filter === 2) val = (x + b) & 0xff;\n      else if (filter === 3) val = (x + ((a + b) >> 1)) & 0xff;\n      else if (filter === 4) val = (x + paeth(a, b, c)) & 0xff;\n      pixels[rowOut + i] = val;\n    }\n  }\n  return { w, h, pixels };\n}\n\nconst empty = decodePng(\"public/kartu-belakang-kosong.png\");\nconst stamped = decodePng(\"public/assets/aistudio/kartu_belakang_a1c1455d.png\");\n\n// Find the olive border of TEMPAT QR CODE box in bottom right (x: 2100..2750, y: 1100..1720)\nlet bMinX = empty.w, bMaxX = 0, bMinY = empty.h, bMaxY = 0;\nfor (let y = 1100; y < 1720; y++) {\n  for (let x = 2100; x < 2740; x++) {\n    const idx = (y * empty.w + x) * 4;\n    // dark olive border has R < 100\n    if (empty.pixels[idx] < 100 && empty.pixels[idx+3] > 200) {\n      if (x < bMinX) bMinX = x;\n      if (x > bMaxX) bMaxX = x;\n      if (y < bMinY) bMinY = y;\n      if (y > bMaxY) bMaxY = y;\n    }\n  }\n}\nconsole.log(\"QR Outer Olive Box:\", {\n  bMinX, bMaxX, bMinY, bMaxY,\n  leftPct: (bMinX / empty.w * 100).toFixed(2),\n  topPct: (bMinY / empty.h * 100).toFixed(2),\n  widthPct: ((bMaxX - bMinX) / empty.w * 100).toFixed(2),\n  heightPct: ((bMaxY - bMinY) / empty.h * 100).toFixed(2),\n});\n\n// Find inner white area of QR box along center x=2445 and center y=1440\nconst midX = Math.round((bMinX + bMaxX) / 2);\nconst midY = Math.round((bMinY + bMaxY) / 2);\nlet wMinX = midX, wMaxX = midX, wMinY = midY, wMaxY = midY;\nwhile (wMinX > bMinX && empty.pixels[(midY * empty.w + wMinX) * 4] > 200) wMinX--;\nwhile (wMaxX < bMaxX && empty.pixels[(midY * empty.w + wMaxX) * 4] > 200) wMaxX++;\nwhile (wMinY > bMinY && empty.pixels[(wMinY * empty.w + midX) * 4] > 200) wMinY--;\nwhile (wMaxY < bMaxY && empty.pixels[(wMaxY * empty.w + midX) * 4] > 200) wMaxY++;\n\nconsole.log(\"QR Inner White Box:\", {\n  wMinX, wMaxX, wMinY, wMaxY,\n  leftPct: (wMinX / empty.w * 100).toFixed(2),\n  topPct: (wMinY / empty.h * 100).toFixed(2),\n  widthPct: ((wMaxX - wMinX) / empty.w * 100).toFixed(2),\n  heightPct: ((wMaxY - wMinY) / empty.h * 100).toFixed(2),\n});\n\'"
