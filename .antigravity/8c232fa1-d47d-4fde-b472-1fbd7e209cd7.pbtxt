            lines {
              text: "    if (!cid) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      cid = \'VSP-\' + Math.floor(1000 + Math.random() * 9000) + \'-\' + Math.floor(100 + Math.random() * 900) + \'K\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      localStorage.setItem(\'vespera_anon_customer_id\', cid);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    document.getElementById(\'cidLabel\').textContent = \'ID: \' + cid;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const flipper = document.getElementById(\'cardFlipper\');"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const drawer = document.getElementById(\'actionDrawer\');"
