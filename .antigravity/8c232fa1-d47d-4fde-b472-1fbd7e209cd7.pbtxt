 0;\\nfor (let y = 1100; y < 1720; y++) {\\n  for (let x = 2100; x < 2740; x++) {\\n    const idx = (y * empty.w + x) * 4;\\n    // dark olive border has R < 100\\n    if (empty.pixels[idx] < 100 && empty.pixels[idx+3] > 200) {\\n      if (x < bMinX) bMinX = x;\\n      if (x > bMaxX) bMaxX = x;\\n      if (y < bMinY) bMinY = y;\\n      if (y > bMaxY) bMaxY = y;\\n    }\\n  }\\n}\\nconsole.log(\\\"QR Outer Olive Box:\\\", {\\n  bMinX, bMaxX, bMinY, bMaxY,\\n  leftPct: (bMinX / empty.w * 100).toFixed(2),\\n  topPct: (bMinY / empty.h * 100).toFixed(2),\\n  widthPct: ((bMaxX - bMinX) / empty.w * 100).toFixed(2),\\n  heightPct: ((bMaxY - bMinY) / empty.h * 100).toFixed(2),\\n});\\n\\n// Find inner white area of QR box along center x=2445 and center y=1440\\nconst midX = Math.round((bMinX + bMaxX) / 2);\\nconst midY = Math.round((bMinY + bMaxY) / 2);\\nlet wMinX = midX, wMaxX = midX, wMinY = midY, wMaxY = midY;\\nwhile (wMinX > bMinX && empty.pixels[(midY * empty.w + wMinX) * 4] > 200) wMinX--;\\nwhile (wMaxX < bMaxX && empty.pixels[(midY * empty.w + wMaxX) * 4] > 200) wMaxX++;\\nwhile (wMinY > bMinY && empty.pixels[(wMinY * empty.w + midX) * 4] > 200) wMinY--;\\nwhile (wMaxY < bMaxY && empty.pixels[(wMaxY * empty.w + midX) * 4] > 200) wMaxY++;\\n\\nconsole.log(\\\"QR Inner White Box:\\\", {\\n  wMinX, wMaxX, wMinY, wMaxY,\\n  leftPct: (wMinX / empty.w * 100).toFixed(2),\\n  topPct: (wMinY / empty.h * 100).toFixed(2),\\n  widthPct: ((wMaxX - wMinX) / empty.w * 100).toFixed(2),\\n  heightPct: ((wMaxY - wMinY) / empty.h * 100).toFixed(2),\\n});\\n\'\", \"Cwd\":\".\", \"WaitMsBeforeAsync\":10000, \"toolAction\":\"Measuring exact inner coordinates of TEMPAT QR CODE box\", \"toolSummary\":\"Measure TEMPAT QR CODE inner coordinates\"}"
