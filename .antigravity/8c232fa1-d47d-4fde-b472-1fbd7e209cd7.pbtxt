    command_line: "node -e \'\nconst fs = require(\"fs\");\nconst zlib = require(\"zlib\");\n\nfs.copyFileSync(\"public/assets/aistudio/kartu_depan_101f4ead.png\", \"public/kartu-depan.png\");\nfs.copyFileSync(\"public/assets/aistudio/kartu_belakang_sebelum_stampel_e3d362fc.png\", \"public/kartu-belakang-kosong.png\");\n\nfunction readPngDimensions(path) {\n  const buf = fs.readFileSync(path);\n  const w = buf.readUInt32BE(16);\n  const h = buf.readUInt32BE(20);\n  const bitDepth = buf[24];\n  const colorType = buf[25];\n  return { w, h, bitDepth, colorType };\n}\n\nconsole.log(\"Depan:\", readPngDimensions(\"public/kartu-depan.png\"));\nconsole.log(\"Belakang kosong:\", readPngDimensions(\"public/kartu-belakang-kosong.png\"));\nconsole.log(\"Belakang stamped:\", readPngDimensions(\"public/assets/aistudio/kartu_belakang_a1c1455d.png\"));\n\'"
