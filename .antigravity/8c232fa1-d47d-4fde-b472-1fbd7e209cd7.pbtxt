    command_line: "node -e \'\nconst fs = require(\"fs\");\nconst zlib = require(\"zlib\");\n\nfunction decodePng(filePath) {\n  const buf = fs.readFileSync(filePath);\n  const w = buf.readUInt32BE(16);\n  const h = buf.readUInt32BE(20);\n  let offset = 8;\n  const idatChunks = [];\n  while (offset < buf.length) {\n    const len = buf.readUInt32BE(offset);\n    const type = buf.toString(\"ascii\", offset + 4, offset + 8);\n    if (type === \"IDAT\") idatChunks.push(buf.subarray(offset + 8, offset + 8 + len));\n    offset += 12 + len;\n  }\n  const raw = zlib.inflateSync(Buffer.concat(idatChunks));\n  const bpp = 4, stride = w * bpp;\n  const pixels = Buffer.alloc(w * h * bpp);\n  function paeth(a, b, c) {\n    const p = a + b - c, pa = Math.abs(p - a), pb = Math.abs(p - b), pc = Math.abs(p - c);\n    return (pa <= pb && pa <= pc) ? a : (pb <= pc ? b : c);\n  }\n  for (let y = 0; y < h; y++) {\n    const filter = raw[y * (stride + 1)];\n    const rowIn = y * (stride + 1) + 1, rowOut = y * stride;\n    for (let i = 0; i < stride; i++) {\n      const x = raw[rowIn + i];\n      const a = i >= bpp ? pixels[rowOut + i - bpp] : 0;\n      const b = y > 0 ? pixels[rowOut - stride + i] : 0;\n      const c = (y > 0 && i >= bpp) ? pixels[rowOut - stride + i - bpp] : 0;\n      let val = x;\n      if (filter === 1) val = (x + a) & 0xff;\n      else if (filter === 2) val = (x + b) & 0xff;\n      else if (filter === 3) val = (x + ((a + b) >> 1)) & 0xff;\n      else if (filter === 4) val = (x + paeth(a, b, c)) & 0xff;\n      pixels[rowOut + i] = val;\n    }\n  }\n  return { w, h, pixels };\n}\n\nconst crcTable = new Uint32Array(256);\nfor (let n = 0; n < 256; n++) {\n  let c = n;\n  for (let k = 0; k < 8; k++) c = c & 1 ? 0xedb88320 ^ (c >>> 1) : c >>> 1;\n  crcTable[n] = c;\n}\nfunction crc32(buf) {\n  let c = -1;\n  for (let i = 0; i < buf.length; i++) c = (c >>> 8) ^ crcTable[(c ^ buf[i]) & 0xff];\n  return (c ^ -1) >>> 0;\n}\nfunction chunk(type, data) {\n  const len = Buffer.alloc(4);\n  len.writeUInt32BE(data.length, 0);\n  const typeBuf = Buffer.from(type, \"ascii\");\n  const crcBuf = Buffer.alloc(4);\n  crcBuf.writeUInt32BE(crc32(Buffer.concat([typeBuf, data])), 0);\n  return Buffer.concat([len, typeBuf, data, crcBuf]);\n}\nfunction encodePng(w, h, rgba) {\n  const raw = Buffer.alloc(h * (1 + w * 4));\n  for (let y = 0; y < h; y++) {\n    raw[y * (1 + w * 4)] = 0;\n    rgba.copy(raw, y * (1 + w * 4) + 1, y * w * 4, (y + 1) * w * 4);\n  }\n  const ihdr = Buffer.alloc(13);\n  ihdr.writeUInt32BE(w, 0);\n  ihdr.writeUInt32BE(h, 4);\n  ihdr[8] = 8; ihdr[9] = 6; ihdr[10] = 0; ihdr[11] = 0; ihdr[12] = 0;\n  return Buffer.concat([\n    Buffer.from([137, 80, 78, 71, 13, 10, 26, 10]),\n    chunk(\"IHDR\", ihdr),\n    chunk(\"IDAT\", zlib.deflateSync(raw)),\n    chunk(\"IEND\", Buffer.alloc(0)),\n  ]);\n}\n\nconst empty = decodePng(\"public/kartu-belakang-kosong.png\");\nconst stamped = decodePng(\"public/assets/aistudio/kartu_belakang_a1c1455d.png\");\n\n// Extract Stamp 1 (Latte Art Cup) centered at cx=564, cy=705 with box 380x380\n// Wait: let us check the bounding box of diff in Circle 1 (x: 380..770, y: 490..880)\nconst size = 380;\nconst x0 = 564 - size / 2; // 374\nconst y0 = 705 - size / 2; // 515\nconst outRgba = Buffer.alloc(size * size * 4);\n\nfor (let y = 0; y < size; y++) {\n  for (let x = 0; x < size; x++) {\n    const sx = x0 + x;\n    const sy = y0 + y;\n    const idx = (sy * empty.w + sx) * 4;\n    const rS = stamped.pixels[idx], gS = stamped.pixels[idx+1], bS = stamped.pixels[idx+2];\n    const rE = empty.pixels[idx], gE = empty.pixels[idx+1], bE = empty.pixels[idx+2];\n    const diff = Math.abs(rS - rE) + Math.abs(gS - gE) + Math.abs(bS - bE);\n    const outIdx = (y * size + x) * 4;\n    if (diff > 25) {\n      // Smooth alpha based on darkness / difference from cream background (239, 229, 209)\n      const alpha = Math.min(255, Math.round(diff * 1.4));\n      outRgba[outIdx] = rS;\n      outRgba[outIdx + 1] = gS;\n      outRgba[outIdx + 2] = bS;\n      outRgba[outIdx + 3] = alpha;\n    } else {\n      outRgba[outIdx + 3] = 0;\n    }\n  }\n}\n\nfs.writeFileSync(\"public/stamp-icon.png\", encodePng(size, size, outRgba));\nconsole.log(\"Extracted public/stamp-icon.png (\" + size + \"x\" + size + \") successfully\");\n\'"
