  code_action {
    action_spec {
      create_file {
        instruction: "\'use client\';\n\nimport React, { useState, useEffect, useRef, useMemo } from \'react\';\nimport {\n  RotateCw,\n  Smartphone,\n  QrCode,\n  Sparkles,\n  Check,\n  Plus,\n  Minus,\n  Award,\n  Mail,\n  Wallet,\n  Search,\n  Users,\n  ArrowUpRight,\n  Download,\n  Sliders,\n  ShieldCheck,\n  RefreshCw,\n  ChevronDown,\n  X,\n  CreditCard,\n  LayoutGrid,\n} from \'lucide-react\';\n\ninterface CustomerRecord {\n  id: string;\n  name: string;\n  email: string;\n  tier: string;\n  currentStamps: number;\n  totalRedeemedStamps: number;\n  lastVisit: string;\n}\n\nconst INITIAL_CUSTOMERS: CustomerRecord[] = [\n  {\n    id: \'VSP-8842-901K\',\n    name: \'Elena Rostova\',\n    email: \'elena.rostova@atelier-mail.com\',\n    tier: \'Obsidian Member\',\n    currentStamps: 7,\n    totalRedeemedStamps: 40,\n    lastVisit: \'2026-10-30\',\n  },\n  {\n    id: \'VSP-3109-442M\',\n    name: \'Marcus Vance\',\n    email: \'m.vance@kinetix.io\',\n    tier: \'Titanium Member\',\n    currentStamps: 10,\n    totalRedeemedStamps: 70,\n    lastVisit: \'2026-10-29\',\n  },\n  {\n    id: \'VSP-6591-208J\',\n    name: \'Sora Takahashi\',\n    email: \'sora@studio-takahashi.jp\',\n    tier: \'Obsidian Member\',\n    currentStamps: 4,\n    totalRedeemedStamps: 20,\n    lastVisit: \'2026-10-28\',\n  },\n  {\n    id: \'VSP-1940-773R\',\n    name: \'Julian Sterling\',\n    email: \'j.sterling@sterlingarch.co\',\n    tier: \'Platinum Member\',\n    currentStamps: 9,\n    totalRedeemedStamps: 50,\n    lastVisit: \'2026-10-27\',\n  },\n  {\n    id: \'VSP-5028-619D\',\n    name: \'Amara Okafor\',\n    email: \'amara@lumina-design.org\',\n    tier: \'Titanium Member\',\n    currentStamps: 2,\n    totalRedeemedStamps: 10,\n    lastVisit: \'2026-10-25\',\n  },\n  {\n    id: \'VSP-7734-115V\',\n    name: \'Henrik Lindqvist\',\n    email: \'henrik@nordic-craft.se\',\n    tier: \'Platinum Member\',\n    currentStamps: 10,\n    totalRedeemedStamps: 90,\n    lastVisit: \'2026-10-24\',\n  },\n];\n\n// Deterministic 13x13 QR Matrix generator from Customer ID\nfunction generateQrMatrix(seedStr: string): boolean[][] {\n  const size = 13;\n  const grid: boolean[][] = Array.from({ length: size }, () =>\n    Array(size).fill(false)\n  );\n\n  // Helper to draw 3x3 finder-like corner patterns\n  const drawFinder = (r0: number, c0: number) => {\n    for (let r = 0; r < 4; r++) {\n      for (let c = 0; c < 4; c++) {\n        if (\n          r === 0 ||\n          r === 3 ||\n          c === 0 ||\n          c === 3 ||\n          (r >= 1 && r <= 2 && c >= 1 && c <= 2)\n        ) {\n          grid[r0 + r][c0 + c] = true;\n        }\n      }\n    }\n  };\n\n  drawFinder(0, 0);\n  drawFinder(0, size - 4);\n  drawFinder(size - 4, 0);\n\n  let hash = 2166136261;\n  for (let i = 0; i < seedStr.length; i++) {\n    hash ^= seedStr.charCodeAt(i);\n    hash = Math.imul(hash, 16777619);\n  }\n\n  for (let r = 0; r < size; r++) {\n    for (let c = 0; c < size; c++) {\n      const inTopLeft = r < 5 && c < 5;\n      const inTopRight = r < 5 && c >= size - 5;\n      const inBottomLeft = r >= size - 5 && c < 5;\n      if (inTopLeft || inTopRight || inBottomLeft) continue;\n\n      hash ^= (r * 31 + c * 17) & 0xff;\n      hash = Math.imul(hash, 16777619);\n      grid[r][c] = (Math.abs(hash) % 10) < 5;\n    }\n  }\n  return grid;\n}\n\nexport default function DigitalLoyaltyApp() {\n  // Customers & Active Member State\n  const [customers, setCustomers] = useState<CustomerRecord[]>(INITIAL_CUSTOMERS);\n  const [selectedCustomerId, setSelectedCustomerId] = useState<string>(\n    INITIAL_CUSTOMERS[0].id\n  );\n\n  const activeCustomer = useMemo(\n    () =>\n      customers.find((c) => c.id === selectedCustomerId) || customers[0],\n    [customers, selectedCustomerId]\n  );\n\n  // Card Interactivity State\n  const [isFlipped, setIsFlipped] = useState<boolean>(false);\n  const [tilt, setTilt] = useState<{ rx: number; ry: number; gx: number; gy: number }>({\n    rx: 0,\n    ry: 0,\n    gx: 50,\n    gy: 50,\n  });\n  const [gyroStatus, setGyroStatus] = useState<\'idle\' | \'active\' | \'simulated\'>(\'idle\');\n\n  // View / Dashboard Mode State\n  const [viewMode, setViewMode] = useState<\'pass\' | \'dashboard\' | \'split\'>(\'split\');\n  const [searchQuery, setSearchQuery] = useState<string>(\'\');\n  const [tableFilter, setTableFilter] = useState<\'all\' | \'ready\' | \'vip\'>(\'all\');\n\n  // New Customer Form in Dashboard\n  const [showAddMemberModal, setShowAddMemberModal] = useState<boolean>(false);\n  const [newMemberName, setNewMemberName] = useState<string>(\'\');\n  const [newMemberEmail, setNewMemberEmail] = useState<string>(\'\');\n\n  // Slide-Up Drawer Action Feedback Modal / Toast State\n  const [walletModal, setWalletModal] = useState<{\n    type: \'apple\' | \'google\' | \'email\' | null;\n    emailInput?: string;\n    dispatched?: boolean;\n  }>({ type: null });\n\n  const [toastMessage, setToastMessage] = useState<string | null>(null);\n  const cardStageRef = useRef<HTMLDivElement | null>(null);\n\n  const triggerToast = (msg: string) => {\n    setToastMessage(msg);\n  };\n\n  useEffect(() => {\n    if (!toastMessage) return;\n    const timer = setTimeout(() => setToastMessage(null), 3200);\n    return () => clearTimeout(timer);\n  }, [toastMessage]);\n\n  // DeviceOrientation API Listener for Physical Phone Tilt\n  useEffect(() => {\n    const handleOrientation = (event: DeviceOrientationEvent) => {\n      if (event.beta === null || event.gamma === null) return;\n      // Constrain beta [-35, 35] (resting phone ~ 45deg) and gamma [-35, 35]\n      const normalizedBeta = Math.max(-30, Math.min(30, event.beta - 40));\n      const normalizedGamma = Math.max(-30, Math.min(30, event.gamma));\n\n      const rx = Number((-normalizedBeta * 0.55).toFixed(2));\n      const ry = Number((normalizedGamma * 0.65).toFixed(2));\n      const gx = Math.round(50 + (normalizedGamma / 30) * 40);\n      const gy = Math.round(50 + (normalizedBeta / 30) * 40);\n\n      setGyroStatus(\'active\');\n      setTilt({ rx, ry, gx, gy });\n    };\n\n    window.addEventListener(\'deviceorientation\', handleOrientation, true);\n    return () => {\n      window.removeEventListener(\'deviceorientation\', handleOrientation, true);\n    };\n  }, []);\n\n  // Request iOS 13+ DeviceOrientation Permission explicitly when tapped\n  const requestGyroPermission = async () => {\n    try {\n      const DeviceOrientationEventTyped = DeviceOrientationEvent as unknown as {\n        requestPermission?: () => Promise<\'granted\' | \'denied\'>;\n      };\n      if (typeof DeviceOrientationEventTyped.requestPermission === \'function\') {\n        const permission = await DeviceOrientationEventTyped.requestPermission();\n        if (permission === \'granted\') {\n          setGyroStatus(\'active\');\n          triggerToast(\'DeviceOrientation motion sensor linked\');\n        } else {\n          triggerToast(\'Motion permission declined \342\200\224 using interactive touch tilt\');\n        }\n      } else {\n        setGyroStatus(\'active\');\n        triggerToast(\'DeviceOrientation listener active \342\200\224 tilt your device or drag card\');\n      }\n    } catch {\n      setGyroStatus(\'simulated\');\n      triggerToast(\'Using interactive pointer & gyroscope simulator\');\n    }\n  };\n\n  // Pointer Move Tilt on Card Stage (smooth fallback when on desktop)\n  const handleStagePointerMove = (e: React.PointerEvent<HTMLDivElement>) => {\n    if (!cardStageRef.current) return;\n    const rect = cardStageRef.current.getBoundingClientRect();\n    const xRel = (e.clientX - rect.left) / rect.width; // 0..1\n    const yRel = (e.clientY - rect.top) / rect.height; // 0..1\n\n    const ry = Number(((xRel - 0.5) * 26).toFixed(2));\n    const rx = Number(((0.5 - yRel) * 22).toFixed(2));\n    const gx = Math.round(xRel * 100);\n    const gy = Math.round(yRel * 100);\n\n    setTilt({ rx, ry, gx, gy });\n  };\n\n  const handleStagePointerLeave = () => {\n    if (gyroStatus !== \'simulated\') {\n      setTilt({ rx: 0, ry: 0, gx: 50, gy: 50 });\n    }\n  };\n\n  // Stamp Modification Handlers\n  const updateCustomerStamps = (customerId: string, delta: number) => {\n    setCustomers((prev) =>\n      prev.map((c) => {\n        if (c.id !== customerId) return c;\n        const nextStamps = Math.max(0, Math.min(10, c.currentStamps + delta));\n        return {\n          ...c,\n          currentStamps: nextStamps,\n          lastVisit: \'2026-10-30\',\n        };\n      })\n    );\n    if (delta > 0) {\n      triggerToast(`Issued +${delta} stamp to ${customerId}`);\n    }\n  };\n\n  const setExactStampCount = (customerId: string, count: number, e: React.MouseEvent) => {\n    e.stopPropagation(); // Prevent flipping card when clicking an individual stamp recess\n    setCustomers((prev) =>\n      prev.map((c) => {\n        if (c.id !== customerId) return c;\n        const target = c.currentStamps === count ? count - 1 : count;\n        return {\n          ...c,\n          currentStamps: Math.max(0, Math.min(10, target)),\n          lastVisit: \'2026-10-30\',\n        };\n      })\n    );\n  };\n\n  const redeemCustomerReward = (customerId: string) => {\n    const target = customers.find((c) => c.id === customerId);\n    if (!target || target.currentStamps < 10) {\n      triggerToast(\'Collect all 10 stamps to redeem a complimentary reward\');\n      return;\n    }\n    setCustomers((prev) =>\n      prev.map((c) => {\n        if (c.id !== customerId) return c;\n        return {\n          ...c,\n          currentStamps: 0,\n          totalRedeemedStamps: c.totalRedeemedStamps + 10,\n          lastVisit: \'2026-10-30\',\n        };\n      })\n    );\n    triggerToast(`Redeemed 10 stamps for ${target.name} (+10 added to B2B ledger)`);\n  };\n\n  const handleAddMember = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!newMemberName.trim()) return;\n    const randomNum = Math.floor(1000 + Math.random() * 9000);\n    const randomSuffix = Math.floor(100 + Math.random() * 900);\n    const newId = `VSP-${randomNum}-${randomSuffix}X`;\n    const created: CustomerRecord = {\n      id: newId,\n      name: newMemberName.trim(),\n      email: newMemberEmail.trim() || `${newMemberName.trim().toLowerCase().replace(/\\s+/g, \'.\')}@member.io`,\n      tier: \'Titanium Member\',\n      currentStamps: 1,\n      totalRedeemedStamps: 0,\n      lastVisit: \'2026-10-30\',\n    };\n    setCustomers((prev) => [created, ...prev]);\n    setSelectedCustomerId(created.id);\n    setNewMemberName(\'\');\n    setNewMemberEmail(\'\');\n    setShowAddMemberModal(false);\n    triggerToast(`Registered ${created.name} (${created.id})`);\n  };\n\n  // Filtered B2B Customers\n  const filteredCustomers = useMemo(() => {\n    return customers.filter((c) => {\n      const matchesQuery =\n        c.name.toLowerCase().includes(searchQuery.toLowerCase()) ||\n        c.id.toLowerCase().includes(searchQuery.toLowerCase()) ||\n        c.email.toLowerCase().includes(searchQuery.toLowerCase());\n      if (!matchesQuery) return false;\n      if (tableFilter === \'ready\') return c.currentStamps === 10;\n      if (tableFilter === \'vip\') return c.totalRedeemedStamps >= 40;\n      return true;\n    });\n  }, [customers, searchQuery, tableFilter]);\n\n  // Aggregate B2B Metrics\n  const b2bStats = useMemo(() => {\n    const totalMembers = customers.length;\n    const activeStamps = customers.reduce((acc, c) => acc + c.currentStamps, 0);\n    const totalRedeemed = customers.reduce((acc, c) => acc + c.totalRedeemedStamps, 0);\n    const readyCount = customers.filter((c) => c.currentStamps === 10).length;\n    return { totalMembers, activeStamps, totalRedeemed, readyCount };\n  }, [customers]);\n\n  const qrMatrix = useMemo(\n    () => generateQrMatrix(activeCustomer.id),\n    [activeCustomer.id]\n  );\n\n  // Generate and download a standalone single-file HTML version\n  const handleDownloadSingleFileHtml = () => {\n    const singleFileSource = `<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\" />\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n<title>Vespera Metal Loyalty Card \342\200\224 Single File Web App</title>\n<style>\n  :root {\n    --rx: 0deg;\n    --ry: 0deg;\n    --gx: 50%;\n    --gy: 50%;\n  }\n  * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, \"Plus Jakarta Sans\", sans-serif; }\n  body { background: #0B0D11; color: #F1F5F9; min-height: 100vh; display: flex; flex-direction: column; overflow-x: hidden; }\n  header { display: flex; align-items: center; justify-content: space-between; padding: 16px 28px; border-bottom: 1px solid rgba(255,255,255,0.08); }\n  .brand { font-weight: 700; letter-spacing: -0.02em; font-size: 18px; }\n  .btn { background: #F59E0B; color: #0B0D11; border: none; padding: 8px 16px; border-radius: 8px; font-weight: 600; font-size: 13px; cursor: pointer; }\n  .btn-outline { background: rgba(255,255,255,0.06); color: #F1F5F9; border: 1px solid rgba(255,255,255,0.14); }\n  main { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 32px 20px 140px; gap: 28px; }\n  @keyframes floatCard {\n    0%, 100% { transform: translateY(0px); }\n    50% { transform: translateY(-12px); }\n  }\n  .float-wrap { animation: floatCard 5.5s ease-in-out infinite; perspective: 1400px; }\n  .card-tilt {\n    width: min(420px, 92vw);\n    aspect-ratio: 1.586 / 1;\n    transform-style: preserve-3d;\n    transform: rotateX(var(--rx)) rotateY(var(--ry));\n    transition: transform 0.12s ease-out;\n    cursor: pointer;\n  }\n  .card-flipper {\n    width: 100%; height: 100%; position: relative;\n    transform-style: preserve-3d;\n    transition: transform 0.78s cubic-bezier(0.22, 1, 0.36, 1);\n  }\n  .card-flipper.flipped { transform: rotateY(180deg); }\n  .card-face {\n    position: absolute; inset: 0; border-radius: 20px;\n    backface-visibility: hidden; -webkit-backface-visibility: hidden;\n    overflow: hidden;\n    background:\n      repeating-linear-gradient(90deg, rgba(255,255,255,0.018) 0px, rgba(255,255,255,0.018) 1px, transparent 1px, transparent 3px),\n      linear-gradient(135deg, #2d333f 0%, #161920 35%, #303744 52%, #12151c 82%, #242934 100%);\n    border: 1px solid rgba(255,255,255,0.22);\n    box-shadow: 0 28px 60px -12px rgba(0,0,0,0.75), inset 0 1px 1px rgba(255,255,255,0.3);\n    padding: 24px;\n    display: flex; flex-direction: column; justify-content: space-between;\n  }\n  .card-face::before {\n    content: \"\"; position: absolute; inset: -40%;\n    background: conic-gradient(from 140deg at var(--gx) var(--gy), transparent 0deg, rgba(255,190,110,0.22) 60deg, rgba(96,210,255,0.26) 120deg, rgba(210,130,255,0.22) 180deg, transparent 240deg);\n    mix-blend-mode: color-dodge; pointer-events: none;\n  }\n  .card-back { transform: rotateY(180deg); }\n  .stamps { display: grid; grid-template-columns: repeat(5, 1fr); gap: 10px; margin: 12px 0; z-index: 2; }\n  .stamp { aspect-ratio: 1; border-radius: 50%; border: 1px solid rgba(255,255,255,0.2); display: flex; align-items: center; justify-content: center; font-size: 11px; font-family: monospace; background: rgba(0,0,0,0.35); }\n  .stamp.active { background: radial-gradient(circle, #fbbf24 0%, #b45309 100%); color: #0B0D11; font-weight: 700; border-color: #fde68a; }\n  .drawer {\n    position: fixed; left: 0; right: 0; bottom: 0;\n    background: rgba(18, 22, 31, 0.96); backdrop-filter: blur(16px);\n    border-top: 1px solid rgba(255,255,255,0.14); border-radius: 24px 24px 0 0;\n    padding: 16px 24px 28px; transform: translateY(105%);\n    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);\n    display: flex; flex-direction: column; align-items: center; gap: 14px; z-index: 50;\n  }\n  .drawer.open { transform: translateY(0); }\n  .drawer-btns { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; width: 100%; max-width: 540px; }\n  .drawer-btns button { flex: 1; min-width: 150px; padding: 12px 16px; border-radius: 12px; border: 1px solid rgba(255,255,255,0.15); background: #1E2430; color: #fff; font-weight: 600; cursor: pointer; }\n  .dashboard { width: min(960px, 94vw); background: #12161F; border: 1px solid rgba(255,255,255,0.1); border-radius: 16px; padding: 24px; display: none; }\n  .dashboard.visible { display: block; }\n  table { width: 100%; border-collapse: collapse; margin-top: 16px; font-size: 14px; }\n  th, td { text-align: left; padding: 12px; border-bottom: 1px solid rgba(255,255,255,0.07); }\n  .mono { font-family: monospace; font-variant-numeric: tabular-nums; }\n</style>\n</head>\n<body>\n  <header>\n    <div class=\"brand\">Vespera Atelier</div>\n    <div style=\"display:flex;gap:10px;\">\n      <button class=\"btn btn-outline\" id=\"toggleDashBtn\">Toggle B2B Dashboard</button>\n      <button class=\"btn\" id=\"flipBtn\">Flip Card</button>\n    </div>\n  </header>\n  <main>\n    <div class=\"float-wrap\">\n      <div class=\"card-tilt\" id=\"cardTilt\">\n        <div class=\"card-flipper\" id=\"cardFlipper\">\n          <div class=\"card-face card-front\">\n            <div style=\"display:flex;justify-content:space-between;align-items:center;z-index:2;\">\n              <span class=\"mono\" style=\"font-size:11px;letter-spacing:0.16em;color:#94A3B8;\">TITANIUM PASS</span>\n              <span class=\"mono\" style=\"font-size:11px;color:#F59E0B;\">NFC // EDITION 09</span>\n            </div>\n            <div style=\"text-align:center;z-index:2;\">\n              <div style=\"width:46px;height:46px;border-radius:50%;border:2px solid #F59E0B;margin:0 auto 10px;display:flex;align-items:center;justify-content:center;font-weight:700;color:#F59E0B;\">V</div>\n              <div style=\"font-size:20px;font-weight:700;letter-spacing:0.18em;\">VESPERA</div>\n              <div style=\"font-size:11px;color:#94A3B8;margin-top:4px;\">ROASTERY & RESERVE</div>\n            </div>\n            <div style=\"display:flex;justify-content:space-between;font-size:11px;color:#94A3B8;z-index:2;\">\n              <span>${activeCustomer.name}</span>\n              <span>Tap card to flip \342\206\222</span>\n            </div>\n          </div>\n          <div class=\"card-face card-back\">\n            <div style=\"display:flex;justify-content:space-between;align-items:center;z-index:2;\">\n              <span style=\"font-weight:700;font-size:12px;letter-spacing:0.1em;\">VESPERA</span>\n              <span class=\"mono\" style=\"font-size:12px;color:#FDE68A;\">ID: ${activeCustomer.id}</span>\n            </div>\n            <div class=\"stamps\" id=\"stampGrid\"></div>\n            <div style=\"display:flex;justify-content:space-between;align-items:flex-end;z-index:2;\">\n              <div>\n                <div style=\"font-size:11px;color:#94A3B8;\">Verified Member Pass</div>\n                <div style=\"font-size:13px;font-weight:600;color:#F8FAFC;\">${activeCustomer.currentStamps} / 10 Stamps Collected</div>\n              </div>\n              <div style=\"background:#fff;padding:5px;border-radius:6px;width:48px;height:48px;display:grid;grid-template-columns:repeat(5,1fr);gap:1px;\">\n                <div style=\"background:#000\"></div><div style=\"background:#000\"></div><div></div><div style=\"background:#000\"></div><div style=\"background:#000\"></div>\n                <div style=\"background:#000\"></div><div></div><div style=\"background:#000\"></div><div></div><div style=\"background:#000\"></div>\n                <div></div><div style=\"background:#000\"></div><div style=\"background:#000\"></div><div style=\"background:#000\"></div><div></div>\n                <div style=\"background:#000\"></div><div></div><div style=\"background:#000\"></div><div></div><div style=\"background:#000\"></div>\n                <div style=\"background:#000\"></div><div style=\"background:#000\"></div><div></div><div style=\"background:#000\"></div><div style=\"background:#000\"></div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n    <section class=\"dashboard\" id=\"b2bDashboard\">\n      <h2 style=\"font-size:18px;\">B2B Merchant Redemption Ledger</h2>\n      <table>\n        <thead><tr><th>Customer Name</th><th>Customer ID</th><th class=\"mono\">Total Redeemed Stamps</th></tr></thead>\n        <tbody>\n          ${customers.map((c) => `<tr><td>${c.name}</td><td class=\"mono\">${c.id}</td><td class=\"mono\">${c.totalRedeemedStamps}</td></tr>`).join(\'\')}\n        </tbody>\n      </table>\n    </section>\n  </main>\n  <div class=\"drawer\" id=\"actionDrawer\">\n    <div style=\"width:40px;height:5px;background:rgba(255,255,255,0.25);border-radius:99px;\"></div>\n    <div style=\"font-size:13px;color:#94A3B8;\">Pass Actions \302\267 ${activeCustomer.id}</div>\n    <div class=\"drawer-btns\">\n      <button onclick=\"alert(\'Added ${activeCustomer.id} to Apple Wallet\')\">Add to Apple Wallet</button>\n      <button onclick=\"alert(\'Saved ${activeCustomer.id} to Google Wallet\')\">Google Wallet</button>\n      <button onclick=\"alert(\'Backup dispatched to ${activeCustomer.email}\')\">Email Backup</button>\n    </div>\n  </div>\n  <script>\n    const flipper = document.getElementById(\'cardFlipper\');\n    const drawer = document.getElementById(\'actionDrawer\');\n    const cardTilt = document.getElementById(\'cardTilt\');\n    const stampGrid = document.getElementById(\'stampGrid\');\n    let flipped = false;\n    for (let i = 1; i <= 10; i++) {\n      const el = document.createElement(\'div\');\n      el.className = \'stamp\' + (i <= ${activeCustomer.currentStamps} ? \' active\' : \'\');\n      el.textContent = i <= ${activeCustomer.currentStamps} ? \'\342\230\205\' : String(i).padStart(2, \'0\');\n      stampGrid.appendChild(el);\n    }\n    function toggleFlip() {\n      flipped = !flipped;\n      flipper.classList.toggle(\'flipped\', flipped);\n      drawer.classList.toggle(\'open\', flipped);\n    }\n    cardTilt.addEventListener(\'click\', toggleFlip);\n    document.getElementById(\'flipBtn\').addEventListener(\'click\', toggleFlip);\n    document.getElementById(\'toggleDashBtn\').addEventListener(\'click\', () => {\n      document.getElementById(\'b2bDashboard\').classList.toggle(\'visible\');\n    });\n    window.addEventListener(\'deviceorientation\', (e) => {\n      if (e.beta == null || e.gamma == null) return;\n      const rx = Math.max(-20, Math.min(20, -(e.beta - 40) * 0.5));\n      const ry = Math.max(-20, Math.min(20, e.gamma * 0.6));\n      document.documentElement.style.setProperty(\'--rx\', rx + \'deg\');\n      document.documentElement.style.setProperty(\'--ry\', ry + \'deg\');\n    });\n    window.addEventListener(\'mousemove\', (e) => {\n      const x = (e.clientX / window.innerWidth - 0.5) * 22;\n      const y = (0.5 - e.clientY / window.innerHeight) * 18;\n      document.documentElement.style.setProperty(\'--ry\', x.toFixed(1) + \'deg\');\n      document.documentElement.style.setProperty(\'--rx\', y.toFixed(1) + \'deg\');\n      document.documentElement.style.setProperty(\'--gx\', Math.round((e.clientX / window.innerWidth) * 100) + \'%\');\n      document.documentElement.style.setProperty(\'--gy\', Math.round((e.clientY / window.innerHeight) * 100) + \'%\');\n    });\n  </script>\n</body>\n</html>`;\n\n    const blob = new Blob([singleFileSource], { type: \'text/html\' });\n    const url = URL.createObjectURL(blob);\n    const a = document.createElement(\'a\');\n    a.href = url;\n    a.download = \'vespera-loyalty-card.html\';\n    document.body.appendChild(a);\n    a.click();\n    document.body.removeChild(a);\n    URL.revokeObjectURL(url);\n    triggerToast(\'Downloaded standalone single-file HTML bundle\');\n  };\n\n  return (\n    <div className=\"min-h-screen bg-[#0B0D11] text-slate-100 flex flex-col relative overflow-x-hidden\">\n      {/* Embedded Keyframes & 3D Metal / Holographic Styles */}\n      <style>{`\n        @keyframes floatCardContinuous {\n          0%, 100% {\n            transform: translate3d(0, 0px, 0) rotateZ(0deg);\n          }\n          50% {\n            transform: translate3d(0, -14px, 0) rotateZ(0.35deg);\n          }\n        }\n        @keyframes holoShimmer {\n          0%, 100% {\n            background-position: 0% 50%;\n          }\n          50% {\n            background-position: 100% 50%;\n          }\n        }\n        .metal-card-floating {\n          animation: floatCardContinuous 5.6s cubic-bezier(0.45, 0.05, 0.55, 0.95) infinite;\n          will-change: transform;\n        }\n        .perspective-stage {\n          perspective: 1400px;\n        }\n        .card-3d-tilt {\n          transform-style: preserve-3d;\n          transition: transform 140ms cubic-bezier(0.16, 1, 0.3, 1);\n          will-change: transform;\n        }\n        .card-3d-flipper {\n          position: relative;\n          width: 100%;\n          height: 100%;\n          transform-style: preserve-3d;\n          transition: transform 760ms cubic-bezier(0.22, 1, 0.36, 1);\n          will-change: transform;\n        }\n        .card-3d-flipper.is-flipped {\n          transform: rotateY(180deg);\n        }\n        .card-face-metal {\n          position: absolute;\n          inset: 0;\n          border-radius: 22px;\n          backface-visibility: hidden;\n          -webkit-backface-visibility: hidden;\n          overflow: hidden;\n          background:\n            repeating-linear-gradient(\n              90deg,\n              rgba(255, 255, 255, 0.016) 0px,\n              rgba(255, 255, 255, 0.016) 1px,\n              transparent 1px,\n              transparent 3px\n            ),\n            repeating-linear-gradient(\n              0deg,\n              rgba(255, 255, 255, 0.01) 0px,\n              rgba(255, 255, 255, 0.01) 1px,\n              transparent 1px,\n              transparent 4px\n            ),\n            linear-gradient(\n              135deg,\n              #313846 0%,\n              #181c24 28%,\n              #2d3442 48%,\n              #12151c 74%,\n              #282f3d 100%\n            );\n          box-shadow:\n            0 30px 65px -15px rgba(0, 0, 0, 0.85),\n            0 0 0 1px rgba(255, 255, 255, 0.2),\n            inset 0 1px 1px rgba(255, 255, 255, 0.35),\n            inset 0 -1px 2px rgba(0, 0, 0, 0.65);\n        }\n        .card-face-back {\n          transform: rotateY(180deg);\n        }\n        .holographic-sheen {\n          background: linear-gradient(\n            125deg,\n            transparent 18%,\n            rgba(255, 196, 112, 0.16) 33%,\n            rgba(94, 234, 212, 0.20) 44%,\n            rgba(129, 140, 248, 0.20) 54%,\n            rgba(244, 114, 182, 0.16) 64%,\n            transparent 80%\n          );\n          background-size: 220% 220%;\n          animation: holoShimmer 7s ease-in-out infinite;\n          mix-blend-mode: color-dodge;\n        }\n        @media (prefers-reduced-motion: reduce) {\n          .metal-card-floating,\n          .holographic-sheen {\n            animation: none !important;\n          }\n        }\n      `}</style>\n\n      {/* Top Bar Contract: Zone 1 (Wordmark) \342\200\224 Zone 2 (4 Single-line Nav Links) \342\200\224 Zone 3 (1 Primary Action) */}\n      <header className=\"sticky top-0 z-30 flex items-center justify-between gap-8 px-6 lg:px-10 h-14 bg-[#0B0D11]/90 backdrop-blur-md border-b border-slate-800/80\">\n        <a\n          href=\"#top\"\n          className=\"text-base font-bold tracking-tight text-slate-100 whitespace-nowrap shrink-0\"\n        >\n          Vespera Atelier\n        </a>\n\n        <nav className=\"hidden md:flex items-center gap-7 text-sm font-medium text-slate-400\">\n          <button\n            type=\"button\"\n            onClick={() => {\n              setViewMode(\'split\');\n              setIsFlipped(false);\n            }}\n            className=\"hover:text-slate-100 transition-colors whitespace-nowrap shrink-0 cursor-pointer\"\n          >\n            Card Front\n          </button>\n          <button\n            type=\"button\"\n            onClick={() => {\n              setViewMode(\'split\');\n              setIsFlipped(true);\n            }}\n            className=\"hover:text-slate-100 transition-colors whitespace-nowrap shrink-0 cursor-pointer\"\n          >\n            10-Stamp Grid\n          </button>\n          <button\n            type=\"button\"\n            onClick={() => {\n              setIsFlipped(true);\n              setWalletModal({ type: \'apple\' });\n            }}\n            className=\"hover:text-slate-100 transition-colors whitespace-nowrap shrink-0 cursor-pointer\"\n          >\n            Wallet Pass\n          </button>\n          <button\n            type=\"button\"\n            onClick={() =>\n              setViewMode((prev) => (prev === \'dashboard\' ? \'split\' : \'dashboard\'))\n            }\n            className=\"hover:text-slate-100 transition-colors whitespace-nowrap shrink-0 cursor-pointer\"\n          >\n            B2B Ledger\n          </button>\n        </nav>\n\n        <div className=\"flex items-center gap-3 shrink-0\">\n          <button\n            type=\"button\"\n            onClick={() => updateCustomerStamps(activeCustomer.id, 1)}\n            className=\"px-4 py-2 text-xs font-semibold text-slate-950 bg-amber-400 hover:bg-amber-300 rounded-lg transition-colors whitespace-nowrap shrink-0 cursor-pointer\"\n          >\n            Issue +1 Stamp\n          </button>\n        </div>\n      </header>\n\n      {/* Workspace Control Bar (Below the Top Bar) */}\n      <div className=\"border-b border-slate-800/60 bg-[#0F1218]\">\n        <div className=\"max-w-7xl mx-auto px-6 lg:px-10 py-3 flex flex-wrap items-center justify-between gap-4\">\n          {/* Clean Unboxed Metadata */}\n          <div className=\"flex flex-wrap items-center gap-2 text-xs text-slate-400\">\n            <span className=\"text-slate-200 font-medium\">{activeCustomer.name}</span>\n            <span aria-hidden=\"true\">\302\267</span>\n            <span className=\"font-mono tabular-nums text-amber-300/90\">\n              {activeCustomer.id}\n            </span>\n            <span aria-hidden=\"true\">\302\267</span>\n            <span className=\"font-mono tabular-nums\">\n              {activeCustomer.currentStamps} / 10 Stamps Active\n            </span>\n            <span aria-hidden=\"true\">\302\267</span>\n            <span className=\"font-mono tabular-nums\">\n              {activeCustomer.totalRedeemedStamps} Total Redeemed\n            </span>\n          </div>\n\n          {/* Interactive Workspace Mode Toggles & Single-File HTML Export */}\n          <div className=\"flex items-center gap-3\">\n            <div\n              role=\"group\"\n              aria-label=\"Workspace View Mode\"\n              className=\"flex items-center gap-1 p-1 bg-slate-900 border border-slate-800 rounded-lg\"\n            >\n              <button\n                type=\"button\"\n                onClick={() => setViewMode(\'split\')}\n                className={`px-3 py-1.5 text-xs font-medium rounded-md transition-colors whitespace-nowrap shrink-0 cursor-pointer ${\n                  viewMode === \'split\'\n                    ? \'bg-slate-800 text-slate-100 shadow-xs\'\n                    : \'text-slate-400 hover:text-slate-200\'\n                }`}\n              >\n                Pass + B2B Split\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => setViewMode(\'pass\')}\n                className={`px-3 py-1.5 text-xs font-medium rounded-md transition-colors whitespace-nowrap shrink-0 cursor-pointer ${\n                  viewMode === \'pass\'\n                    ? \'bg-slate-800 text-slate-100 shadow-xs\'\n                    : \'text-slate-400 hover:text-slate-200\'\n                }`}\n              >\n                Card Focus\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => setViewMode(\'dashboard\')}\n                className={`px-3 py-1.5 text-xs font-medium rounded-md transition-colors whitespace-nowrap shrink-0 cursor-pointer ${\n                  viewMode === \'dashboard\'\n                    ? \'bg-slate-800 text-slate-100 shadow-xs\'\n                    : \'text-slate-400 hover:text-slate-200\'\n                }`}\n              >\n                B2B Dashboard Mode\n              </button>\n            </div>\n\n            <button\n              type=\"button\"\n              onClick={handleDownloadSingleFileHtml}\n              className=\"hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-slate-300 hover:text-white bg-slate-900 hover:bg-slate-800 border border-slate-800 rounded-lg transition-colors whitespace-nowrap shrink-0 cursor-pointer\"\n              title=\"Download standalone single-file HTML/CSS/JS version\"\n            >\n              <Download className=\"w-3.5 h-3.5 text-amber-400\" />\n              <span>Export HTML</span>\n            </button>\n          </div>\n        </div>\n      </div>\n\n      {/* Main Content Container */}\n      <main\n        id=\"top\"\n        className=\"flex-1 max-w-7xl w-full mx-auto px-6 lg:px-10 py-8 pb-44 space-y-12\"\n      >\n        {/* SECTION 1: 3D METAL LOYALTY CARD & INTERACTIVE TELEMETRY */}\n        {viewMode !== \'dashboard\' && (\n          <section className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch\">\n            {/* Left 7 Columns: 3D Floating Metal Card Stage */}\n            <div\n              ref={cardStageRef}\n              onPointerMove={handleStagePointerMove}\n              onPointerLeave={handleStagePointerLeave}\n              className=\"lg:col-span-7 relative rounded-2xl bg-[#11151E] border border-slate-800/80 p-6 sm:p-10 flex flex-col items-center justify-between min-h-[460px] select-none overflow-hidden\"\n            >\n              {/* Subtle Ambient Stage Illumination */}\n              <div\n                aria-hidden=\"true\"\n                className=\"pointer-events-none absolute -top-28 left-1/2 -translate-x-1/2 w-[480px] h-[260px] rounded-full opacity-25 blur-3xl\"\n                style={{\n                  background:\n                    \'radial-gradient(circle, rgba(251,191,36,0.35) 0%, rgba(56,189,248,0.18) 55%, transparent 80%)\',\n                }}\n              />\n\n              {/* Top Stage Bar */}\n              <div className=\"w-full flex items-center justify-between gap-4 z-10\">\n                <div className=\"text-xs text-slate-400 flex items-center gap-2\">\n                  <span className=\"font-medium text-slate-200\">\n                    {isFlipped ? \'Back Face \302\267 10-Stamp Grid & QR\' : \'Front Face \302\267 Brushed Titanium Emblem\'}\n                  </span>\n                  <span aria-hidden=\"true\">\302\267</span>\n                  <span className=\"font-mono tabular-nums text-slate-400\">\n                    Tilt {tilt.rx.toFixed(1)}\302\260 / {tilt.ry.toFixed(1)}\302\260\n                  </span>\n                </div>\n\n                <button\n                  type=\"button\"\n                  onClick={() => setIsFlipped((prev) => !prev)}\n                  className=\"inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium bg-slate-800/90 hover:bg-slate-700 text-slate-100 border border-slate-700 transition-colors whitespace-nowrap shrink-0 cursor-pointer min-h-[36px]\"\n                >\n                  <RotateCw className=\"w-3.5 h-3.5 text-amber-400\" />\n                  <span>{isFlipped ? \'Flip to Front\' : \'Flip to Back\'}</span>\n                </button>\n              </div>\n\n              {/* Centerpiece: Continuous Floating Wrapper -> DeviceOrientation 3D Tilt -> 3D Flip Card */}\n              <div className=\"my-8 w-full flex items-center justify-center z-10 perspective-stage\">\n                <div className=\"metal-card-floating w-full max-w-[430px]\">\n                  <div\n                    role=\"button\"\n                    tabIndex={0}\n                    aria-label=\"Digital Loyalty Metal Card. Tap or press Enter to flip between brand front and 10-stamp back.\"\n                    onClick={() => setIsFlipped((prev) => !prev)}\n                    onKeyDown={(e) => {\n                      if (e.key === \'Enter\' || e.key === \' \') {\n                        e.preventDefault();\n                        setIsFlipped((prev) => !prev);\n                      }\n                    }}\n                    className=\"card-3d-tilt w-full aspect-[1.586/1] cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-400 rounded-[22px]\"\n                    style={{\n                      transform: `rotateX(${tilt.rx}deg) rotateY(${tilt.ry}deg)`,\n                    }}\n                  >\n                    <div\n                      className={`card-3d-flipper ${isFlipped ? \'is-flipped\' : \'\'}`}\n                    >\n                      {/* ================= CARD FRONT FACE ================= */}\n                      <div className=\"card-face-metal p-6 sm:p-7 flex flex-col justify-between\">\n                        {/* Dynamic Holographic Foil Overlay */}\n                        <div\n                          aria-hidden=\"true\"\n                          className=\"holographic-sheen pointer-events-none absolute inset-0 opacity-75\"\n                        />\n\n                        {/* Dynamic Specular Glare following DeviceOrientation / Pointer */}\n                        <div\n                          aria-hidden=\"true\"\n                          className=\"pointer-events-none absolute inset-0 transition-opacity duration-200\"\n                          style={{\n                            background: `radial-gradient(circle at ${tilt.gx}% ${tilt.gy}%, rgba(255, 255, 255, 0.24) 0%, rgba(251, 191, 36, 0.08) 28%, transparent 62%)`,\n                          }}\n                        />\n\n                        {/* Front Top Row: Milled Serial & Contactless Indicator */}\n                        <div className=\"relative z-10 flex items-center justify-between\">\n                          <div className=\"flex items-center gap-2\">\n                            <div className=\"w-7 h-5 rounded-sm bg-gradient-to-br from-amber-200 via-amber-400 to-amber-700 border border-amber-100/40 shadow-inner flex items-center justify-center\">\n                              <div className=\"w-4 h-3 border border-amber-950/40 rounded-[2px]\" />\n                            </div>\n                            <span className=\"font-mono tabular-nums text-[11px] tracking-widest text-slate-300/90\">\n                              TITANIUM RESERVE\n                            </span>\n                          </div>\n\n                          <span className=\"font-mono tabular-nums text-[11px] text-amber-300/90\">\n                            {activeCustomer.tier}\n                          </span>\n                        </div>\n\n                        {/* Front Center: Minimalist Architectural Brand Logo */}\n                        <div className=\"relative z-10 my-auto flex flex-col items-center justify-center text-center py-2\">\n                          <div className=\"relative w-14 h-14 rounded-full border border-amber-300/50 bg-slate-950/50 flex items-center justify-center shadow-lg\">\n                            <div className=\"w-9 h-9 rounded-full border border-amber-400/80 flex items-center justify-center rotate-45\">\n                              <div className=\"w-3.5 h-3.5 bg-amber-400 rotate-45\" />\n                            </div>\n                          </div>\n                          <div className=\"mt-3 text-xl sm:text-2xl font-bold tracking-[0.26em] text-slate-100 pl-[0.26em]\">\n                            VESPERA\n                          </div>\n                          <div className=\"mt-0.5 text-[11px] tracking-[0.18em] text-slate-400\">\n                            ARCHITECTURAL ROASTERY\n                          </div>\n                        </div>\n\n                        {/* Front Bottom Row: Cardholder Name & Tap Prompt */}\n                        <div className=\"relative z-10 flex items-end justify-between text-xs\">\n                          <div>\n                            <div className=\"text-[10px] text-slate-400\">Cardholder</div>\n                            <div className=\"font-semibold text-slate-100 tracking-wide\">\n                              {activeCustomer.name}\n                            </div>\n                          </div>\n                          <div className=\"text-[11px] text-amber-300/90 font-medium flex items-center gap-1\">\n                            <span>Tap to flip</span>\n                            <RotateCw className=\"w-3 h-3\" />\n                          </div>\n                        </div>\n                      </div>\n\n                      {/* ================= CARD BACK FACE ================= */}\n                      <div className=\"card-face-metal card-face-back p-5 sm:p-6 flex flex-col justify-between\">\n                        {/* Holographic & Specular Layers on Back */}\n                        <div\n                          aria-hidden=\"true\"\n                          className=\"holographic-sheen pointer-events-none absolute inset-0 opacity-65\"\n                        />\n                        <div\n                          aria-hidden=\"true\"\n                          className=\"pointer-events-none absolute inset-0\"\n                          style={{\n                            background: `radial-gradient(circle at ${100 - tilt.gx}% ${tilt.gy}%, rgba(255, 255, 255, 0.2) 0%, transparent 60%)`,\n                          }}\n                        />\n\n                        {/* Back Top Row: Brand Monogram Left + Customer ID / Card Code Top Right */}\n                        <div className=\"relative z-10 flex items-center justify-between gap-2 border-b border-white/10 pb-2.5\">\n                          <div className=\"flex items-center gap-2\">\n                            <div className=\"w-5 h-5 rounded-full border border-amber-400/70 flex items-center justify-center text-[10px] font-bold text-amber-300\">\n                              V\n                            </div>\n                            <span className=\"text-xs font-semibold tracking-wider text-slate-200\">\n                              STAMP LEDGER\n                            </span>\n                          </div>\n\n                          {/* Customer ID / Card Code strictly on Top Right */}\n                          <div className=\"text-right\">\n                            <span className=\"text-[10px] text-slate-400 mr-1.5\">ID</span>\n                            <span className=\"font-mono tabular-nums text-xs font-semibold text-amber-300 tracking-wider\">\n                              {activeCustomer.id}\n                            </span>\n                          </div>\n                        </div>\n\n                        {/* Back Middle: 10-Stamp Grid (5 columns x 2 rows) */}\n                        <div className=\"relative z-10 my-auto py-2\">\n                          <div className=\"grid grid-cols-5 gap-2 sm:gap-2.5\">\n                            {Array.from({ length: 10 }, (_, idx) => {\n                              const stampNumber = idx + 1;\n                              const isStamped =\n                                stampNumber <= activeCustomer.currentStamps;\n                              return (\n                                <button\n                                  key={stampNumber}\n                                  type=\"button\"\n                                  onClick={(e) =>\n                                    setExactStampCount(\n                                      activeCustomer.id,\n                                      stampNumber,\n                                      e\n                                    )\n                                  }\n                                  title={`Toggle Stamp #${stampNumber}`}\n                                  className={`aspect-square rounded-full flex items-center justify-center transition-all duration-200 cursor-pointer ${\n                                    isStamped\n                                      ? \'bg-gradient-to-br from-amber-300 via-amber-400 to-amber-600 text-slate-950 border border-amber-100 shadow-[0_0_15px_rgba(251,191,36,0.45)] scale-100\'\n                                      : \'bg-slate-950/55 text-slate-400 border border-white/15 hover:border-amber-400/50\'\n                                  }`}\n                                >\n                                  {isStamped ? (\n                                    <Sparkles className=\"w-4 h-4 stroke-[2.2]\" />\n                                  ) : (\n                                    <span className=\"font-mono tabular-nums text-[11px]\">\n                                      {String(stampNumber).padStart(2, \'0\')}\n                                    </span>\n                                  )}\n                                </button>\n                              );\n                            })}\n                          </div>\n                        </div>\n\n                        {/* Back Bottom Row: Stamp Status Left + Unique Mock QR Code Right */}\n                        <div className=\"relative z-10 flex items-end justify-between gap-3 pt-1\">\n                          <div className=\"space-y-0.5\">\n                            <div className=\"text-[11px] text-slate-300 font-medium\">\n                              {activeCustomer.currentStamps === 10\n                                ? \'10 / 10 Complete \302\267 Reward Ready\'\n                                : `${activeCustomer.currentStamps} of 10 Stamps Collected`}\n                            </div>\n                            <div className=\"text-[11px] text-slate-400\">\n                              {activeCustomer.currentStamps === 10\n                                ? \'Present QR code to redeem complimentary reserve\'\n                                : `${10 - activeCustomer.currentStamps} more for complimentary reserve roast`}\n                            </div>\n                          </div>\n\n                          {/* Mock Unique QR Code rendered via crisp SVG */}\n                          <div\n                            className=\"bg-white p-1.5 rounded-lg shadow-md shrink-0 border border-slate-200\"\n                            title={`Unique Verification QR for ${activeCustomer.id}`}\n                          >\n                            <svg\n                              viewBox=\"0 0 13 13\"\n                              className=\"w-11 h-11 sm:w-12 sm:h-12 block\"\n                              shapeRendering=\"crispEdges\"\n                              aria-label={`QR Code for ${activeCustomer.id}`}\n                            >\n                              {qrMatrix.map((row, rIdx) =>\n                                row.map((cell, cIdx) =>\n                                  cell ? (\n                                    <rect\n                                      key={`${rIdx}-${cIdx}`}\n                                      x={cIdx}\n                                      y={rIdx}\n                                      width={1}\n                                      height={1}\n                                      fill=\"#0B0D11\"\n                                    />\n                                  ) : null\n                                )\n                              )}\n                            </svg>\n                          </div>\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n              </div>\n\n              {/* Bottom Stage Helper Bar */}\n              <div className=\"w-full flex flex-wrap items-center justify-between gap-3 pt-3 border-t border-slate-800/80 text-xs text-slate-400 z-10\">\n                <span>\n                  Click card surface to flip 3D pass \302\267 Click any circular recess on the back to adjust stamps\n                </span>\n                <span className=\"font-mono tabular-nums text-amber-300\">\n                  {isFlipped ? \'Drawer Active Below \342\206\223\' : \'Flip to Back for Wallet Actions\'}\n                </span>\n              </div>\n            </div>\n\n            {/* Right 5 Columns: Interactive Pass Controls & DeviceOrientation Gyro Simulator */}\n            <div className=\"lg:col-span-5 rounded-2xl bg-[#11151E] border border-slate-800/80 p-6 flex flex-col justify-between space-y-6\">\n              <div className=\"space-y-5\">\n                <div className=\"flex items-center justify-between border-b border-slate-800 pb-4\">\n                  <div>\n                    <h1 className=\"text-lg font-bold text-slate-100\">\n                      Pass Studio & Gyro Controls\n                    </h1>\n                    <p className=\"text-xs text-slate-400 mt-0.5\">\n                      Real-time stamp issuance, member selection, and 3-axis orientation\n                    </p>\n                  </div>\n                  <button\n                    type=\"button\"\n                    onClick={requestGyroPermission}\n                    className=\"inline-flex items-center gap-1.5 px-3 py-2 rounded-lg text-xs font-medium bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 transition-colors cursor-pointer whitespace-nowrap shrink-0\"\n                  >\n                    <Smartphone className=\"w-3.5 h-3.5 text-amber-400\" />\n                    <span>\n                      {gyroStatus === \'active\' ? \'Gyro Linked\' : \'Pair Motion Sensor\'}\n                    </span>\n                  </button>\n                </div>\n\n                {/* Active Member Selector */}\n                <div className=\"space-y-2\">\n                  <label\n                    htmlFor=\"member-select\"\n                    className=\"block text-xs font-medium text-slate-300\"\n                  >\n                    Active Cardholder Profile\n                  </label>\n                  <div className=\"relative\">\n                    <select\n                      id=\"member-select\"\n                      value={selectedCustomerId}\n                      onChange={(e) => setSelectedCustomerId(e.target.value)}\n                      className=\"w-full h-11 pl-3.5 pr-9 rounded-xl bg-slate-900 border border-slate-800 text-sm text-slate-100 focus:outline-none focus:border-amber-400 appearance-none cursor-pointer\"\n                    >\n                      {customers.map((c) => (\n                        <option key={c.id} value={c.id}>\n                          {c.name} \342\200\224 {c.id} ({c.currentStamps}/10 stamps)\n                        </option>\n                      ))}\n                    </select>\n                    <ChevronDown className=\"w-4 h-4 text-slate-400 pointer-events-none absolute right-3.5 top-1/2 -translate-y-1/2\" />\n                  </div>\n                </div>\n\n                {/* Stamp Issuance & Redemption Controls */}\n                <div className=\"space-y-2.5 pt-1\">\n                  <div className=\"flex items-center justify-between text-xs\">\n                    <span className=\"text-slate-300 font-medium\">\n                      Stamp Progress ({activeCustomer.currentStamps} / 10)\n                    </span>\n                    <span className=\"font-mono tabular-nums text-slate-400\">\n                      Lifetime Redeemed: {activeCustomer.totalRedeemedStamps}\n                    </span>\n                  </div>\n\n                  {/* Clean Segmented Progress Bar */}\n                  <div className=\"grid grid-cols-10 gap-1.5 h-2.5\">\n                    {Array.from({ length: 10 }, (_, idx) => (\n                      <div\n                        key={idx}\n                        className={`rounded-sm transition-colors ${\n                          idx < activeCustomer.currentStamps\n                            ? \'bg-amber-400\'\n                            : \'bg-slate-800\'\n                        }`}\n                      />\n                    ))}\n                  </div>\n\n                  <div className=\"grid grid-cols-3 gap-2.5 pt-2\">\n                    <button\n                      type=\"button\"\n                      onClick={() => updateCustomerStamps(activeCustomer.id, -1)}\n                      disabled={activeCustomer.currentStamps <= 0}\n                      className=\"h-11 rounded-xl bg-slate-900 hover:bg-slate-800 disabled:opacity-40 border border-slate-800 text-xs font-medium text-slate-200 flex items-center justify-center gap-1.5 transition-colors cursor-pointer\"\n                    >\n                      <Minus className=\"w-3.5 h-3.5\" />\n                      <span>Remove</span>\n                    </button>\n\n                    <button\n                      type=\"button\"\n                      onClick={() => {\n                        updateCustomerStamps(activeCustomer.id, 1);\n                        if (!isFlipped) setIsFlipped(true);\n                      }}\n                      disabled={activeCustomer.currentStamps >= 10}\n                      className=\"h-11 rounded-xl bg-slate-800 hover:bg-slate-700 disabled:opacity-40 border border-slate-700 text-xs font-semibold text-amber-300 flex items-center justify-center gap-1.5 transition-colors cursor-pointer\"\n                    >\n                      <Plus className=\"w-3.5 h-3.5\" />\n                      <span>Stamp +1</span>\n                    </button>\n\n                    <button\n                      type=\"button\"\n                      onClick={() => redeemCustomerReward(activeCustomer.id)}\n                      className={`h-11 rounded-xl text-xs font-semibold flex items-center justify-center gap-1.5 transition-colors cursor-pointer ${\n                        activeCustomer.currentStamps === 10\n                          ? \'bg-amber-400 hover:bg-amber-300 text-slate-950 shadow-md shadow-amber-500/10\'\n                          : \'bg-slate-900 text-slate-500 border border-slate-800\'\n                      }`}\n                    >\n                      <Award className=\"w-3.5 h-3.5\" />\n                      <span>Redeem 10</span>\n                    </button>\n                  </div>\n                </div>\n\n                {/* DeviceOrientation Tilt Calibration Sliders */}\n                <div className=\"space-y-3 pt-4 border-t border-slate-800\">\n                  <div className=\"flex items-center justify-between\">\n                    <span className=\"text-xs font-medium text-slate-300 flex items-center gap-1.5\">\n                      <Sliders className=\"w-3.5 h-3.5 text-amber-400\" />\n                      <span>DeviceOrientation Tilt Simulator</span>\n                    </span>\n                    <button\n                      type=\"button\"\n                      onClick={() => {\n                        setGyroStatus(\'idle\');\n                        setTilt({ rx: 0, ry: 0, gx: 50, gy: 50 });\n                      }}\n                      className=\"text-xs text-slate-400 hover:text-slate-200 cursor-pointer\"\n                    >\n                      Reset Axis\n                    </button>\n                  </div>\n\n                  <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n                    <div className=\"space-y-1\">\n                      <div className=\"flex justify-between text-[11px] text-slate-400\">\n                        <span>Pitch (Beta X-Axis)</span>\n                        <span className=\"font-mono tabular-nums\">{tilt.rx}\302\260</span>\n                      </div>\n                      <input\n                        type=\"range\"\n                        min={-24}\n                        max={24}\n                        step={1}\n                        value={tilt.rx}\n                        onChange={(e) => {\n                          const rx = Number(e.target.value);\n                          setGyroStatus(\'simulated\');\n                          setTilt((prev) => ({\n                            ...prev,\n                            rx,\n                            gy: Math.round(50 - (rx / 24) * 40),\n                          }));\n                        }}\n                        className=\"w-full accent-amber-400 cursor-pointer\"\n                      />\n                    </div>\n\n                    <div className=\"space-y-1\">\n                      <div className=\"flex justify-between text-[11px] text-slate-400\">\n                        <span>Roll (Gamma Y-Axis)</span>\n                        <span className=\"font-mono tabular-nums\">{tilt.ry}\302\260</span>\n                      </div>\n                      <input\n                        type=\"range\"\n                        min={-24}\n                        max={24}\n                        step={1}\n                        value={tilt.ry}\n                        onChange={(e) => {\n                          const ry = Number(e.target.value);\n                          setGyroStatus(\'simulated\');\n                          setTilt((prev) => ({\n                            ...prev,\n                            ry,\n                            gx: Math.round(50 + (ry / 24) * 40),\n                          }));\n                        }}\n                        className=\"w-full accent-amber-400 cursor-pointer\"\n                      />\n                    </div>\n                  </div>\n                </div>\n              </div>\n\n              {/* Flip Action CTA */}\n              <div className=\"pt-4 border-t border-slate-800 flex items-center justify-between gap-3\">\n                <div className=\"text-xs text-slate-400\">\n                  {isFlipped\n                    ? \'Slide-up wallet menu is active at the bottom of the screen.\'\n                    : \'Flip the card to the back to reveal the slide-up wallet drawer.\'}\n                </div>\n                <button\n                  type=\"button\"\n                  onClick={() => setIsFlipped((prev) => !prev)}\n                  className=\"px-4 py-2.5 rounded-xl bg-slate-100 hover:bg-white text-slate-950 text-xs font-semibold transition-colors whitespace-nowrap shrink-0 cursor-pointer\"\n                >\n                  {isFlipped ? \'Show Front Face\' : \'Flip & Open Drawer\'}\n                </button>\n              </div>\n            </div>\n          </section>\n        )}\n\n        {/* SECTION 2: TOGGLEABLE B2B MERCHANT DASHBOARD */}\n        {viewMode !== \'pass\' && (\n          <section\n            aria-label=\"B2B Merchant Redemption Dashboard\"\n            className=\"rounded-2xl bg-[#11151E] border border-slate-800/80 p-6 sm:p-8 space-y-6\"\n          >\n            {/* Dashboard Header & Summary Metrics */}\n            <div className=\"flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-800 pb-6\">\n              <div>\n                <h2 className=\"text-xl font-bold text-slate-100\">\n                  B2B Customer Stamp & Redemption Directory\n                </h2>\n                <p className=\"text-sm text-slate-400 mt-1\">\n                  Live merchant ledger tracking customer IDs, active pass progress, and cumulative redeemed stamps.\n                </p>\n              </div>\n\n              <div className=\"flex items-center gap-3\">\n                <button\n                  type=\"button\"\n                  onClick={() => setShowAddMemberModal((prev) => !prev)}\n                  className=\"inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl bg-amber-400 hover:bg-amber-300 text-slate-950 text-xs font-semibold transition-colors whitespace-nowrap shrink-0 cursor-pointer\"\n                >\n                  <Plus className=\"w-4 h-4\" />\n                  <span>Register Customer</span>\n                </button>\n              </div>\n            </div>\n\n            {/* Clean Unboxed KPI Strip */}\n            <div className=\"grid grid-cols-2 lg:grid-cols-4 gap-6 py-2 border-b border-slate-800/80 pb-6\">\n              <div>\n                <div className=\"text-xs text-slate-400\">Registered Cardholders</div>\n                <div className=\"text-2xl font-bold font-mono tabular-nums text-slate-100 mt-1\">\n                  {b2bStats.totalMembers}\n                </div>\n              </div>\n              <div>\n                <div className=\"text-xs text-slate-400\">Total Redeemed Stamps</div>\n                <div className=\"text-2xl font-bold font-mono tabular-nums text-amber-400 mt-1\">\n                  {b2bStats.totalRedeemed}\n                </div>\n              </div>\n              <div>\n                <div className=\"text-xs text-slate-400\">Active Unredeemed Stamps</div>\n                <div className=\"text-2xl font-bold font-mono tabular-nums text-slate-100 mt-1\">\n                  {b2bStats.activeStamps}\n                </div>\n              </div>\n              <div>\n                <div className=\"text-xs text-slate-400\">Rewards Ready (10/10)</div>\n                <div className=\"text-2xl font-bold font-mono tabular-nums text-emerald-400 mt-1\">\n                  {b2bStats.readyCount}\n                </div>\n              </div>\n            </div>\n\n            {/* Optional Inline New Member Registration Drawer */}\n            {showAddMemberModal && (\n              <form\n                onSubmit={handleAddMember}\n                className=\"p-4 rounded-xl bg-slate-900/90 border border-slate-800 flex flex-col sm:flex-row items-stretch sm:items-end gap-3\"\n              >\n                <div className=\"flex-1 space-y-1\">\n                  <label className=\"block text-xs text-slate-400\">\n                    Customer Full Name\n                  </label>\n                  <input\n                    type=\"text\"\n                    required\n                    placeholder=\"e.g. Camille Laurent\"\n                    value={newMemberName}\n                    onChange={(e) => setNewMemberName(e.target.value)}\n                    className=\"w-full h-10 px-3 rounded-lg bg-slate-950 border border-slate-800 text-sm text-slate-100 focus:outline-none focus:border-amber-400\"\n                  />\n                </div>\n                <div className=\"flex-1 space-y-1\">\n                  <label className=\"block text-xs text-slate-400\">\n                    Customer Email (for Backup)\n                  </label>\n                  <input\n                    type=\"email\"\n                    placeholder=\"camille@atelier.fr\"\n                    value={newMemberEmail}\n                    onChange={(e) => setNewMemberEmail(e.target.value)}\n                    className=\"w-full h-10 px-3 rounded-lg bg-slate-950 border border-slate-800 text-sm text-slate-100 focus:outline-none focus:border-amber-400\"\n                  />\n                </div>\n                <div className=\"flex items-center gap-2\">\n                  <button\n                    type=\"submit\"\n                    className=\"h-10 px-4 rounded-lg bg-amber-400 hover:bg-amber-300 text-slate-950 text-xs font-semibold cursor-pointer whitespace-nowrap\"\n                  >\n                    Create Pass\n                  </button>\n                  <button\n                    type=\"button\"\n                    onClick={() => setShowAddMemberModal(false)}\n                    className=\"h-10 px-3 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs cursor-pointer\"\n                  >\n                    Cancel\n                  </button>\n                </div>\n              </form>\n            )}\n\n            {/* Search & Filter Controls */}\n            <div className=\"flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4\">\n              <div className=\"relative flex-1 max-w-md\">\n                <Search className=\"w-4 h-4 text-slate-500 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none\" />\n                <input\n                  type=\"search\"\n                  value={searchQuery}\n                  onChange={(e) => setSearchQuery(e.target.value)}\n                  placeholder=\"Search by customer name, ID (VSP-...), or email...\"\n                  className=\"w-full h-10 pl-10 pr-4 rounded-xl bg-slate-900 border border-slate-800 text-sm text-slate-100 placeholder:text-slate-500 focus:outline-none focus:border-amber-400\"\n                />\n              </div>\n\n              <div className=\"flex items-center gap-1 p-1 bg-slate-900 border border-slate-800 rounded-lg self-start\">\n                <button\n                  type=\"button\"\n                  onClick={() => setTableFilter(\'all\')}\n                  className={`px-3 py-1.5 text-xs font-medium rounded-md transition-colors whitespace-nowrap shrink-0 cursor-pointer ${\n                    tableFilter === \'all\'\n                      ? \'bg-slate-800 text-slate-100\'\n                      : \'text-slate-400 hover:text-slate-200\'\n                  }`}\n                >\n                  All Customers\n                </button>\n                <button\n                  type=\"button\"\n                  onClick={() => setTableFilter(\'ready\')}\n                  className={`px-3 py-1.5 text-xs font-medium rounded-md transition-colors whitespace-nowrap shrink-0 cursor-pointer ${\n                    tableFilter === \'ready\'\n                      ? \'bg-slate-800 text-slate-100\'\n                      : \'text-slate-400 hover:text-slate-200\'\n                  }`}\n                >\n                  Reward Ready (10/10)\n                </button>\n                <button\n                  type=\"button\"\n                  onClick={() => setTableFilter(\'vip\')}\n                  className={`px-3 py-1.5 text-xs font-medium rounded-md transition-colors whitespace-nowrap shrink-0 cursor-pointer ${\n                    tableFilter === \'vip\'\n                      ? \'bg-slate-800 text-slate-100\'\n                      : \'text-slate-400 hover:text-slate-200\'\n                  }`}\n                >\n                  40+ Redeemed\n                </button>\n              </div>\n            </div>\n\n            {/* B2B Customer Data Table */}\n            <div className=\"overflow-x-auto border border-slate-800 rounded-xl\">\n              <table className=\"w-full text-left border-collapse\">\n                <thead>\n                  <tr className=\"border-b border-slate-800 bg-slate-900/70 text-[12px] font-semibold text-slate-400\">\n                    <th className=\"py-3.5 px-4\">Customer Name</th>\n                    <th className=\"py-3.5 px-4\">Customer ID</th>\n                    <th className=\"py-3.5 px-4\">Active Card Grid</th>\n                    <th className=\"py-3.5 px-4 text-right\">Total Redeemed Stamps</th>\n                    <th className=\"py-3.5 px-4 text-right\">Merchant Actions</th>\n                  </tr>\n                </thead>\n                <tbody className=\"divide-y divide-slate-800/70 text-sm\">\n                  {filteredCustomers.length === 0 ? (\n                    <tr>\n                      <td\n                        colSpan={5}\n                        className=\"py-10 text-center text-slate-400 text-sm\"\n                      >\n                        No customer records match &ldquo;{searchQuery}&rdquo;.\n                      </td>\n                    </tr>\n                  ) : (\n                    filteredCustomers.map((customer) => {\n                      const isSelected = customer.id === activeCustomer.id;\n                      return (\n                        <tr\n                          key={customer.id}\n                          onClick={() => setSelectedCustomerId(customer.id)}\n                          className={`transition-colors cursor-pointer ${\n                            isSelected\n                              ? \'bg-amber-400/[0.06] hover:bg-amber-400/[0.09]\'\n                              : \'hover:bg-slate-900/60\'\n                          }`}\n                        >\n                          <td className=\"py-3.5 px-4\">\n                            <div className=\"font-semibold text-slate-100 flex items-center gap-2\">\n                              <span>{customer.name}</span>\n                              {isSelected && (\n                                <span className=\"text-[11px] font-normal text-amber-300\">\n                                  \302\267 Active on 3D Card\n                                </span>\n                              )}\n                            </div>\n                            <div className=\"text-xs text-slate-400\">\n                              {customer.email} \302\267 {customer.tier}\n                            </div>\n                          </td>\n\n                          <td className=\"py-3.5 px-4 font-mono tabular-nums text-xs text-slate-200\">\n                            {customer.id}\n                          </td>\n\n                          <td className=\"py-3.5 px-4\">\n                            <div className=\"flex items-center gap-2.5\">\n                              <span className=\"font-mono tabular-nums text-xs text-slate-300 w-12\">\n                                {customer.currentStamps} / 10\n                              </span>\n                              <div className=\"w-24 h-2 rounded-full bg-slate-800 overflow-hidden\">\n                                <div\n                                  className={`h-full transition-all ${\n                                    customer.currentStamps === 10\n                                      ? \'bg-emerald-400\'\n                                      : \'bg-amber-400\'\n                                  }`}\n                                  style={{\n                                    width: `${customer.currentStamps * 10}%`,\n                                  }}\n                                />\n                              </div>\n                            </div>\n                          </td>\n\n                          <td className=\"py-3.5 px-4 text-right font-mono tabular-nums font-semibold text-slate-100\">\n                            {customer.totalRedeemedStamps}\n                          </td>\n\n                          <td\n                            className=\"py-3.5 px-4 text-right\"\n                            onClick={(e) => e.stopPropagation()}\n                          >\n                            <div className=\"inline-flex items-center justify-end gap-2\">\n                              <button\n                                type=\"button\"\n                                onClick={() =>\n                                  updateCustomerStamps(customer.id, 1)\n                                }\n                                disabled={customer.currentStamps >= 10}\n                                className=\"px-2.5 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 disabled:opacity-40 text-xs font-medium text-slate-200 transition-colors cursor-pointer whitespace-nowrap\"\n                              >\n                                +1 Stamp\n                              </button>\n                              <button\n                                type=\"button\"\n                                onClick={() =>\n                                  redeemCustomerReward(customer.id)\n                                }\n                                disabled={customer.currentStamps < 10}\n                                className={`px-2.5 py-1.5 rounded-lg text-xs font-semibold transition-colors cursor-pointer whitespace-nowrap ${\n                                  customer.currentStamps === 10\n                                    ? \'bg-amber-400 hover:bg-amber-300 text-slate-950\'\n                                    : \'bg-slate-900 text-slate-500 border border-slate-800 opacity-50\'\n                                }`}\n                              >\n                                Redeem 10\n                              </button>\n                            </div>\n                          </td>\n                        </tr>\n                      );\n                    })\n                  )}\n                </tbody>\n              </table>\n            </div>\n          </section>\n        )}\n      </main>\n\n      {/* =====================================================================\n          SLIDE-UP ACTION MENU DRAWER\n          Strictly triggered when the card flips to the back (isFlipped === true)\n      ===================================================================== */}\n      <aside\n        aria-label=\"Wallet and Backup Slide-Up Action Menu\"\n        aria-hidden={!isFlipped}\n        className={`fixed left-0 right-0 bottom-0 z-40 transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] ${\n          isFlipped\n            ? \'translate-y-0 pointer-events-auto\'\n            : \'translate-y-full pointer-events-none\'\n        }`}\n      >\n        <div className=\"max-w-3xl mx-auto px-4\">\n          <div className=\"rounded-t-3xl bg-[#141923]/95 backdrop-blur-xl border-t border-x border-slate-700/80 shadow-[0_-20px_50px_rgba(0,0,0,0.75)] px-6 pt-3 pb-6\">\n            {/* Drag Handle Affordance */}\n            <div className=\"w-10 h-1.5 bg-slate-600 rounded-full mx-auto mb-3\" />\n\n            <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-4\">\n              <div className=\"flex items-center gap-2 text-xs text-slate-300\">\n                <span className=\"font-semibold text-white\">\n                  Pass Provisioning & Backup\n                </span>\n                <span aria-hidden=\"true\">\302\267</span>\n                <span className=\"font-mono tabular-nums text-amber-300\">\n                  {activeCustomer.id}\n                </span>\n                <span aria-hidden=\"true\">\302\267</span>\n                <span className=\"text-slate-400\">\n                  {activeCustomer.currentStamps}/10 Stamps\n                </span>\n              </div>\n\n              <button\n                type=\"button\"\n                onClick={() => setIsFlipped(false)}\n                className=\"text-xs text-slate-400 hover:text-slate-200 self-end sm:self-auto cursor-pointer\"\n              >\n                Flip to Front to Dismiss\n              </button>\n            </div>\n\n            {/* 3 Required Action Buttons: Add to Apple Wallet, Google Wallet, Email Backup */}\n            <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-3\">\n              <button\n                type=\"button\"\n                onClick={() => setWalletModal({ type: \'apple\' })}\n                className=\"min-h-[48px] px-4 py-3 rounded-xl bg-slate-950 hover:bg-slate-900 text-white border border-slate-700/90 flex items-center justify-center gap-2.5 text-xs font-semibold transition-all active:scale-[0.99] cursor-pointer whitespace-nowrap\"\n              >\n                <Wallet className=\"w-4 h-4 text-amber-400 shrink-0\" />\n                <span>Add to Apple Wallet</span>\n              </button>\n\n              <button\n                type=\"button\"\n                onClick={() => setWalletModal({ type: \'google\' })}\n                className=\"min-h-[48px] px-4 py-3 rounded-xl bg-slate-950 hover:bg-slate-900 text-white border border-slate-700/90 flex items-center justify-center gap-2.5 text-xs font-semibold transition-all active:scale-[0.99] cursor-pointer whitespace-nowrap\"\n              >\n                <CreditCard className=\"w-4 h-4 text-sky-400 shrink-0\" />\n                <span>Google Wallet</span>\n              </button>\n\n              <button\n                type=\"button\"\n                onClick={() =>\n                  setWalletModal({\n                    type: \'email\',\n                    emailInput: activeCustomer.email,\n                    dispatched: false,\n                  })\n                }\n                className=\"min-h-[48px] px-4 py-3 rounded-xl bg-amber-400 hover:bg-amber-300 text-slate-950 flex items-center justify-center gap-2.5 text-xs font-semibold transition-all active:scale-[0.99] cursor-pointer whitespace-nowrap\"\n              >\n                <Mail className=\"w-4 h-4 shrink-0\" />\n                <span>Email Backup</span>\n              </button>\n            </div>\n          </div>\n        </div>\n      </aside>\n\n      {/* =====================================================================\n          INTERACTIVE MODAL FOR WALLET PASS / EMAIL BACKUP ACTIONS\n      ===================================================================== */}\n      {walletModal.type && (\n        <div\n          role=\"dialog\"\n          aria-modal=\"true\"\n          className=\"fixed inset-0 z-50 bg-black/70 backdrop-blur-xs flex items-center justify-center p-4\"\n          onClick={() => setWalletModal({ type: null })}\n        >\n          <div\n            className=\"w-full max-w-md rounded-2xl bg-[#141923] border border-slate-700 p-6 space-y-5 shadow-2xl\"\n            onClick={(e) => e.stopPropagation()}\n          >\n            <div className=\"flex items-center justify-between border-b border-slate-800 pb-3\">\n              <h3 className=\"text-base font-bold text-slate-100\">\n                {walletModal.type === \'apple\' && \'Apple Wallet Pass (.pkpass)\'}\n                {walletModal.type === \'google\' && \'Google Wallet Smart Tap Pass\'}\n                {walletModal.type === \'email\' && \'Encrypted Pass Email Backup\'}\n              </h3>\n              <button\n                type=\"button\"\n                onClick={() => setWalletModal({ type: null })}\n                className=\"p-1 text-slate-400 hover:text-white rounded-lg cursor-pointer\"\n              >\n                <X className=\"w-4 h-4\" />\n              </button>\n            </div>\n\n            {walletModal.type !== \'email\' ? (\n              <div className=\"space-y-4\">\n                <div className=\"p-4 rounded-xl bg-slate-900 border border-slate-800 space-y-2 text-xs\">\n                  <div className=\"flex justify-between\">\n                    <span className=\"text-slate-400\">Pass Organization</span>\n                    <span className=\"text-slate-100 font-medium\">Vespera Atelier</span>\n                  </div>\n                  <div className=\"flex justify-between\">\n                    <span className=\"text-slate-400\">Cardholder</span>\n                    <span className=\"text-slate-100 font-medium\">\n                      {activeCustomer.name}\n                    </span>\n                  </div>\n                  <div className=\"flex justify-between\">\n                    <span className=\"text-slate-400\">Customer Card Code</span>\n                    <span className=\"font-mono tabular-nums text-amber-300\">\n                      {activeCustomer.id}\n                    </span>\n                  </div>\n                  <div className=\"flex justify-between\">\n                    <span className=\"text-slate-400\">Synced Balance</span>\n                    <span className=\"font-mono tabular-nums text-slate-200\">\n                      {activeCustomer.currentStamps} / 10 Stamps\n                    </span>\n                  </div>\n                </div>\n\n                <div className=\"flex items-center justify-end gap-2\">\n                  <button\n                    type=\"button\"\n                    onClick={() => setWalletModal({ type: null })}\n                    className=\"px-4 py-2 rounded-lg bg-slate-800 text-xs text-slate-300 hover:bg-slate-700 cursor-pointer\"\n                  >\n                    Close\n                  </button>\n                  <button\n                    type=\"button\"\n                    onClick={() => {\n                      const label =\n                        walletModal.type === \'apple\'\n                          ? \'Apple Wallet\'\n                          : \'Google Wallet\';\n                      setWalletModal({ type: null });\n                      triggerToast(\n                        `Synced pass ${activeCustomer.id} to ${label}`\n                      );\n                    }}\n                    className=\"px-4 py-2 rounded-lg bg-amber-400 hover:bg-amber-300 text-slate-950 text-xs font-semibold cursor-pointer\"\n                  >\n                    Confirm & Install Pass\n                  </button>\n                </div>\n              </div>\n            ) : (\n              <form\n                onSubmit={(e) => {\n                  e.preventDefault();\n                  const targetEmail =\n                    walletModal.emailInput || activeCustomer.email;\n                  setWalletModal({ type: null });\n                  triggerToast(\n                    `Backup pass (${activeCustomer.id}) sent to ${targetEmail}`\n                  );\n                }}\n                className=\"space-y-4\"\n              >\n                <p className=\"text-xs text-slate-300 leading-relaxed\">\n                  Send a\346\201\242\345\244\215/recovery link containing your unique QR code and stamp balance (\n                  <span className=\"font-mono tabular-nums text-amber-300\">\n                    {activeCustomer.id}\n                  </span>\n                  ) to your email address:\n                </p>\n                <div>\n                  <label className=\"block text-xs text-slate-400 mb-1\">\n                    Recipient Email\n                  </label>\n                  <input\n                    type=\"email\"\n                    required\n                    value={walletModal.emailInput ?? activeCustomer.email}\n                    onChange={(e) =>\n                      setWalletModal((prev) => ({\n                        ...prev,\n                        emailInput: e.target.value,\n                      }))\n                    }\n                    className=\"w-full h-10 px-3 rounded-lg bg-slate-950 border border-slate-800 text-sm text-slate-100 focus:outline-none focus:border-amber-400\"\n                  />\n                </div>\n                <div className=\"flex items-center justify-end gap-2\">\n                  <button\n                    type=\"button\"\n                    onClick={() => setWalletModal({ type: null })}\n                    className=\"px-4 py-2 rounded-lg bg-slate-800 text-xs text-slate-300 hover:bg-slate-700 cursor-pointer\"\n                  >\n                    Cancel\n                  </button>\n                  <button\n                    type=\"submit\"\n                    className=\"px-4 py-2 rounded-lg bg-amber-400 hover:bg-amber-300 text-slate-950 text-xs font-semibold cursor-pointer\"\n                  >\n                    Send Recovery Pass\n                  </button>\n                </div>\n              </form>\n            )}\n          </div>\n        </div>\n      )}\n\n      {/* Toast Feedback Banner */}\n      {toastMessage && (\n        <div\n          role=\"status\"\n          className=\"fixed top-16 right-6 z-50 flex items-center gap-2.5 px-4 py-3 rounded-xl bg-slate-900/95 border border-amber-400/40 text-xs font-medium text-slate-100 shadow-xl backdrop-blur-md\"\n        >\n          <Check className=\"w-4 h-4 text-amber-400 shrink-0\" />\n          <span>{toastMessage}</span>\n        </div>\n      )}\n    </div>\n  );\n}\n"
        path {
          absolute_uri: "file:///app/page.tsx"
        }
        overwrite: true
      }
    }
