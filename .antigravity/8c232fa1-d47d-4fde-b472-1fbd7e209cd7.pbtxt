      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Refactor visual styling and CSS theme of app/page.tsx to match Apple Cupertino Dark Mode & Bento Grid aesthetic while keeping all features, state logic, and 3D Sissi loyalty card artwork untouched.\", \"EndLine\":2076, \"Instruction\":\"Update the visual classes in app/page.tsx from line 838 to 2076 to apply the Apple Cupertino Dark Mode & Bento Grid design tokens.\", \"ReplacementContent\":\"  return (\\n    <div\\n      className=\\\"min-h-screen bg-[#000000] text-[#F5F5F7] antialiased flex flex-col relative overflow-x-hidden\\\"\\n      style={{\\n        fontFamily:\\n          \'-apple-system, BlinkMacSystemFont, \\\"SF Pro Display\\\", \\\"SF Pro Text\\\", \\\"Inter\\\", sans-serif\',\\n        WebkitFontSmoothing: \'antialiased\',\\n      }}\\n    >\\n      {/* Embedded Keyframes, 3D Backface-Visibility & Holographic Overlay Styles */}\\n      <style>{`\\n        @keyframes floatCardContinuous {\\n          0%, 100% {\\n            transform: translate3d(0, 0px, 0) rotateZ(0deg);\\n          }\\n          50% {\\n            transform: translate3d(0, -12px, 0) rotateZ(0.3deg);\\n          }\\n        }\\n        @keyframes holoShimmer {\\n          0%, 100% {\\n            background-position: 0% 50%;\\n          }\\n          50% {\\n            background-position: 100% 50%;\\n          }\\n        }\\n        .metal-card-floating {\\n          animation: floatCardContinuous 5.6s cubic-bezier(0.45, 0.05, 0.55, 0.95) infinite;\\n          will-change: transform;\\n        }\\n        .perspective-stage {\\n          perspective: 1400px;\\n          -webkit-perspective: 1400px;\\n        }\\n        .card-3d-tilt {\\n          transform-style: preserve-3d;\\n          -webkit-transform-style: preserve-3d;\\n          transition: transform 140ms cubic-bezier(0.16, 1, 0.3, 1);\\n          will-change: transform;\\n        }\\n        .card-3d-flipper {\\n          position: relative;\\n          width: 100%;\\n          height: 100%;\\n          transform-style: preserve-3d;\\n          -webkit-transform-style: preserve-3d;\\n          transition: transform 740ms cubic-bezier(0.22, 1, 0.36, 1);\\n          will-change: transform;\\n        }\\n        .card-3d-flipper.is-flipped {\\n          transform: rotateY(180deg);\\n          -webkit-transform: rotateY(180deg);\\n        }\\n        .card-face-plane {\\n          position: absolute;\\n          inset: 0;\\n          width: 100%;\\n          height: 100%;\\n          backface-visibility: hidden;\\n          -webkit-backface-visibility: hidden;\\n          border-radius: 20px;\\n        }\\n        .card-face-front-plane {\\n          transform: rotateY(0deg) translateZ(2px);\\n          -webkit-transform: rotateY(0deg) translateZ(2px);\\n          z-index: 2;\\n        }\\n        .card-face-back-plane {\\n          transform: rotateY(180deg) translateZ(2px);\\n          -webkit-transform: rotateY(180deg) translateZ(2px);\\n          z-index: 1;\\n        }\\n        .card-surface-shell {\\n          position: relative;\\n          width: 100%;\\n          height: 100%;\\n          border-radius: 20px;\\n          overflow: hidden;\\n          box-shadow:\\n            0 30px 65px -15px rgba(0, 0, 0, 0.85),\\n            0 0 0 1px rgba(255, 255, 255, 0.22),\\n            inset 0 1px 1px rgba(255, 255, 255, 0.35);\\n        }\\n        .holographic-sheen {\\n          background: linear-gradient(\\n            125deg,\\n            transparent 16%,\\n            rgba(255, 210, 130, 0.22) 32%,\\n            rgba(130, 240, 220, 0.18) 44%,\\n            rgba(180, 160, 255, 0.18) 55%,\\n            rgba(255, 160, 200, 0.18) 66%,\\n            transparent 82%\\n          );\\n          background-size: 220% 220%;\\n          animation: holoShimmer 6.5s ease-in-out infinite;\\n          mix-blend-mode: soft-light;\\n        }\\n        @media (prefers-reduced-motion: reduce) {\\n          .metal-card-floating,\\n          .holographic-sheen {\\n            animation: none !important;\\n          }\\n        }\\n      `}</style>\\n\\n      {/* Apple Ultra-Minimalist Top Navigation Bar */}\\n      <header\\n        className=\\\"sticky top-0 z-50 flex items-center justify-between gap-8 px-6 lg:px-10 h-11 border-b border-white/[0.08]\\\"\\n        style={{\\n          backgroundColor: \'rgba(0, 0, 0, 0.78)\',\\n          backdropFilter: \'saturate(180%) blur(20px)\',\\n          WebkitBackdropFilter: \'saturate(180%) blur(20px)\',\\n        }}\\n      >\\n        <a\\n          href=\\\"#top\\\"\\n          className=\\\"text-[14px] font-semibold tracking-[-0.025em] leading-[1.06] text-[#F5F5F7] whitespace-nowrap shrink-0\\\"\\n        >\\n          Sissi Heritage\\n        </a>\\n\\n        <nav className=\\\"hidden md:flex items-center gap-7\\\">\\n          <button\\n            type=\\\"button\\\"\\n            onClick={() => {\\n              setViewMode(\'split\');\\n              setIsFlipped(false);\\n            }}\\n            className=\\\"text-[12px] font-normal tracking-[-0.01em] text-[#F5F5F7]/80 hover:text-white transition-colors whitespace-nowrap shrink-0 cursor-pointer\\\"\\n          >\\n            {t.navFront}\\n          </button>\\n          <button\\n            type=\\\"button\\\"\\n            onClick={() => {\\n              setViewMode(\'split\');\\n              setIsFlipped(true);\\n            }}\\n            className=\\\"text-[12px] font-normal tracking-[-0.01em] text-[#F5F5F7]/80 hover:text-white transition-colors whitespace-nowrap shrink-0 cursor-pointer\\\"\\n          >\\n            {t.navGrid}\\n          </button>\\n          <button\\n            type=\\\"button\\\"\\n            onClick={() => {\\n              setIsFlipped(true);\\n              handleAddToHomeScreenClick();\\n            }}\\n            className=\\\"text-[12px] font-normal tracking-[-0.01em] text-[#F5F5F7]/80 hover:text-white transition-colors whitespace-nowrap shrink-0 cursor-pointer\\\"\\n          >\\n            {t.navPwa}\\n          </button>\\n          <button\\n            type=\\\"button\\\"\\n            onClick={() =>\\n              setViewMode((prev) =>\\n                prev === \'dashboard\' ? \'split\' : \'dashboard\'\\n              )\\n            }\\n            className=\\\"text-[12px] font-normal tracking-[-0.01em] text-[#F5F5F7]/80 hover:text-white transition-colors whitespace-nowrap shrink-0 cursor-pointer\\\"\\n          >\\n            {t.navB2B}\\n          </button>\\n        </nav>\\n\\n        <div className=\\\"flex items-center gap-3 shrink-0\\\">\\n          <button\\n            type=\\\"button\\\"\\n            onClick={() => updateCustomerStamps(activeCustomer.id, 1)}\\n            className=\\\"bg-[#0071E3] hover:bg-[#0077ED] text-white text-[13px] font-normal tracking-[-0.01em] px-[18px] py-[6px] rounded-full transition-all whitespace-nowrap shrink-0 cursor-pointer\\\"\\n          >\\n            {t.ctaIssueStamp}\\n          </button>\\n        </div>\\n      </header>\\n\\n      {/* Workspace Control Bar (Below the Top Bar) */}\\n      <div className=\\\"border-b border-white/[0.06] bg-[#000000]\\\">\\n        <div className=\\\"max-w-7xl mx-auto px-6 lg:px-10 py-3.5 flex flex-wrap items-center justify-between gap-4\\\">\\n          {/* Clean Unboxed Metadata showing Anonymous LocalStorage Status */}\\n          <div className=\\\"flex flex-wrap items-center gap-2 text-xs text-[#86868B]\\\">\\n            <span className=\\\"text-[#F5F5F7] font-medium\\\">\\n              {activeDisplayName}\\n            </span>\\n            <span aria-hidden=\\\"true\\\">\302\267</span>\\n            <span className=\\\"font-mono tabular-nums text-[#2997FF] font-semibold\\\">\\n              {activeCustomer.id}\\n            </span>\\n            <span aria-hidden=\\\"true\\\">\302\267</span>\\n            <span className=\\\"font-mono tabular-nums text-[#F5F5F7]/90\\\">\\n              {activeCustomer.currentStamps} / {MAX_STAMPS} {t.stampsActive}\\n            </span>\\n            {activeCustomer.isLocalDevice && (\\n              <>\\n                <span aria-hidden=\\\"true\\\">\302\267</span>\\n                <span className=\\\"text-emerald-400\\\">\\n                  {t.localSavedBadge}\\n                </span>\\n              </>\\n            )}\\n          </div>\\n\\n          {/* Interactive Language Selector, Workspace Mode Toggles & Single-File HTML Export */}\\n          <div className=\\\"flex flex-wrap items-center gap-2\\\">\\n            <div\\n              role=\\\"group\\\"\\n              aria-label=\\\"Pilihan Bahasa / Language Selector\\\"\\n              className=\\\"flex items-center gap-1.5\\\"\\n            >\\n              <Globe className=\\\"w-3.5 h-3.5 text-[#86868B] mr-0.5 shrink-0\\\" />\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => {\\n                  setLang(\'id\');\\n                  triggerToast(TRANSLATIONS.id.toastLangChanged);\\n                }}\\n                className={`bg-[#161618] hover:bg-[#2C2C2E] border text-[13px] px-[16px] py-[7px] rounded-full transition-all whitespace-nowrap shrink-0 cursor-pointer ${\\n                  lang === \'id\'\\n                    ? \'border-[#2997FF] text-[#2997FF]\'\\n                    : \'border-white/[0.08] text-[#F5F5F7]\'\\n                }`}\\n              >\\n                ID \302\267 Indonesia\\n              </button>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => {\\n                  setLang(\'en\');\\n                  triggerToast(TRANSLATIONS.en.toastLangChanged);\\n                }}\\n                className={`bg-[#161618] hover:bg-[#2C2C2E] border text-[13px] px-[16px] py-[7px] rounded-full transition-all whitespace-nowrap shrink-0 cursor-pointer ${\\n                  lang === \'en\'\\n                    ? \'border-[#2997FF] text-[#2997FF]\'\\n                    : \'border-white/[0.08] text-[#F5F5F7]\'\\n                }`}\\n              >\\n                EN \302\267 English\\n              </button>\\n            </div>\\n\\n            <div\\n              role=\\\"group\\\"\\n              aria-label=\\\"Workspace View Mode\\\"\\n              className=\\\"flex items-center gap-1.5\\\"\\n            >\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => setViewMode(\'split\')}\\n                className={`bg-[#161618] hover:bg-[#2C2C2E] border text-[13px] px-[16px] py-[7px] rounded-full transition-all whitespace-nowrap shrink-0 cursor-pointer ${\\n                  viewMode === \'split\'\\n                    ? \'border-[#2997FF] text-[#2997FF]\'\\n                    : \'border-white/[0.08] text-[#F5F5F7]\'\\n                }`}\\n              >\\n                {t.modeSplit}\\n              </button>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => setViewMode(\'pass\')}\\n                className={`bg-[#161618] hover:bg-[#2C2C2E] border text-[13px] px-[16px] py-[7px] rounded-full transition-all whitespace-nowrap shrink-0 cursor-pointer ${\\n                  viewMode === \'pass\'\\n                    ? \'border-[#2997FF] text-[#2997FF]\'\\n                    : \'border-white/[0.08] text-[#F5F5F7]\'\\n                }`}\\n              >\\n                {t.modePass}\\n              </button>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => setViewMode(\'dashboard\')}\\n                className={`bg-[#161618] hover:bg-[#2C2C2E] border text-[13px] px-[16px] py-[7px] rounded-full transition-all whitespace-nowrap shrink-0 cursor-pointer ${\\n                  viewMode === \'dashboard\'\\n                    ? \'border-[#2997FF] text-[#2997FF]\'\\n                    : \'border-white/[0.08] text-[#F5F5F7]\'\\n                }`}\\n              >\\n                {t.modeDashboard}\\n              </button>\\n            </div>\\n\\n            <button\\n              type=\\\"button\\\"\\n              onClick={handleDownloadSingleFileHtml}\\n              className=\\\"hidden sm:inline-flex items-center gap-1.5 bg-[#161618] hover:bg-[#2C2C2E] text-[#F5F5F7] border border-white/[0.08] text-[13px] px-[16px] py-[7px] rounded-full transition-all whitespace-nowrap shrink-0 cursor-pointer\\\"\\n              title={t.exportHtml}\\n            >\\n              <Download className=\\\"w-3.5 h-3.5 text-[#2997FF]\\\" />\\n              <span>{t.exportHtml}</span>\\n            </button>\\n          </div>\\n        </div>\\n      </div>\\n\\n      {/* Main Content Container */}\\n      <main\\n        id=\\\"top\\\"\\n        className=\\\"flex-1 max-w-7xl w-full mx-auto px-6 lg:px-10 py-8 pb-44 space-y-12\\\"\\n      >\\n        {/* SECTION 1: 3D CUSTOM DESIGN LOYALTY CARD & INTERACTIVE TELEMETRY */}\\n        {viewMode !== \'dashboard\' && (\\n          <section className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch\\\">\\n            {/* Left 7 Columns: 3D Floating Card Stage */}\\n            <div\\n              ref={cardStageRef}\\n              onPointerMove={handleStagePointerMove}\\n              onPointerLeave={handleStagePointerLeave}\\n              className=\\\"lg:col-span-7 relative bg-[#161618] rounded-[24px] p-6 sm:p-10 border border-white/[0.06] shadow-2xl flex flex-col items-center justify-between min-h-[460px] select-none overflow-hidden\\\"\\n            >\\n              {/* Subtle Ambient Stage Illumination */}\\n              <div\\n                aria-hidden=\\\"true\\\"\\n                className=\\\"pointer-events-none absolute -top-28 left-1/2 -translate-x-1/2 w-[480px] h-[260px] rounded-full opacity-25 blur-3xl\\\"\\n                style={{\\n                  background:\\n                    \'radial-gradient(circle, rgba(239,229,209,0.28) 0%, rgba(74,73,40,0.28) 55%, transparent 80%)\',\\n                }}\\n              />\\n\\n              {/* Top Stage Bar */}\\n              <div className=\\\"w-full flex items-center justify-between gap-4 z-10\\\">\\n                <div className=\\\"text-xs text-[#86868B] flex items-center gap-2\\\">\\n                  <span className=\\\"font-medium text-[#F5F5F7]\\\">\\n                    {isFlipped ? t.stageBackLabel : t.stageFrontLabel}\\n                  </span>\\n                  <span aria-hidden=\\\"true\\\">\302\267</span>\\n                  <span className=\\\"font-mono tabular-nums text-[#86868B]\\\">\\n                    {t.tiltLabel} {tilt.rx.toFixed(1)}\302\260 / {tilt.ry.toFixed(1)}\302\260\\n                  </span>\\n                </div>\\n\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => setIsFlipped((prev) => !prev)}\\n                  className=\\\"inline-flex items-center gap-1.5 bg-[#161618] hover:bg-[#2C2C2E] text-[#F5F5F7] border border-white/[0.08] text-[13px] px-[16px] py-[7px] rounded-full transition-all whitespace-nowrap shrink-0 cursor-pointer\\\"\\n                >\\n                  <RotateCw className=\\\"w-3.5 h-3.5 text-[#2997FF]\\\" />\\n                  <span>{isFlipped ? t.flipToFront : t.flipToBack}</span>\\n                </button>\\n              </div>\\n\\n              {/* Centerpiece: Continuous Floating Wrapper -> DeviceOrientation 3D Tilt -> 3D Flip Card */}\\n              <div className=\\\"my-8 w-full flex items-center justify-center z-10 perspective-stage\\\">\\n                <div className=\\\"metal-card-floating w-full max-w-[480px]\\\">\\n                  <div\\n                    role=\\\"button\\\"\\n                    tabIndex={0}\\n                    aria-label={t.cardAriaLabel}\\n                    onClick={() => setIsFlipped((prev) => !prev)}\\n                    onKeyDown={(e) => {\\n                      if (e.key === \'Enter\' || e.key === \' \') {\\n                        e.preventDefault();\\n                        setIsFlipped((prev) => !prev);\\n                      }\\n                    }}\\n                    className=\\\"card-3d-tilt w-full aspect-[2769/1742] cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0071E3] rounded-[20px]\\\"\\n                    style={{\\n                      transform: `rotateX(${tilt.rx}deg) rotateY(${tilt.ry}deg)`,\\n                    }}\\n                  >\\n                    <div\\n                      className={`card-3d-flipper ${isFlipped ? \'is-flipped\' : \'\'}`}\\n                    >\\n                      {/* ================= CARD FRONT FACE (/kartu-depan.png) ================= */}\\n                      <div\\n                        aria-hidden={isFlipped}\\n                        className={`card-face-plane card-face-front-plane transition-opacity duration-200 ${\\n                          isFlipped\\n                            ? \'opacity-0 pointer-events-none delay-150\'\\n                            : \'opacity-100 delay-75\'\\n                        }`}\\n                      >\\n                        <div className=\\\"card-surface-shell bg-[#4A4928]\\\">\\n                          {/* Custom Front Face Background Asset */}\\n                          <img\\n                            src=\\\"/kartu-depan.png\\\"\\n                            alt=\\\"Sissi Heritage Loyalty Card Front\\\"\\n                            className=\\\"absolute inset-0 w-full h-full object-cover pointer-events-none select-none\\\"\\n                          />\\n\\n                          {/* Dynamic Holographic Foil Overlay on top of /kartu-depan.png */}\\n                          <div\\n                            aria-hidden=\\\"true\\\"\\n                            className=\\\"holographic-sheen pointer-events-none absolute inset-0 opacity-80 z-20\\\"\\n                          />\\n\\n                          {/* Dynamic Specular Glare following DeviceOrientation / Gyroscope */}\\n                          <div\\n                            aria-hidden=\\\"true\\\"\\n                            className=\\\"pointer-events-none absolute inset-0 transition-opacity duration-200 z-20\\\"\\n                            style={{\\n                              background: `radial-gradient(circle at ${tilt.gx}% ${tilt.gy}%, rgba(255, 255, 255, 0.28) 0%, rgba(251, 191, 36, 0.10) 30%, transparent 64%)`,\\n                            }}\\n                          />\\n                        </div>\\n                      </div>\\n\\n                      {/* ================= CARD BACK FACE (/kartu-belakang-kosong.png + 8 Stamp Grid + QR) ================= */}\\n                      <div\\n                        aria-hidden={!isFlipped}\\n                        className={`card-face-plane card-face-back-plane transition-opacity duration-200 ${\\n                          isFlipped\\n                            ? \'opacity-100 delay-75\'\\n                            : \'opacity-0 pointer-events-none delay-150\'\\n                        }`}\\n                      >\\n                        <div className=\\\"card-surface-shell bg-[#EFE5D1]\\\">\\n                          {/* Custom Back Face Base Asset (/kartu-belakang-kosong.png) */}\\n                          <img\\n                            src=\\\"/kartu-belakang-kosong.png\\\"\\n                            alt=\\\"Sissi Heritage Loyalty Card Back\\\"\\n                            className=\\\"absolute inset-0 w-full h-full object-cover pointer-events-none select-none\\\"\\n                          />\\n\\n                          {/* Top-Right Anonymous Customer ID Badge */}\\n                          <div className=\\\"absolute top-[7.5%] right-[5.5%] z-10 pointer-events-none\\\">\\n                            <span className=\\\"font-mono tabular-nums text-[10px] sm:text-xs font-semibold text-[#4A4928]/85 tracking-wider\\\">\\n                              ID \302\267 {activeCustomer.id}\\n                            </span>\\n                          </div>\\n\\n                          {/* =========================================================\\n                              8-STAMP CSS GRID OVERLAY\\n                              Matches the exact visual placement of the 8 empty circles\\n                              on /kartu-belakang-kosong.png:\\n                              - Bounding box: left 14.45%, top 31.06%, width 71.07%, height 44.20%\\n                              - 5 columns x 2 rows (Row 1: cols 1..5, Row 2: cols 2..4)\\n                          ========================================================= */}\\n                          <div\\n                            className=\\\"absolute z-10 grid grid-cols-5 grid-rows-2 overflow-visible\\\"\\n                            style={{\\n                              left: \'14.45%\',\\n                              top: \'31.06%\',\\n                              width: \'71.07%\',\\n                              height: \'44.20%\',\\n                              columnGap: \'4.15%\',\\n                              rowGap: \'14.80%\',\\n                            }}\\n                          >\\n                            {STAMP_SLOTS.map((slot, index) => {\\n                              const isStamped =\\n                                slot.index <= activeCustomer.currentStamps;\\n                              const stampSrc =\\n                                index % 2 === 0\\n                                  ? \'/stamp-roti.png\'\\n                                  : \'/stamp-kopi.png\';\\n                              return (\\n                                <button\\n                                  key={slot.index}\\n                                  type=\\\"button\\\"\\n                                  onClick={(e) =>\\n                                    setExactStampCount(\\n                                      activeCustomer.id,\\n                                      slot.index,\\n                                      e\\n                                    )\\n                                  }\\n                                  title={`${t.toggleStampTitle}${slot.index}`}\\n                                  aria-label={`Stamp circle ${slot.index}`}\\n                                  className={`${slot.gridClass} relative w-full h-full rounded-full overflow-visible p-[8%] flex items-center justify-center cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-[#4A4928] transition-transform active:scale-95`}\\n                                >\\n                                  {isStamped && (\\n                                    <div className=\\\"w-full h-full flex items-center justify-center overflow-visible\\\">\\n                                      <img\\n                                        src={stampSrc}\\n                                        alt={`Stamp ${slot.index}`}\\n                                        style={{ objectFit: \'contain\' }}\\n                                        className=\\\"w-full h-full max-w-full max-h-full object-contain pointer-events-none select-none transition-all duration-300 scale-100 block\\\"\\n                                      />\\n                                    </div>\\n                                  )}\\n                                </button>\\n                              );\\n                            })}\\n                          </div>\\n\\n                          {/* =========================================================\\n                              DYNAMIC <img /> QR CODE OVERLAY\\n                              Positioned strictly inside the white \'TEMPAT QR CODE\'\\n                              bounding box at bottom-right of /kartu-belakang-kosong.png:\\n                              left: 79.75%, top: 68.85%, width: 17.02%, height: 27.10%\\n                          ========================================================= */}\\n                          <div\\n                            onClick={(e) => e.stopPropagation()}\\n                            title={`https://api.merchant-system.com/scan?id=${activeCustomer.id}`}\\n                            className=\\\"absolute z-10 bg-white flex items-center justify-center p-[1.2%] overflow-hidden\\\"\\n                            style={{\\n                              left: \'79.75%\',\\n                              top: \'68.85%\',\\n                              width: \'17.02%\',\\n                              height: \'27.10%\',\\n                              borderRadius: \'14%\',\\n                            }}\\n                          >\\n                            <img\\n                              src={`https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=${encodeURIComponent(\\n                                \'https://api.merchant-system.com/scan?id=\' +\\n                                  activeCustomer.id\\n                              )}`}\\n                              alt=\\\"QR Code\\\"\\n                              referrerPolicy=\\\"no-referrer\\\"\\n                              className=\\\"w-full h-full object-contain block\\\"\\n                            />\\n                          </div>\\n\\n                          {/* Holographic & Specular Overlays on top of /kartu-belakang-kosong.png */}\\n                          <div\\n                            aria-hidden=\\\"true\\\"\\n                            className=\\\"holographic-sheen pointer-events-none absolute inset-0 opacity-70 z-20\\\"\\n                          />\\n                          <div\\n                            aria-hidden=\\\"true\\\"\\n                            className=\\\"pointer-events-none absolute inset-0 z-20\\\"\\n                            style={{\\n                              background: `radial-gradient(circle at ${100 - tilt.gx}% ${tilt.gy}%, rgba(255, 255, 255, 0.26) 0%, transparent 60%)`,\\n                            }}\\n                          />\\n                        </div>\\n                      </div>\\n                    </div>\\n                  </div>\\n                </div>\\n              </div>\\n\\n              {/* Bottom Stage Helper Bar */}\\n              <div className=\\\"w-full flex flex-wrap items-center justify-between gap-3 pt-3 border-t border-white/[0.06] text-xs text-[#86868B] z-10\\\">\\n                <span>{t.stageFooterHint}</span>\\n                <span className=\\\"font-mono tabular-nums text-[#2997FF]\\\">\\n                  {isFlipped ? t.drawerActiveBelow : t.flipForWalletActions}\\n                </span>\\n              </div>\\n            </div>\\n\\n            {/* Right 5 Columns: Interactive Pass Controls & DeviceOrientation Gyro Simulator */}\\n            <div className=\\\"lg:col-span-5 bg-[#161618] rounded-[24px] p-6 border border-white/[0.06] shadow-2xl flex flex-col justify-between space-y-6\\\">\\n              <div className=\\\"space-y-5\\\">\\n                <div className=\\\"flex items-center justify-between border-b border-white/[0.06] pb-4 gap-3\\\">\\n                  <div>\\n                    <h1 className=\\\"text-lg font-semibold tracking-[-0.025em] leading-[1.06] text-[#F5F5F7]\\\">\\n                      {t.studioTitle}\\n                    </h1>\\n                    <p className=\\\"text-xs text-[#86868B] mt-1\\\">\\n                      {t.studioSubtitle}\\n                    </p>\\n                  </div>\\n                  <button\\n                    type=\\\"button\\\"\\n                    onClick={requestGyroPermission}\\n                    className={`inline-flex items-center gap-1.5 bg-[#161618] hover:bg-[#2C2C2E] border text-[13px] px-[16px] py-[7px] rounded-full transition-all cursor-pointer whitespace-nowrap shrink-0 ${\\n                      gyroStatus === \'active\'\\n                        ? \'border-[#2997FF] text-[#2997FF]\'\\n                        : \'border-white/[0.08] text-[#F5F5F7]\'\\n                    }`}\\n                  >\\n                    <Smartphone className=\\\"w-3.5 h-3.5 text-[#2997FF]\\\" />\\n                    <span>\\n                      {gyroStatus === \'active\'\\n                        ? t.gyroLinked\\n                        : t.pairMotionSensor}\\n                    </span>\\n                  </button>\\n                </div>\\n\\n                {/* Anonymous LocalStorage Pass Indicator + Profile Switcher */}\\n                <div className=\\\"space-y-2\\\">\\n                  <div className=\\\"flex items-center justify-between text-xs\\\">\\n                    <label\\n                      htmlFor=\\\"member-select\\\"\\n                      className=\\\"font-medium text-[#86868B]\\\"\\n                    >\\n                      {t.activeCardholderProfile}\\n                    </label>\\n                    <span className=\\\"font-mono tabular-nums text-[11px] text-emerald-400 flex items-center gap-1\\\">\\n                      <HardDrive className=\\\"w-3 h-3\\\" />\\n                      <span>localStorage: {localCustomerId}</span>\\n                    </span>\\n                  </div>\\n                  <div className=\\\"relative\\\">\\n                    <select\\n                      id=\\\"member-select\\\"\\n                      value={selectedCustomerId}\\n                      onChange={(e) => setSelectedCustomerId(e.target.value)}\\n                      className=\\\"w-full bg-[#000000] border border-white/[0.08] focus:border-[#0071E3] rounded-full pl-4 pr-10 py-2.5 text-[14px] text-[#F5F5F7] outline-none appearance-none cursor-pointer transition-all\\\"\\n                    >\\n                      {customers.map((c) => (\\n                        <option key={c.id} value={c.id} className=\\\"bg-[#161618] text-[#F5F5F7]\\\">\\n                          {c.isLocalDevice ? t.localDeviceMemberName : c.name} \342\200\224{\' \'}\\n                          {c.id} ({c.currentStamps}/{MAX_STAMPS} {t.stampsWord})\\n                        </option>\\n                      ))}\\n                    </select>\\n                    <ChevronDown className=\\\"w-4 h-4 text-[#86868B] pointer-events-none absolute right-4 top-1/2 -translate-y-1/2\\\" />\\n                  </div>\\n                </div>\\n\\n                {/* Stamp Issuance & Redemption Controls (8 Stamps) */}\\n                <div className=\\\"space-y-3 pt-1\\\">\\n                  <div className=\\\"flex items-center justify-between text-xs\\\">\\n                    <span className=\\\"text-[#F5F5F7] font-medium\\\">\\n                      {t.stampProgress} ({activeCustomer.currentStamps} /{\' \'}\\n                      {MAX_STAMPS})\\n                    </span>\\n                    <span className=\\\"font-mono tabular-nums text-[#86868B]\\\">\\n                      {t.lifetimeRedeemed}: {activeCustomer.totalRedeemedStamps}\\n                    </span>\\n                  </div>\\n\\n                  {/* Clean Segmented 8-Stamp Progress Bar */}\\n                  <div className=\\\"grid grid-cols-8 gap-1.5 h-2\\\">\\n                    {Array.from({ length: MAX_STAMPS }, (_, idx) => (\\n                      <div\\n                        key={idx}\\n                        className={`rounded-full transition-colors ${\\n                          idx < activeCustomer.currentStamps\\n                            ? \'bg-[#0071E3]\'\\n                            : \'bg-white/[0.08]\'\\n                        }`}\\n                      />\\n                    ))}\\n                  </div>\\n\\n                  <div className=\\\"grid grid-cols-3 gap-2.5 pt-2\\\">\\n                    <button\\n                      type=\\\"button\\\"\\n                      onClick={() => updateCustomerStamps(activeCustomer.id, -1)}\\n                      disabled={activeCustomer.currentStamps <= 0}\\n                      className=\\\"bg-[#161618] hover:bg-[#2C2C2E] disabled:opacity-40 text-[#F5F5F7] border border-white/[0.08] text-[13px] px-[16px] py-[8px] rounded-full flex items-center justify-center gap-1.5 transition-all cursor-pointer\\\"\\n                    >\\n                      <Minus className=\\\"w-3.5 h-3.5\\\" />\\n                      <span>{t.btnRemove}</span>\\n                    </button>\\n\\n                    <button\\n                      type=\\\"button\\\"\\n                      onClick={() => {\\n                        updateCustomerStamps(activeCustomer.id, 1);\\n                        if (!isFlipped) setIsFlipped(true);\\n                      }}\\n                      disabled={activeCustomer.currentStamps >= MAX_STAMPS}\\n                      className=\\\"bg-[#0071E3] hover:bg-[#0077ED] disabled:opacity-40 text-white text-[13px] font-normal tracking-[-0.01em] px-[18px] py-[8px] rounded-full flex items-center justify-center gap-1.5 transition-all cursor-pointer\\\"\\n                    >\\n                      <Plus className=\\\"w-3.5 h-3.5\\\" />\\n                      <span>{t.btnStampPlus}</span>\\n                    </button>\\n\\n                    <button\\n                      type=\\\"button\\\"\\n                      onClick={() => redeemCustomerReward(activeCustomer.id)}\\n                      className={`text-[13px] px-[16px] py-[8px] rounded-full flex items-center justify-center gap-1.5 transition-all cursor-pointer border ${\\n                        activeCustomer.currentStamps === MAX_STAMPS\\n                          ? \'bg-[#161618] hover:bg-[#2C2C2E] border-[#2997FF] text-[#2997FF]\'\\n                          : \'bg-[#161618] text-[#86868B] border-white/[0.08]\'\\n                      }`}\\n                    >\\n                      <Award className=\\\"w-3.5 h-3.5\\\" />\\n                      <span>{t.btnRedeemAll}</span>\\n                    </button>\\n                  </div>\\n                </div>\\n\\n                {/* DeviceOrientation Tilt Calibration Sliders */}\\n                <div className=\\\"space-y-3 pt-4 border-t border-white/[0.06]\\\">\\n                  <div className=\\\"flex items-center justify-between\\\">\\n                    <span className=\\\"text-xs font-medium text-[#F5F5F7] flex items-center gap-1.5\\\">\\n                      <Sliders className=\\\"w-3.5 h-3.5 text-[#2997FF]\\\" />\\n                      <span>{t.gyroSimulatorTitle}</span>\\n                    </span>\\n                    <button\\n                      type=\\\"button\\\"\\n                      onClick={() => {\\n                        setGyroStatus(\'idle\');\\n                        setTilt({ rx: 0, ry: 0, gx: 50, gy: 50 });\\n                      }}\\n                      className=\\\"text-xs text-[#86868B] hover:text-[#F5F5F7] transition-colors cursor-pointer\\\"\\n                    >\\n                      {t.resetAxis}\\n                    </button>\\n                  </div>\\n\\n                  <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-3\\\">\\n                    <div className=\\\"space-y-1\\\">\\n                      <div className=\\\"flex justify-between text-[11px] text-[#86868B]\\\">\\n                        <span>{t.pitchLabel}</span>\\n                        <span className=\\\"font-mono tabular-nums text-[#F5F5F7]\\\">\\n                          {tilt.rx}\302\260\\n                        </span>\\n                      </div>\\n                      <input\\n                        type=\\\"range\\\"\\n                        min={-24}\\n                        max={24}\\n                        step={1}\\n                        value={tilt.rx}\\n                        onChange={(e) => {\\n                          const rx = Number(e.target.value);\\n                          setGyroStatus(\'simulated\');\\n                          setTilt((prev) => ({\\n                            ...prev,\\n                            rx,\\n                            gy: Math.round(50 - (rx / 24) * 40),\\n                          }));\\n                        }}\\n                        className=\\\"w-full accent-[#0071E3] cursor-pointer\\\"\\n                      />\\n                    </div>\\n\\n                    <div className=\\\"space-y-1\\\">\\n                      <div className=\\\"flex justify-between text-[11px] text-[#86868B]\\\">\\n                        <span>{t.rollLabel}</span>\\n                        <span className=\\\"font-mono tabular-nums text-[#F5F5F7]\\\">\\n                          {tilt.ry}\302\260\\n                        </span>\\n                      </div>\\n                      <input\\n                        type=\\\"range\\\"\\n                        min={-24}\\n                        max={24}\\n                        step={1}\\n                        value={tilt.ry}\\n                        onChange={(e) => {\\n                          const ry = Number(e.target.value);\\n                          setGyroStatus(\'simulated\');\\n                          setTilt((prev) => ({\\n                            ...prev,\\n                            ry,\\n                            gx: Math.round(50 + (ry / 24) * 40),\\n                          }));\\n                        }}\\n                        className=\\\"w-full accent-[#0071E3] cursor-pointer\\\"\\n                      />\\n                    </div>\\n                  </div>\\n                </div>\\n              </div>\\n\\n              {/* Flip Action CTA */}\\n              <div className=\\\"pt-4 border-t border-white/[0.06] flex items-center justify-between gap-3\\\">\\n                <div className=\\\"text-xs text-[#86868B]\\\">\\n                  {isFlipped ? t.drawerHintOpen : t.drawerHintClosed}\\n                </div>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => setIsFlipped((prev) => !prev)}\\n                  className=\\\"bg-[#0071E3] hover:bg-[#0077ED] text-white text-[13px] font-normal tracking-[-0.01em] px-[18px] py-[8px] rounded-full transition-all whitespace-nowrap shrink-0 cursor-pointer\\\"\\n                >\\n                  {isFlipped ? t.showFrontFace : t.flipAndOpenDrawer}\\n                </button>\\n              </div>\\n            </div>\\n          </section>\\n        )}\\n\\n        {/* SECTION 2: TOGGLEABLE B2B MERCHANT DASHBOARD (APPLE BENTO GRID & GLASSOS TABLE) */}\\n        {viewMode !== \'pass\' && (\\n          <section aria-label={t.b2bTitle} className=\\\"space-y-6\\\">\\n            {/* Dashboard Header */}\\n            <div className=\\\"flex flex-col md:flex-row md:items-end justify-between gap-4\\\">\\n              <div>\\n                <h2 className=\\\"text-2xl md:text-3xl font-semibold tracking-[-0.025em] leading-[1.06] text-[#F5F5F7]\\\">\\n                  {t.b2bTitle}\\n                </h2>\\n                <p className=\\\"text-sm text-[#86868B] mt-1.5\\\">{t.b2bSubtitle}</p>\\n              </div>\\n            </div>\\n\\n            {/* Apple Bento Grid Metric Cards (4 Summary Metric Containers) */}\\n            <div className=\\\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4\\\">\\n              <div className=\\\"bg-[#161618] rounded-[24px] p-6 border border-white/[0.06] shadow-2xl\\\">\\n                <div className=\\\"text-xs font-medium text-[#86868B]\\\">\\n                  {t.kpiRegistered}\\n                </div>\\n                <div className=\\\"mt-3 text-[40px] md:text-[48px] font-semibold tracking-tight leading-none font-mono tabular-nums bg-gradient-to-b from-white via-[#F5F5F7] to-[#86868B] bg-clip-text text-transparent\\\">\\n                  {b2bStats.totalMembers}\\n                </div>\\n              </div>\\n\\n              <div className=\\\"bg-[#161618] rounded-[24px] p-6 border border-white/[0.06] shadow-2xl\\\">\\n                <div className=\\\"text-xs font-medium text-[#86868B]\\\">\\n                  {t.kpiTotalRedeemed}\\n                </div>\\n                <div className=\\\"mt-3 text-[40px] md:text-[48px] font-semibold tracking-tight leading-none font-mono tabular-nums bg-gradient-to-b from-[#64D2FF] via-[#2997FF] to-[#0071E3] bg-clip-text text-transparent\\\">\\n                  {b2bStats.totalRedeemed}\\n                </div>\\n              </div>\\n\\n              <div className=\\\"bg-[#161618] rounded-[24px] p-6 border border-white/[0.06] shadow-2xl\\\">\\n                <div className=\\\"text-xs font-medium text-[#86868B]\\\">\\n                  {t.kpiActiveUnredeemed}\\n                </div>\\n                <div className=\\\"mt-3 text-[40px] md:text-[48px] font-semibold tracking-tight leading-none font-mono tabular-nums bg-gradient-to-b from-white via-[#F5F5F7] to-[#86868B] bg-clip-text text-transparent\\\">\\n                  {b2bStats.activeStamps}\\n                </div>\\n              </div>\\n\\n              <div className=\\\"bg-[#161618] rounded-[24px] p-6 border border-white/[0.06] shadow-2xl\\\">\\n                <div className=\\\"text-xs font-medium text-[#86868B]\\\">\\n                  {t.kpiRewardsReady}\\n                </div>\\n                <div className=\\\"mt-3 text-[40px] md:text-[48px] font-semibold tracking-tight leading-none font-mono tabular-nums bg-gradient-to-b from-[#6EE7B7] via-[#34D399] to-[#10B981] bg-clip-text text-transparent\\\">\\n                  {b2bStats.readyCount}\\n                </div>\\n              </div>\\n            </div>\\n\\n            {/* Search & Filter Controls */}\\n            <div className=\\\"flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4\\\">\\n              <div className=\\\"relative flex-1 max-w-md\\\">\\n                <Search className=\\\"w-4 h-4 text-[#86868B] absolute left-4 top-1/2 -translate-y-1/2 pointer-events-none\\\" />\\n                <input\\n                  type=\\\"search\\\"\\n                  value={searchQuery}\\n                  onChange={(e) => setSearchQuery(e.target.value)}\\n                  placeholder={t.searchPlaceholder}\\n                  className=\\\"w-full bg-[#161618] border border-white/[0.08] focus:border-[#0071E3] rounded-full pl-10 pr-4 py-2 text-[14px] text-[#F5F5F7] placeholder-[#86868B] outline-none transition-all\\\"\\n                />\\n              </div>\\n\\n              <div className=\\\"flex items-center gap-2 self-start\\\">\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => setTableFilter(\'all\')}\\n                  className={`bg-[#161618] hover:bg-[#2C2C2E] border text-[13px] px-[16px] py-[7px] rounded-full transition-all whitespace-nowrap shrink-0 cursor-pointer ${\\n                    tableFilter === \'all\'\\n                      ? \'border-[#2997FF] text-[#2997FF]\'\\n                      : \'border-white/[0.08] text-[#F5F5F7]\'\\n                  }`}\\n                >\\n                  {t.filterAll}\\n                </button>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => setTableFilter(\'ready\')}\\n                  className={`bg-[#161618] hover:bg-[#2C2C2E] border text-[13px] px-[16px] py-[7px] rounded-full transition-all whitespace-nowrap shrink-0 cursor-pointer ${\\n                    tableFilter === \'ready\'\\n                      ? \'border-[#2997FF] text-[#2997FF]\'\\n                      : \'border-white/[0.08] text-[#F5F5F7]\'\\n                  }`}\\n                >\\n                  {t.filterReady}\\n                </button>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => setTableFilter(\'vip\')}\\n                  className={`bg-[#161618] hover:bg-[#2C2C2E] border text-[13px] px-[16px] py-[7px] rounded-full transition-all whitespace-nowrap shrink-0 cursor-pointer ${\\n                    tableFilter === \'vip\'\\n                      ? \'border-[#2997FF] text-[#2997FF]\'\\n                      : \'border-white/[0.08] text-[#F5F5F7]\'\\n                  }`}\\n                >\\n                  {t.filterVip}\\n                </button>\\n              </div>\\n            </div>\\n\\n            {/* B2B Customer Data Table (GlassOS Bento Container) */}\\n            <div className=\\\"bg-[#161618] rounded-[24px] border border-white/[0.06] shadow-2xl overflow-hidden\\\">\\n              <div className=\\\"overflow-x-auto\\\">\\n                <table className=\\\"w-full text-left border-collapse\\\">\\n                  <thead>\\n                    <tr className=\\\"text-[12px] font-medium text-[#86868B] border-b border-white/[0.06] uppercase tracking-wider\\\">\\n                      <th className=\\\"py-4 px-5\\\">{t.thCustomerName}</th>\\n                      <th className=\\\"py-4 px-5\\\">{t.thCustomerId}</th>\\n                      <th className=\\\"py-4 px-5\\\">{t.thActiveGrid}</th>\\n                      <th className=\\\"py-4 px-5 text-right\\\">\\n                        {t.thTotalRedeemed}\\n                      </th>\\n                      <th className=\\\"py-4 px-5 text-right\\\">\\n                        {t.thMerchantActions}\\n                      </th>\\n                    </tr>\\n                  </thead>\\n                  <tbody>\\n                    {filteredCustomers.length === 0 ? (\\n                      <tr>\\n                        <td\\n                          colSpan={5}\\n                          className=\\\"py-12 text-center text-[#86868B] text-[14px]\\\"\\n                        >\\n                          {t.noRecordsMatch} &ldquo;{searchQuery}&rdquo;.\\n                        </td>\\n                      </tr>\\n                    ) : (\\n                      filteredCustomers.map((customer) => {\\n                        const isSelected = customer.id === activeCustomer.id;\\n                        const displayName = customer.isLocalDevice\\n                          ? t.localDeviceMemberName\\n                          : customer.name;\\n                        return (\\n                          <tr\\n                            key={customer.id}\\n                            onClick={() => setSelectedCustomerId(customer.id)}\\n                            className={`border-b border-white/[0.04] transition-colors text-[14px] text-[#F5F5F7] cursor-pointer ${\\n                              isSelected\\n                                ? \'bg-[#0071E3]/[0.08] hover:bg-[#0071E3]/[0.12]\'\\n                                : \'hover:bg-white/[0.02]\'\\n                            }`}\\n                          >\\n                            <td className=\\\"py-4 px-5\\\">\\n                              <div className=\\\"font-semibold text-[#F5F5F7] flex items-center gap-2\\\">\\n                                <span>{displayName}</span>\\n                                {isSelected && (\\n                                  <span className=\\\"text-[11px] font-normal text-[#2997FF]\\\">\\n                                    {t.activeOn3dCard}\\n                                  </span>\\n                                )}\\n                              </div>\\n                              <div className=\\\"text-xs text-[#86868B] mt-0.5\\\">\\n                                {customer.isLocalDevice\\n                                  ? `${t.localDeviceTag} \302\267 ${customer.email}`\\n                                  : `${customer.email} \302\267 ${customer.tier}`}\\n                              </div>\\n                            </td>\\n\\n                            <td className=\\\"py-4 px-5 font-mono tabular-nums text-xs text-[#F5F5F7]\\\">\\n                              {customer.id}\\n                            </td>\\n\\n                            <td className=\\\"py-4 px-5\\\">\\n                              <div className=\\\"flex items-center gap-2.5\\\">\\n                                <span className=\\\"font-mono tabular-nums text-xs text-[#86868B] w-12\\\">\\n                                  {customer.currentStamps} / {MAX_STAMPS}\\n                                </span>\\n                                <div className=\\\"w-24 h-2 rounded-full bg-white/[0.08] overflow-hidden\\\">\\n                                  <div\\n                                    className={`h-full transition-all ${\\n                                      customer.currentStamps === MAX_STAMPS\\n                                        ? \'bg-emerald-400\'\\n                                        : \'bg-[#0071E3]\'\\n                                    }`}\\n                                    style={{\\n                                      width: `${\\n                                        (customer.currentStamps / MAX_STAMPS) *\\n                                        100\\n                                      }%`,\\n                                    }}\\n                                  />\\n                                </div>\\n                              </div>\\n                            </td>\\n\\n                            <td className=\\\"py-4 px-5 text-right font-mono tabular-nums font-semibold text-[#F5F5F7]\\\">\\n                              {customer.totalRedeemedStamps}\\n                            </td>\\n\\n                            <td\\n                              className=\\\"py-4 px-5 text-right\\\"\\n                              onClick={(e) => e.stopPropagation()}\\n                            >\\n                              <div className=\\\"inline-flex items-center justify-end gap-2\\\">\\n                                <button\\n                                  type=\\\"button\\\"\\n                                  onClick={() =>\\n                                    updateCustomerStamps(customer.id, 1)\\n                                  }\\n                                  disabled={customer.currentStamps >= MAX_STAMPS}\\n                                  className=\\\"bg-[#0071E3] hover:bg-[#0077ED] disabled:opacity-40 text-white text-[13px] font-normal tracking-[-0.01em] px-[18px] py-[8px] rounded-full transition-all cursor-pointer whitespace-nowrap\\\"\\n                                >\\n                                  {t.btnStampPlus}\\n                                </button>\\n                                <button\\n                                  type=\\\"button\\\"\\n                                  onClick={() =>\\n                                    redeemCustomerReward(customer.id)\\n                                  }\\n                                  disabled={customer.currentStamps < MAX_STAMPS}\\n                                  className={`bg-[#161618] hover:bg-[#2C2C2E] border text-[13px] px-[16px] py-[7px] rounded-full transition-all cursor-pointer whitespace-nowrap ${\\n                                    customer.currentStamps === MAX_STAMPS\\n                                      ? \'border-[#2997FF] text-[#2997FF]\'\\n                                      : \'border-white/[0.08] text-[#86868B] opacity-50\'\\n                                  }`}\\n                                >\\n                                  {t.btnRedeemAll}\\n                                </button>\\n                              </div>\\n                            </td>\\n                          </tr>\\n                        );\\n                      })\\n                    )}\\n                  </tbody>\\n                </table>\\n              </div>\\n            </div>\\n          </section>\\n        )}\\n      </main>\\n\\n      {/* =====================================================================\\n          SLIDE-UP ACTION MENU DRAWER\\n          Strictly triggered when the card flips to the back (isFlipped === true)\\n          Contains \'Add to Home Screen\' (PWA shortcut) and \'Email Backup\'\\n      ===================================================================== */}\\n      <aside\\n        aria-label=\\\"PWA Home Screen and Backup Slide-Up Action Menu\\\"\\n        aria-hidden={!isFlipped}\\n        className={`fixed left-0 right-0 bottom-0 z-40 transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] ${\\n          isFlipped\\n            ? \'translate-y-0 pointer-events-auto\'\\n            : \'translate-y-full pointer-events-none\'\\n        }`}\\n      >\\n        <div className=\\\"max-w-2xl mx-auto px-4\\\">\\n          <div\\n            className=\\\"rounded-t-[24px] bg-[#161618]/90 border-t border-x border-white/[0.08] shadow-[0_-20px_50px_rgba(0,0,0,0.85)] px-6 pt-3 pb-6\\\"\\n            style={{\\n              backdropFilter: \'saturate(180%) blur(20px)\',\\n              WebkitBackdropFilter: \'saturate(180%) blur(20px)\',\\n            }}\\n          >\\n            {/* Drag Handle Affordance */}\\n            <div className=\\\"w-10 h-1.5 bg-white/[0.2] rounded-full mx-auto mb-3\\\" />\\n\\n            <div className=\\\"flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-4\\\">\\n              <div className=\\\"flex items-center gap-2 text-xs text-[#86868B]\\\">\\n                <span className=\\\"font-semibold text-[#F5F5F7]\\\">\\n                  {t.drawerHeader}\\n                </span>\\n                <span aria-hidden=\\\"true\\\">\302\267</span>\\n                <span className=\\\"font-mono tabular-nums text-[#2997FF]\\\">\\n                  {activeCustomer.id}\\n                </span>\\n                <span aria-hidden=\\\"true\\\">\302\267</span>\\n                <span className=\\\"text-[#86868B]\\\">\\n                  {activeCustomer.currentStamps}/{MAX_STAMPS} {t.stampsWord}\\n                </span>\\n              </div>\\n\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => setIsFlipped(false)}\\n                className=\\\"text-xs text-[#86868B] hover:text-[#F5F5F7] transition-colors self-end sm:self-auto cursor-pointer\\\"\\n              >\\n                {t.flipFrontToDismiss}\\n              </button>\\n            </div>\\n\\n            {/* 2 Action Buttons: \'Add to Home Screen\' (PWA) & \'Email Backup\' */}\\n            <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-3\\\">\\n              <button\\n                type=\\\"button\\\"\\n                onClick={handleAddToHomeScreenClick}\\n                className=\\\"min-h-[46px] bg-[#161618] hover:bg-[#2C2C2E] text-[#F5F5F7] border border-white/[0.08] text-[13px] px-[16px] py-[10px] rounded-full flex items-center justify-center gap-2.5 transition-all active:scale-[0.99] cursor-pointer whitespace-nowrap\\\"\\n              >\\n                <Home className=\\\"w-4 h-4 text-[#2997FF] shrink-0\\\" />\\n                <span>{t.btnAddToHomeScreen}</span>\\n                {isPwaInstalled && (\\n                  <Check className=\\\"w-3.5 h-3.5 text-emerald-400 ml-1 shrink-0\\\" />\\n                )}\\n              </button>\\n\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() =>\\n                  setActionModal({\\n                    type: \'email\',\\n                    emailInput: activeCustomer.email,\\n                  })\\n                }\\n                className=\\\"min-h-[46px] bg-[#0071E3] hover:bg-[#0077ED] text-white text-[13px] font-normal tracking-[-0.01em] px-[18px] py-[10px] rounded-full flex items-center justify-center gap-2.5 transition-all active:scale-[0.99] cursor-pointer whitespace-nowrap\\\"\\n              >\\n                <Mail className=\\\"w-4 h-4 shrink-0\\\" />\\n                <span>{t.btnEmailBackup}</span>\\n              </button>\\n            </div>\\n          </div>\\n        </div>\\n      </aside>\\n\\n      {/* =====================================================================\\n          INTERACTIVE MODAL FOR \'ADD TO HOME SCREEN\' (PWA) OR \'EMAIL BACKUP\'\\n      ===================================================================== */}\\n      {actionModal.type && (\\n        <div\\n          role=\\\"dialog\\\"\\n          aria-modal=\\\"true\\\"\\n          className=\\\"fixed inset-0 z-50 bg-black/75 backdrop-blur-md flex items-center justify-center p-4\\\"\\n          onClick={() => setActionModal({ type: null })}\\n        >\\n          <div\\n            className=\\\"w-full max-w-md rounded-[24px] bg-[#161618] border border-white/[0.08] p-6 space-y-5 shadow-2xl\\\"\\n            onClick={(e) => e.stopPropagation()}\\n          >\\n            <div className=\\\"flex items-center justify-between border-b border-white/[0.06] pb-3\\\">\\n              <h3 className=\\\"text-base font-semibold tracking-[-0.025em] leading-[1.06] text-[#F5F5F7]\\\">\\n                {actionModal.type === \'pwa\'\\n                  ? t.modalPwaTitle\\n                  : t.modalEmailTitle}\\n              </h3>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => setActionModal({ type: null })}\\n                className=\\\"p-1 text-[#86868B] hover:text-white rounded-full cursor-pointer\\\"\\n              >\\n                <X className=\\\"w-4 h-4\\\" />\\n              </button>\\n            </div>\\n\\n            {actionModal.type === \'pwa\' ? (\\n              <div className=\\\"space-y-4\\\">\\n                <div className=\\\"p-4 rounded-2xl bg-[#000000] border border-white/[0.06] space-y-2.5 text-xs\\\">\\n                  <div className=\\\"flex items-center gap-3 pb-2 border-b border-white/[0.06]\\\">\\n                    <div className=\\\"w-11 h-11 rounded-xl bg-[#4A4928] border border-white/[0.12] flex items-center justify-center font-bold text-[#EFE5D1] text-base shrink-0\\\">\\n                      sissi\\n                    </div>\\n                    <div>\\n                      <div className=\\\"font-semibold text-[#F5F5F7] text-sm\\\">\\n                        Sissi Heritage Loyalty Card\\n                      </div>\\n                      <div className=\\\"text-[#86868B] text-[11px]\\\">\\n                        PWA Standalone Shortcut \302\267 /manifest.webmanifest\\n                      </div>\\n                    </div>\\n                  </div>\\n                  <div className=\\\"flex justify-between\\\">\\n                    <span className=\\\"text-[#86868B]\\\">{t.modalLocalIdLabel}</span>\\n                    <span className=\\\"font-mono tabular-nums text-[#2997FF] font-semibold\\\">\\n                      {activeCustomer.id}\\n                    </span>\\n                  </div>\\n                  <div className=\\\"flex justify-between\\\">\\n                    <span className=\\\"text-[#86868B]\\\">{t.modalStorageState}</span>\\n                    <span className=\\\"text-emerald-400 font-medium\\\">\\n                      {t.modalStoragePermanent}\\n                    </span>\\n                  </div>\\n                  <div className=\\\"flex justify-between\\\">\\n                    <span className=\\\"text-[#86868B]\\\">{t.modalSyncedBalance}</span>\\n                    <span className=\\\"font-mono tabular-nums text-[#F5F5F7]\\\">\\n                      {activeCustomer.currentStamps} / {MAX_STAMPS}{\' \'}\\n                      {t.stampsWord}\\n                    </span>\\n                  </div>\\n                </div>\\n\\n                <div className=\\\"p-3.5 rounded-2xl bg-[#000000]/80 border border-white/[0.06] space-y-2 text-xs text-[#86868B] leading-relaxed\\\">\\n                  <div className=\\\"font-semibold text-[#F5F5F7] flex items-center gap-1.5\\\">\\n                    <Share className=\\\"w-3.5 h-3.5 text-[#2997FF]\\\" />\\n                    <span>{t.pwaInstructionsTitle}</span>\\n                  </div>\\n                  {isIOS ? (\\n                    <div className=\\\"space-y-1 text-[#F5F5F7]/90\\\">\\n                      <p>{t.pwaIosStep1}</p>\\n                      <p>{t.pwaIosStep2}</p>\\n                    </div>\\n                  ) : (\\n                    <div className=\\\"space-y-1.5 text-[#F5F5F7]/90\\\">\\n                      <p>{t.pwaAndroidStep}</p>\\n                      <p className=\\\"text-[#86868B]\\\">{t.pwaIosStep1}</p>\\n                      <p className=\\\"text-[#86868B]\\\">{t.pwaIosStep2}</p>\\n                    </div>\\n                  )}\\n                </div>\\n\\n                <div className=\\\"flex items-center justify-end gap-2\\\">\\n                  <button\\n                    type=\\\"button\\\"\\n                    onClick={() => setActionModal({ type: null })}\\n                    className=\\\"bg-[#161618] hover:bg-[#2C2C2E] text-[#F5F5F7] border border-white/[0.08] text-[13px] px-[16px] py-[7px] rounded-full cursor-pointer transition-all\\\"\\n                  >\\n                    {t.btnClose}\\n                  </button>\\n                  <button\\n                    type=\\\"button\\\"\\n                    onClick={async () => {\\n                      if (deferredPrompt) {\\n                        await deferredPrompt.prompt();\\n                      }\\n                      setIsPwaInstalled(true);\\n                      try {\\n                        window.localStorage.setItem(\\n                          STORAGE_KEYS.PWA_SHORTCUT_PINNED,\\n                          \'true\'\\n                        );\\n                      } catch {}\\n                      setActionModal({ type: null });\\n                      triggerToast(t.toastPwaInstalled(activeCustomer.id));\\n                    }}\\n                    className=\\\"bg-[#0071E3] hover:bg-[#0077ED] text-white text-[13px] font-normal tracking-[-0.01em] px-[18px] py-[8px] rounded-full cursor-pointer transition-all\\\"\\n                  >\\n                    {t.btnInstallPwaNow}\\n                  </button>\\n                </div>\\n              </div>\\n            ) : (\\n              <form\\n                onSubmit={(e) => {\\n                  e.preventDefault();\\n                  const targetEmail =\\n                    actionModal.emailInput || activeCustomer.email;\\n                  try {\\n                    window.localStorage.setItem(\\n                      STORAGE_KEYS.BACKUP_EMAIL,\\n                      targetEmail\\n                    );\\n                  } catch {}\\n                  setCustomers((prev) =>\\n                    prev.map((c) =>\\n                      c.id === activeCustomer.id\\n                        ? { ...c, email: targetEmail }\\n                        : c\\n                    )\\n                  );\\n                  setActionModal({ type: null });\\n                  triggerToast(\\n                    t.toastEmailSent(activeCustomer.id, targetEmail)\\n                  );\\n                }}\\n                className=\\\"space-y-4\\\"\\n              >\\n                <p className=\\\"text-xs text-[#86868B] leading-relaxed\\\">\\n                  {t.emailModalDesc} (\\n                  <span className=\\\"font-mono tabular-nums text-[#2997FF]\\\">\\n                    {activeCustomer.id}\\n                  </span>\\n                  ) {t.emailModalToAddress}\\n                </p>\\n                <div>\\n                  <label className=\\\"block text-xs text-[#86868B] mb-1.5\\\">\\n                    {t.recipientEmailLabel}\\n                  </label>\\n                  <input\\n                    type=\\\"email\\\"\\n                    required\\n                    value={actionModal.emailInput ?? activeCustomer.email}\\n                    onChange={(e) =>\\n                      setActionModal((prev) => ({\\n                        ...prev,\\n                        emailInput: e.target.value,\\n                      }))\\n                    }\\n                    className=\\\"w-full bg-[#000000] border border-white/[0.08] focus:border-[#0071E3] rounded-full px-4 py-2 text-[14px] text-[#F5F5F7] placeholder-[#86868B] outline-none transition-all\\\"\\n                  />\\n                </div>\\n                <div className=\\\"flex items-center justify-end gap-2\\\">\\n                  <button\\n                    type=\\\"button\\\"\\n                    onClick={() => setActionModal({ type: null })}\\n                    className=\\\"bg-[#161618] hover:bg-[#2C2C2E] text-[#F5F5F7] border border-white/[0.08] text-[13px] px-[16px] py-[7px] rounded-full cursor-pointer transition-all\\\"\\n                  >\\n                    {t.btnCancel}\\n                  </button>\\n                  <button\\n                    type=\\\"submit\\\"\\n                    className=\\\"bg-[#0071E3] hover:bg-[#0077ED] text-white text-[13px] font-normal tracking-[-0.01em] px-[18px] py-[8px] rounded-full cursor-pointer transition-all\\\"\\n                  >\\n                    {t.btnSendRecovery}\\n                  </button>\\n                </div>\\n              </form>\\n            )}\\n          </div>\\n        </div>\\n      )}\\n\\n      {/* Offline Connectivity Banner */}\\n      {!isOnline && (\\n        <div\\n          role=\\\"status\\\"\\n          className=\\\"fixed bottom-4 left-4 z-50 flex items-center gap-2 rounded-full bg-[#161618] border border-white/[0.12] px-4 py-2 text-xs font-medium text-[#F5F5F7] shadow-2xl\\\"\\n        >\\n          <WifiOff className=\\\"w-4 h-4 text-[#2997FF] shrink-0\\\" />\\n          <span>{t.offlineBanner}</span>\\n        </div>\\n      )}\\n\\n      {/* Toast Feedback Banner */}\\n      {toastMessage && (\\n        <div\\n          role=\\\"status\\\"\\n          className=\\\"fixed top-14 right-6 z-50 flex items-center gap-2.5 px-4 py-2.5 rounded-full bg-[#161618]/95 border border-white/[0.12] text-xs font-medium text-[#F5F5F7] shadow-2xl backdrop-blur-md\\\"\\n        >\\n          <Check className=\\\"w-4 h-4 text-[#2997FF] shrink-0\\\" />\\n          <span>{toastMessage}</span>\\n        </div>\\n      )}\\n    </div>\\n  );\\n}\", \"StartLine\":838, \"TargetContent\":\"  return (\\n    <div className=\\\"min-h-screen bg-[#0B0D11] text-slate-100 flex flex-col relative overflow-x-hidden\\\">\\n      {/* Embedded Keyframes, 3D Backface-Visibility & Holographic Overlay Styles */}\\n      <style>{`\\n        @keyframes floatCardContinuous {\\n          0%, 100% {\\n            transform: translate3d(0, 0px, 0) rotateZ(0deg);\\n          }\\n          50% {\\n            transform: translate3d(0, -12px, 0) rotateZ(0.3deg);\\n          }\\n        }\\n        @keyframes holoShimmer {\\n          0%, 100% {\\n            background-position: 0% 50%;\\n          }\\n          50% {\\n            background-position: 100% 50%;\\n          }\\n        }\\n        .metal-card-floating {\\n          animation: floatCardContinuous 5.6s cubic-bezier(0.45, 0.05, 0.55, 0.95) infinite;\\n          will-change: transform;\\n        }\\n        .perspective-stage {\\n          perspective: 1400px;\\n          -webkit-perspective: 1400px;\\n        }\\n        .card-3d-tilt {\\n          transform-style: preserve-3d;\\n          -webkit-transform-style: preserve-3d;\\n          transition: transform 140ms cubic-bezier(0.16, 1, 0.3, 1);\\n          will-change: transform;\\n        }\\n        .card-3d-flipper {\\n          position: relative;\\n          width: 100%;\\n          height: 100%;\\n          transform-style: preserve-3d;\\n          -webkit-transform-style: preserve-3d;\\n          transition: transform 740ms cubic-bezier(0.22, 1, 0.36, 1);\\n          will-change: transform;\\n        }\\n        .card-3d-flipper.is-flipped {\\n          transform: rotateY(180deg);\\n          -webkit-transform: rotateY(180deg);\\n        }\\n        .card-face-plane {\\n          position: absolute;\\n          inset: 0;\\n          width: 100%;\\n          height: 100%;\\n          backface-visibility: hidden;\\n          -webkit-backface-visibility: hidden;\\n          border-radius: 20px;\\n        }\\n        .card-face-front-plane {\\n          transform: rotateY(0deg) translateZ(2px);\\n          -webkit-transform: rotateY(0deg) translateZ(2px);\\n          z-index: 2;\\n        }\\n        .card-face-back-plane {\\n          transform: rotateY(180deg) translateZ(2px);\\n          -webkit-transform: rotateY(180deg) translateZ(2px);\\n          z-index: 1;\\n        }\\n        .card-surface-shell {\\n          position: relative;\\n          width: 100%;\\n          height: 100%;\\n          border-radius: 20px;\\n          overflow: hidden;\\n          box-shadow:\\n            0 30px 65px -15px rgba(0, 0, 0, 0.85),\\n            0 0 0 1px rgba(255, 255, 255, 0.22),\\n            inset 0 1px 1px rgba(255, 255, 255, 0.35);\\n        }\\n        .holographic-sheen {\\n          background: linear-gradient(\\n            125deg,\\n            transparent 16%,\\n            rgba(255, 210, 130, 0.22) 32%,\\n            rgba(130, 240, 220, 0.18) 44%,\\n            rgba(180, 160, 255, 0.18) 55%,\\n            rgba(255, 160, 200, 0.18) 66%,\\n            transparent 82%\\n          );\\n          background-size: 220% 220%;\\n          animation: holoShimmer 6.5s ease-in-out infinite;\\n          mix-blend-mode: soft-light;\\n        }\\n        @media (prefers-reduced-motion: reduce) {\\n          .metal-card-floating,\\n          .holographic-sheen {\\n            animation: none !important;\\n          }\\n        }\\n      `}</style>\\n\\n      {/* Top Bar Contract: Zone 1 (Wordmark) \342\200\224 Zone 2 (4 Single-line Nav Links) \342\200\224 Zone 3 (1 Primary Action) */}\\n      <header className=\\\"sticky top-0 z-30 flex items-center justify-between gap-8 px-6 lg:px-10 h-14 bg-[#0B0D11]/90 backdrop-blur-md border-b border-slate-800/80\\\">\\n        <a\\n          href=\\\"#top\\\"\\n          className=\\\"text-base font-bold tracking-tight text-slate-100 whitespace-nowrap shrink-0\\\"\\n        >\\n          Sissi Heritage\\n        </a>\\n\\n        <nav className=\\\"hidden md:flex items-center gap-7 text-sm font-medium text-slate-400\\\">\\n          <button\\n            type=\\\"button\\\"\\n            onClick={() => {\\n              setViewMode(\'split\');\\n              setIsFlipped(false);\\n            }}\\n            className=\\\"hover:text-slate-100 transition-colors whitespace-nowrap shrink-0 cursor-pointer\\\"\\n          >\\n            {t.navFront}\\n          </button>\\n          <button\\n            type=\\\"button\\\"\\n            onClick={() => {\\n              setViewMode(\'split\');\\n              setIsFlipped(true);\\n            }}\\n            className=\\\"hover:text-slate-100 transition-colors whitespace-nowrap shrink-0 cursor-pointer\\\"\\n          >\\n            {t.navGrid}\\n          </button>\\n          <button\\n            type=\\\"button\\\"\\n            onClick={() => {\\n              setIsFlipped(true);\\n              handleAddToHomeScreenClick();\\n            }}\\n            className=\\\"hover:text-slate-100 transition-colors whitespace-nowrap shrink-0 cursor-pointer\\\"\\n          >\\n            {t.navPwa}\\n          </button>\\n          <button\\n            type=\\\"button\\\"\\n            onClick={() =>\\n              setViewMode((prev) =>\\n                prev === \'dashboard\' ? \'split\' : \'dashboard\'\\n              )\\n            }\\n            className=\\\"hover:text-slate-100 transition-colors whitespace-nowrap shrink-0 cursor-pointer\\\"\\n          >\\n            {t.navB2B}\\n          </button>\\n        </nav>\\n\\n        <div className=\\\"flex items-center gap-3 shrink-0\\\">\\n          <button\\n            type=\\\"button\\\"\\n            onClick={() => updateCustomerStamps(activeCustomer.id, 1)}\\n            className=\\\"px-4 py-2 text-xs font-semibold text-slate-950 bg-amber-400 hover:bg-amber-300 rounded-lg transition-colors whitespace-nowrap shrink-0 cursor-pointer\\\"\\n          >\\n            {t.ctaIssueStamp}\\n          </button>\\n        </div>\\n      </header>\\n\\n      {/* Workspace Control Bar (Below the Top Bar) */}\\n      <div className=\\\"border-b border-slate-800/60 bg-[#0F1218]\\\">\\n        <div className=\\\"max-w-7xl mx-auto px-6 lg:px-10 py-3 flex flex-wrap items-center justify-between gap-4\\\">\\n          {/* Clean Unboxed Metadata showing Anonymous LocalStorage Status */}\\n          <div className=\\\"flex flex-wrap items-center gap-2 text-xs text-slate-400\\\">\\n            <span className=\\\"text-slate-200 font-medium\\\">\\n              {activeDisplayName}\\n            </span>\\n            <span aria-hidden=\\\"true\\\">\302\267</span>\\n            <span className=\\\"font-mono tabular-nums text-amber-300/95 font-semibold\\\">\\n              {activeCustomer.id}\\n            </span>\\n            <span aria-hidden=\\\"true\\\">\302\267</span>\\n            <span className=\\\"font-mono tabular-nums\\\">\\n              {activeCustomer.currentStamps} / {MAX_STAMPS} {t.stampsActive}\\n            </span>\\n            {activeCustomer.isLocalDevice && (\\n              <>\\n                <span aria-hidden=\\\"true\\\">\302\267</span>\\n                <span className=\\\"text-emerald-400/90\\\">\\n                  {t.localSavedBadge}\\n                </span>\\n              </>\\n            )}\\n          </div>\\n\\n          {/* Interactive Language Selector, Workspace Mode Toggles & Single-File HTML Export */}\\n          <div className=\\\"flex flex-wrap items-center gap-2.5\\\">\\n            <div\\n              role=\\\"group\\\"\\n              aria-label=\\\"Pilihan Bahasa / Language Selector\\\"\\n              className=\\\"flex items-center gap-1 p-1 bg-slate-900 border border-slate-800 rounded-lg\\\"\\n            >\\n              <Globe className=\\\"w-3.5 h-3.5 text-amber-400 ml-1.5 mr-0.5 shrink-0\\\" />\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => {\\n                  setLang(\'id\');\\n                  triggerToast(TRANSLATIONS.id.toastLangChanged);\\n                }}\\n                className={`px-2.5 py-1 text-xs font-semibold rounded-md transition-colors whitespace-nowrap shrink-0 cursor-pointer ${\\n                  lang === \'id\'\\n                    ? \'bg-amber-400 text-slate-950 shadow-xs\'\\n                    : \'text-slate-400 hover:text-slate-200\'\\n                }`}\\n              >\\n                ID \302\267 Indonesia\\n              </button>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => {\\n                  setLang(\'en\');\\n                  triggerToast(TRANSLATIONS.en.toastLangChanged);\\n                }}\\n                className={`px-2.5 py-1 text-xs font-semibold rounded-md transition-colors whitespace-nowrap shrink-0 cursor-pointer ${\\n                  lang === \'en\'\\n                    ? \'bg-amber-400 text-slate-950 shadow-xs\'\\n                    : \'text-slate-400 hover:text-slate-200\'\\n                }`}\\n              >\\n                EN \302\267 English\\n              </button>\\n            </div>\\n\\n            <div\\n              role=\\\"group\\\"\\n              aria-label=\\\"Workspace View Mode\\\"\\n              className=\\\"flex items-center gap-1 p-1 bg-slate-900 border border-slate-800 rounded-lg\\\"\\n            >\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => setViewMode(\'split\')}\\n                className={`px-3 py-1 text-xs font-medium rounded-md transition-colors whitespace-nowrap shrink-0 cursor-pointer ${\\n                  viewMode === \'split\'\\n                    ? \'bg-slate-800 text-slate-100 shadow-xs\'\\n                    : \'text-slate-400 hover:text-slate-200\'\\n                }`}\\n              >\\n                {t.modeSplit}\\n              </button>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => setViewMode(\'pass\')}\\n                className={`px-3 py-1 text-xs font-medium rounded-md transition-colors whitespace-nowrap shrink-0 cursor-pointer ${\\n                  viewMode === \'pass\'\\n                    ? \'bg-slate-800 text-slate-100 shadow-xs\'\\n                    : \'text-slate-400 hover:text-slate-200\'\\n                }`}\\n              >\\n                {t.modePass}\\n              </button>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => setViewMode(\'dashboard\')}\\n                className={`px-3 py-1 text-xs font-medium rounded-md transition-colors whitespace-nowrap shrink-0 cursor-pointer ${\\n                  viewMode === \'dashboard\'\\n                    ? \'bg-slate-800 text-slate-100 shadow-xs\'\\n                    : \'text-slate-400 hover:text-slate-200\'\\n                }`}\\n              >\\n                {t.modeDashboard}\\n              </button>\\n            </div>\\n\\n            <button\\n              type=\\\"button\\\"\\n              onClick={handleDownloadSingleFileHtml}\\n              className=\\\"hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-slate-300 hover:text-white bg-slate-900 hover:bg-slate-800 border border-slate-800 rounded-lg transition-colors whitespace-nowrap shrink-0 cursor-pointer\\\"\\n              title={t.exportHtml}\\n            >\\n              <Download className=\\\"w-3.5 h-3.5 text-amber-400\\\" />\\n              <span>{t.exportHtml}</span>\\n            </button>\\n          </div>\\n        </div>\\n      </div>\\n\\n      {/* Main Content Container */}\\n      <main\\n        id=\\\"top\\\"\\n        className=\\\"flex-1 max-w-7xl w-full mx-auto px-6 lg:px-10 py-8 pb-44 space-y-12\\\"\\n      >\\n        {/* SECTION 1: 3D CUSTOM DESIGN LOYALTY CARD & INTERACTIVE TELEMETRY */}\\n        {viewMode !== \'dashboard\' && (\\n          <section className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch\\\">\\n            {/* Left 7 Columns: 3D Floating Card Stage */}\\n            <div\\n              ref={cardStageRef}\\n              onPointerMove={handleStagePointerMove}\\n              onPointerLeave={handleStagePointerLeave}\\n              className=\\\"lg:col-span-7 relative rounded-2xl bg-[#11151E] border border-slate-800/80 p-6 sm:p-10 flex flex-col items-center justify-between min-h-[460px] select-none overflow-hidden\\\"\\n            >\\n              {/* Subtle Ambient Stage Illumination matching Sissi Heritage warm olive & cream */}\\n              <div\\n                aria-hidden=\\\"true\\\"\\n                className=\\\"pointer-events-none absolute -top-28 left-1/2 -translate-x-1/2 w-[480px] h-[260px] rounded-full opacity-25 blur-3xl\\\"\\n                style={{\\n                  background:\\n                    \'radial-gradient(circle, rgba(239,229,209,0.32) 0%, rgba(74,73,40,0.35) 55%, transparent 80%)\',\\n                }}\\n              />\\n\\n              {/* Top Stage Bar */}\\n              <div className=\\\"w-full flex items-center justify-between gap-4 z-10\\\">\\n                <div className=\\\"text-xs text-slate-400 flex items-center gap-2\\\">\\n                  <span className=\\\"font-medium text-slate-200\\\">\\n                    {isFlipped ? t.stageBackLabel : t.stageFrontLabel}\\n                  </span>\\n                  <span aria-hidden=\\\"true\\\">\302\267</span>\\n                  <span className=\\\"font-mono tabular-nums text-slate-400\\\">\\n                    {t.tiltLabel} {tilt.rx.toFixed(1)}\302\260 / {tilt.ry.toFixed(1)}\302\260\\n                  </span>\\n                </div>\\n\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => setIsFlipped((prev) => !prev)}\\n                  className=\\\"inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium bg-slate-800/90 hover:bg-slate-700 text-slate-100 border border-slate-700 transition-colors whitespace-nowrap shrink-0 cursor-pointer min-h-[36px]\\\"\\n                >\\n                  <RotateCw className=\\\"w-3.5 h-3.5 text-amber-400\\\" />\\n                  <span>{isFlipped ? t.flipToFront : t.flipToBack}</span>\\n                </button>\\n              </div>\\n\\n              {/* Centerpiece: Continuous Floating Wrapper -> DeviceOrientation 3D Tilt -> 3D Flip Card */}\\n              <div className=\\\"my-8 w-full flex items-center justify-center z-10 perspective-stage\\\">\\n                <div className=\\\"metal-card-floating w-full max-w-[480px]\\\">\\n                  <div\\n                    role=\\\"button\\\"\\n                    tabIndex={0}\\n                    aria-label={t.cardAriaLabel}\\n                    onClick={() => setIsFlipped((prev) => !prev)}\\n                    onKeyDown={(e) => {\\n                      if (e.key === \'Enter\' || e.key === \' \') {\\n                        e.preventDefault();\\n                        setIsFlipped((prev) => !prev);\\n                      }\\n                    }}\\n                    className=\\\"card-3d-tilt w-full aspect-[2769/1742] cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-400 rounded-[20px]\\\"\\n                    style={{\\n                      transform: `rotateX(${tilt.rx}deg) rotateY(${tilt.ry}deg)`,\\n                    }}\\n                  >\\n                    <div\\n                      className={`card-3d-flipper ${isFlipped ? \'is-flipped\' : \'\'}`}\\n                    >\\n                      {/* ================= CARD FRONT FACE (/kartu-depan.png) ================= */}\\n                      <div\\n                        aria-hidden={isFlipped}\\n                        className={`card-face-plane card-face-front-plane transition-opacity duration-200 ${\\n                          isFlipped\\n                            ? \'opacity-0 pointer-events-none delay-150\'\\n                            : \'opacity-100 delay-75\'\\n                        }`}\\n                      >\\n                        <div className=\\\"card-surface-shell bg-[#4A4928]\\\">\\n                          {/* Custom Front Face Background Asset */}\\n                          <img\\n                            src=\\\"/kartu-depan.png\\\"\\n                            alt=\\\"Sissi Heritage Loyalty Card Front\\\"\\n                            className=\\\"absolute inset-0 w-full h-full object-cover pointer-events-none select-none\\\"\\n                          />\\n\\n                          {/* Dynamic Holographic Foil Overlay on top of /kartu-depan.png */}\\n                          <div\\n                            aria-hidden=\\\"true\\\"\\n                            className=\\\"holographic-sheen pointer-events-none absolute inset-0 opacity-80 z-20\\\"\\n                          />\\n\\n                          {/* Dynamic Specular Glare following DeviceOrientation / Gyroscope */}\\n                          <div\\n                            aria-hidden=\\\"true\\\"\\n                            className=\\\"pointer-events-none absolute inset-0 transition-opacity duration-200 z-20\\\"\\n                            style={{\\n                              background: `radial-gradient(circle at ${tilt.gx}% ${tilt.gy}%, rgba(255, 255, 255, 0.28) 0%, rgba(251, 191, 36, 0.10) 30%, transparent 64%)`,\\n                            }}\\n                          />\\n                        </div>\\n                      </div>\\n\\n                      {/* ================= CARD BACK FACE (/kartu-belakang-kosong.png + 8 Stamp Grid + QR) ================= */}\\n                      <div\\n                        aria-hidden={!isFlipped}\\n                        className={`card-face-plane card-face-back-plane transition-opacity duration-200 ${\\n                          isFlipped\\n                            ? \'opacity-100 delay-75\'\\n                            : \'opacity-0 pointer-events-none delay-150\'\\n                        }`}\\n                      >\\n                        <div className=\\\"card-surface-shell bg-[#EFE5D1]\\\">\\n                          {/* Custom Back Face Base Asset (/kartu-belakang-kosong.png) */}\\n                          <img\\n                            src=\\\"/kartu-belakang-kosong.png\\\"\\n                            alt=\\\"Sissi Heritage Loyalty Card Back\\\"\\n                            className=\\\"absolute inset-0 w-full h-full object-cover pointer-events-none select-none\\\"\\n                          />\\n\\n                          {/* Top-Right Anonymous Customer ID Badge */}\\n                          <div className=\\\"absolute top-[7.5%] right-[5.5%] z-10 pointer-events-none\\\">\\n                            <span className=\\\"font-mono tabular-nums text-[10px] sm:text-xs font-semibold text-[#4A4928]/85 tracking-wider\\\">\\n                              ID \302\267 {activeCustomer.id}\\n                            </span>\\n                          </div>\\n\\n                          {/* =========================================================\\n                              8-STAMP CSS GRID OVERLAY\\n                              Matches the exact visual placement of the 8 empty circles\\n                              on /kartu-belakang-kosong.png:\\n                              - Bounding box: left 14.45%, top 31.06%, width 71.07%, height 44.20%\\n                              - 5 columns x 2 rows (Row 1: cols 1..5, Row 2: cols 2..4)\\n                          ========================================================= */}\\n                          <div\\n                            className=\\\"absolute z-10 grid grid-cols-5 grid-rows-2 overflow-visible\\\"\\n                            style={{\\n                              left: \'14.45%\',\\n                              top: \'31.06%\',\\n                              width: \'71.07%\',\\n                              height: \'44.20%\',\\n                              columnGap: \'4.15%\',\\n                              rowGap: \'14.80%\',\\n                            }}\\n                          >\\n                            {STAMP_SLOTS.map((slot, index) => {\\n                              const isStamped =\\n                                slot.index <= activeCustomer.currentStamps;\\n                              const stampSrc =\\n                                index % 2 === 0\\n                                  ? \'/stamp-roti.png\'\\n                                  : \'/stamp-kopi.png\';\\n                              return (\\n                                <button\\n                                  key={slot.index}\\n                                  type=\\\"button\\\"\\n                                  onClick={(e) =>\\n                                    setExactStampCount(\\n                                      activeCustomer.id,\\n                                      slot.index,\\n                                      e\\n                                    )\\n                                  }\\n                                  title={`${t.toggleStampTitle}${slot.index}`}\\n                                  aria-label={`Stamp circle ${slot.index}`}\\n                                  className={`${slot.gridClass} relative w-full h-full rounded-full overflow-visible p-[8%] flex items-center justify-center cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-[#4A4928] transition-transform active:scale-95`}\\n                                >\\n                                  {isStamped && (\\n                                    <div className=\\\"w-full h-full flex items-center justify-center overflow-visible\\\">\\n                                      <img\\n                                        src={stampSrc}\\n                                        alt={`Stamp ${slot.index}`}\\n                                        style={{ objectFit: \'contain\' }}\\n                                        className=\\\"w-full h-full max-w-full max-h-full object-contain pointer-events-none select-none transition-all duration-300 scale-100 block\\\"\\n                                      />\\n                                    </div>\\n                                  )}\\n                                </button>\\n                              );\\n                            })}\\n                          </div>\\n\\n                          {/* =========================================================\\n                              DYNAMIC <img /> QR CODE OVERLAY\\n                              Positioned strictly inside the white \'TEMPAT QR CODE\'\\n                              bounding box at bottom-right of /kartu-belakang-kosong.png:\\n                              left: 79.75%, top: 68.85%, width: 17.02%, height: 27.10%\\n                          ========================================================= */}\\n                          <div\\n                            onClick={(e) => e.stopPropagation()}\\n                            title={`https://api.merchant-system.com/scan?id=${activeCustomer.id}`}\\n                            className=\\\"absolute z-10 bg-white flex items-center justify-center p-[1.2%] overflow-hidden\\\"\\n                            style={{\\n                              left: \'79.75%\',\\n                              top: \'68.85%\',\\n                              width: \'17.02%\',\\n                              height: \'27.10%\',\\n                              borderRadius: \'14%\',\\n                            }}\\n                          >\\n                            <img\\n                              src={`https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=${encodeURIComponent(\\n                                \'https://api.merchant-system.com/scan?id=\' +\\n                                  activeCustomer.id\\n                              )}`}\\n                              alt=\\\"QR Code\\\"\\n                              referrerPolicy=\\\"no-referrer\\\"\\n                              className=\\\"w-full h-full object-contain block\\\"\\n                            />\\n                          </div>\\n\\n                          {/* Holographic & Specular Overlays on top of /kartu-belakang-kosong.png */}\\n                          <div\\n                            aria-hidden=\\\"true\\\"\\n                            className=\\\"holographic-sheen pointer-events-none absolute inset-0 opacity-70 z-20\\\"\\n                          />\\n                          <div\\n                            aria-hidden=\\\"true\\\"\\n                            className=\\\"pointer-events-none absolute inset-0 z-20\\\"\\n                            style={{\\n                              background: `radial-gradient(circle at ${100 - tilt.gx}% ${tilt.gy}%, rgba(255, 255, 255, 0.26) 0%, transparent 60%)`,\\n                            }}\\n                          />\\n                        </div>\\n                      </div>\\n                    </div>\\n                  </div>\\n                </div>\\n              </div>\\n\\n              {/* Bottom Stage Helper Bar */}\\n              <div className=\\\"w-full flex flex-wrap items-center justify-between gap-3 pt-3 border-t border-slate-800/80 text-xs text-slate-400 z-10\\\">\\n                <span>{t.stageFooterHint}</span>\\n                <span className=\\\"font-mono tabular-nums text-amber-300\\\">\\n                  {isFlipped ? t.drawerActiveBelow : t.flipForWalletActions}\\n                </span>\\n              </div>\\n            </div>\\n\\n            {/* Right 5 Columns: Interactive Pass Controls & DeviceOrientation Gyro Simulator */}\\n            <div className=\\\"lg:col-span-5 rounded-2xl bg-[#11151E] border border-slate-800/80 p-6 flex flex-col justify-between space-y-6\\\">\\n              <div className=\\\"space-y-5\\\">\\n                <div className=\\\"flex items-center justify-between border-b border-slate-800 pb-4\\\">\\n                  <div>\\n                    <h1 className=\\\"text-lg font-bold text-slate-100\\\">\\n                      {t.studioTitle}\\n                    </h1>\\n                    <p className=\\\"text-xs text-slate-400 mt-0.5\\\">\\n                      {t.studioSubtitle}\\n                    </p>\\n                  </div>\\n                  <button\\n                    type=\\\"button\\\"\\n                    onClick={requestGyroPermission}\\n                    className=\\\"inline-flex items-center gap-1.5 px-3 py-2 rounded-lg text-xs font-medium bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 transition-colors cursor-pointer whitespace-nowrap shrink-0\\\"\\n                  >\\n                    <Smartphone className=\\\"w-3.5 h-3.5 text-amber-400\\\" />\\n                    <span>\\n                      {gyroStatus === \'active\'\\n                        ? t.gyroLinked\\n                        : t.pairMotionSensor}\\n                    </span>\\n                  </button>\\n                </div>\\n\\n                {/* Anonymous LocalStorage Pass Indicator + Profile Switcher */}\\n                <div className=\\\"space-y-2\\\">\\n                  <div className=\\\"flex items-center justify-between text-xs\\\">\\n                    <label\\n                      htmlFor=\\\"member-select\\\"\\n                      className=\\\"font-medium text-slate-300\\\"\\n                    >\\n                      {t.activeCardholderProfile}\\n                    </label>\\n                    <span className=\\\"font-mono tabular-nums text-[11px] text-emerald-400 flex items-center gap-1\\\">\\n                      <HardDrive className=\\\"w-3 h-3\\\" />\\n                      <span>localStorage: {localCustomerId}</span>\\n                    </span>\\n                  </div>\\n                  <div className=\\\"relative\\\">\\n                    <select\\n                      id=\\\"member-select\\\"\\n                      value={selectedCustomerId}\\n                      onChange={(e) => setSelectedCustomerId(e.target.value)}\\n                      className=\\\"w-full h-11 pl-3.5 pr-9 rounded-xl bg-slate-900 border border-slate-800 text-sm text-slate-100 focus:outline-none focus:border-amber-400 appearance-none cursor-pointer\\\"\\n                    >\\n                      {customers.map((c) => (\\n                        <option key={c.id} value={c.id}>\\n                          {c.isLocalDevice ? t.localDeviceMemberName : c.name} \342\200\224{\' \'}\\n                          {c.id} ({c.currentStamps}/{MAX_STAMPS} {t.stampsWord})\\n                        </option>\\n                      ))}\\n                    </select>\\n                    <ChevronDown className=\\\"w-4 h-4 text-slate-400 pointer-events-none absolute right-3.5 top-1/2 -translate-y-1/2\\\" />\\n                  </div>\\n                </div>\\n\\n                {/* Stamp Issuance & Redemption Controls (8 Stamps) */}\\n                <div className=\\\"space-y-2.5 pt-1\\\">\\n                  <div className=\\\"flex items-center justify-between text-xs\\\">\\n                    <span className=\\\"text-slate-300 font-medium\\\">\\n                      {t.stampProgress} ({activeCustomer.currentStamps} /{\' \'}\\n                      {MAX_STAMPS})\\n                    </span>\\n                    <span className=\\\"font-mono tabular-nums text-slate-400\\\">\\n                      {t.lifetimeRedeemed}: {activeCustomer.totalRedeemedStamps}\\n                    </span>\\n                  </div>\\n\\n                  {/* Clean Segmented 8-Stamp Progress Bar */}\\n                  <div className=\\\"grid grid-cols-8 gap-1.5 h-2.5\\\">\\n                    {Array.from({ length: MAX_STAMPS }, (_, idx) => (\\n                      <div\\n                        key={idx}\\n                        className={`rounded-sm transition-colors ${\\n                          idx < activeCustomer.currentStamps\\n                            ? \'bg-amber-400\'\\n                            : \'bg-slate-800\'\\n                        }`}\\n                      />\\n                    ))}\\n                  </div>\\n\\n                  <div className=\\\"grid grid-cols-3 gap-2.5 pt-2\\\">\\n                    <button\\n                      type=\\\"button\\\"\\n                      onClick={() => updateCustomerStamps(activeCustomer.id, -1)}\\n                      disabled={activeCustomer.currentStamps <= 0}\\n                      className=\\\"h-11 rounded-xl bg-slate-900 hover:bg-slate-800 disabled:opacity-40 border border-slate-800 text-xs font-medium text-slate-200 flex items-center justify-center gap-1.5 transition-colors cursor-pointer\\\"\\n                    >\\n                      <Minus className=\\\"w-3.5 h-3.5\\\" />\\n                      <span>{t.btnRemove}</span>\\n                    </button>\\n\\n                    <button\\n                      type=\\\"button\\\"\\n                      onClick={() => {\\n                        updateCustomerStamps(activeCustomer.id, 1);\\n                        if (!isFlipped) setIsFlipped(true);\\n                      }}\\n                      disabled={activeCustomer.currentStamps >= MAX_STAMPS}\\n                      className=\\\"h-11 rounded-xl bg-slate-800 hover:bg-slate-700 disabled:opacity-40 border border-slate-700 text-xs font-semibold text-amber-300 flex items-center justify-center gap-1.5 transition-colors cursor-pointer\\\"\\n                    >\\n                      <Plus className=\\\"w-3.5 h-3.5\\\" />\\n                      <span>{t.btnStampPlus}</span>\\n                    </button>\\n\\n                    <button\\n                      type=\\\"button\\\"\\n                      onClick={() => redeemCustomerReward(activeCustomer.id)}\\n                      className={`h-11 rounded-xl text-xs font-semibold flex items-center justify-center gap-1.5 transition-colors cursor-pointer ${\\n                        activeCustomer.currentStamps === MAX_STAMPS\\n                          ? \'bg-amber-400 hover:bg-amber-300 text-slate-950 shadow-md shadow-amber-500/10\'\\n                          : \'bg-slate-900 text-slate-500 border border-slate-800\'\\n                      }`}\\n                    >\\n                      <Award className=\\\"w-3.5 h-3.5\\\" />\\n                      <span>{t.btnRedeemAll}</span>\\n                    </button>\\n                  </div>\\n                </div>\\n\\n                {/* DeviceOrientation Tilt Calibration Sliders */}\\n                <div className=\\\"space-y-3 pt-4 border-t border-slate-800\\\">\\n                  <div className=\\\"flex items-center justify-between\\\">\\n                    <span className=\\\"text-xs font-medium text-slate-300 flex items-center gap-1.5\\\">\\n                      <Sliders className=\\\"w-3.5 h-3.5 text-amber-400\\\" />\\n                      <span>{t.gyroSimulatorTitle}</span>\\n                    </span>\\n                    <button\\n                      type=\\\"button\\\"\\n                      onClick={() => {\\n                        setGyroStatus(\'idle\');\\n                        setTilt({ rx: 0, ry: 0, gx: 50, gy: 50 });\\n                      }}\\n                      className=\\\"text-xs text-slate-400 hover:text-slate-200 cursor-pointer\\\"\\n                    >\\n                      {t.resetAxis}\\n                    </button>\\n                  </div>\\n\\n                  <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-3\\\">\\n                    <div className=\\\"space-y-1\\\">\\n                      <div className=\\\"flex justify-between text-[11px] text-slate-400\\\">\\n                        <span>{t.pitchLabel}</span>\\n                        <span className=\\\"font-mono tabular-nums\\\">{tilt.rx}\302\260</span>\\n                      </div>\\n                      <input\\n                        type=\\\"range\\\"\\n                        min={-24}\\n                        max={24}\\n                        step={1}\\n                        value={tilt.rx}\\n                        onChange={(e) => {\\n                          const rx = Number(e.target.value);\\n                          setGyroStatus(\'simulated\');\\n                          setTilt((prev) => ({\\n                            ...prev,\\n                            rx,\\n                            gy: Math.round(50 - (rx / 24) * 40),\\n                          }));\\n                        }}\\n                        className=\\\"w-full accent-amber-400 cursor-pointer\\\"\\n                      />\\n                    </div>\\n\\n                    <div className=\\\"space-y-1\\\">\\n                      <div className=\\\"flex justify-between text-[11px] text-slate-400\\\">\\n                        <span>{t.rollLabel}</span>\\n                        <span className=\\\"font-mono tabular-nums\\\">{tilt.ry}\302\260</span>\\n                      </div>\\n                      <input\\n                        type=\\\"range\\\"\\n                        min={-24}\\n                        max={24}\\n                        step={1}\\n                        value={tilt.ry}\\n                        onChange={(e) => {\\n                          const ry = Number(e.target.value);\\n                          setGyroStatus(\'simulated\');\\n                          setTilt((prev) => ({\\n                            ...prev,\\n                            ry,\\n                            gx: Math.round(50 + (ry / 24) * 40),\\n                          }));\\n                        }}\\n                        className=\\\"w-full accent-amber-400 cursor-pointer\\\"\\n                      />\\n                    </div>\\n                  </div>\\n                </div>\\n              </div>\\n\\n              {/* Flip Action CTA */}\\n              <div className=\\\"pt-4 border-t border-slate-800 flex items-center justify-between gap-3\\\">\\n                <div className=\\\"text-xs text-slate-400\\\">\\n                  {isFlipped ? t.drawerHintOpen : t.drawerHintClosed}\\n                </div>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => setIsFlipped((prev) => !prev)}\\n                  className=\\\"px-4 py-2.5 rounded-xl bg-slate-100 hover:bg-white text-slate-950 text-xs font-semibold transition-colors whitespace-nowrap shrink-0 cursor-pointer\\\"\\n                >\\n                  {isFlipped ? t.showFrontFace : t.flipAndOpenDrawer}\\n                </button>\\n              </div>\\n            </div>\\n          </section>\\n        )}\\n\\n        {/* SECTION 2: TOGGLEABLE B2B MERCHANT DASHBOARD */}\\n        {viewMode !== \'pass\' && (\\n          <section\\n            aria-label={t.b2bTitle}\\n            className=\\\"rounded-2xl bg-[#11151E] border border-slate-800/80 p-6 sm:p-8 space-y-6\\\"\\n          >\\n            {/* Dashboard Header */}\\n            <div className=\\\"flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-800 pb-6\\\">\\n              <div>\\n                <h2 className=\\\"text-xl font-bold text-slate-100\\\">{t.b2bTitle}</h2>\\n                <p className=\\\"text-sm text-slate-400 mt-1\\\">{t.b2bSubtitle}</p>\\n              </div>\\n            </div>\\n\\n            {/* Clean Unboxed KPI Strip */}\\n            <div className=\\\"grid grid-cols-2 lg:grid-cols-4 gap-6 py-2 border-b border-slate-800/80 pb-6\\\">\\n              <div>\\n                <div className=\\\"text-xs text-slate-400\\\">{t.kpiRegistered}</div>\\n                <div className=\\\"text-2xl font-bold font-mono tabular-nums text-slate-100 mt-1\\\">\\n                  {b2bStats.totalMembers}\\n                </div>\\n              </div>\\n              <div>\\n                <div className=\\\"text-xs text-slate-400\\\">{t.kpiTotalRedeemed}</div>\\n                <div className=\\\"text-2xl font-bold font-mono tabular-nums text-amber-400 mt-1\\\">\\n                  {b2bStats.totalRedeemed}\\n                </div>\\n              </div>\\n              <div>\\n                <div className=\\\"text-xs text-slate-400\\\">\\n                  {t.kpiActiveUnredeemed}\\n                </div>\\n                <div className=\\\"text-2xl font-bold font-mono tabular-nums text-slate-100 mt-1\\\">\\n                  {b2bStats.activeStamps}\\n                </div>\\n              </div>\\n              <div>\\n                <div className=\\\"text-xs text-slate-400\\\">{t.kpiRewardsReady}</div>\\n                <div className=\\\"text-2xl font-bold font-mono tabular-nums text-emerald-400 mt-1\\\">\\n                  {b2bStats.readyCount}\\n                </div>\\n              </div>\\n            </div>\\n\\n            {/* Search & Filter Controls */}\\n            <div className=\\\"flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4\\\">\\n              <div className=\\\"relative flex-1 max-w-md\\\">\\n                <Search className=\\\"w-4 h-4 text-slate-500 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none\\\" />\\n                <input\\n                  type=\\\"search\\\"\\n                  value={searchQuery}\\n                  onChange={(e) => setSearchQuery(e.target.value)}\\n                  placeholder={t.searchPlaceholder}\\n                  className=\\\"w-full h-10 pl-10 pr-4 rounded-xl bg-slate-900 border border-slate-800 text-sm text-slate-100 placeholder:text-slate-500 focus:outline-none focus:border-amber-400\\\"\\n                />\\n              </div>\\n\\n              <div className=\\\"flex items-center gap-1 p-1 bg-slate-900 border border-slate-800 rounded-lg self-start\\\">\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => setTableFilter(\'all\')}\\n                  className={`px-3 py-1.5 text-xs font-medium rounded-md transition-colors whitespace-nowrap shrink-0 cursor-pointer ${\\n                    tableFilter === \'all\'\\n                      ? \'bg-slate-800 text-slate-100\'\\n                      : \'text-slate-400 hover:text-slate-200\'\\n                  }`}\\n                >\\n                  {t.filterAll}\\n                </button>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => setTableFilter(\'ready\')}\\n                  className={`px-3 py-1.5 text-xs font-medium rounded-md transition-colors whitespace-nowrap shrink-0 cursor-pointer ${\\n                    tableFilter === \'ready\'\\n                      ? \'bg-slate-800 text-slate-100\'\\n                      : \'text-slate-400 hover:text-slate-200\'\\n                  }`}\\n                >\\n                  {t.filterReady}\\n                </button>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => setTableFilter(\'vip\')}\\n                  className={`px-3 py-1.5 text-xs font-medium rounded-md transition-colors whitespace-nowrap shrink-0 cursor-pointer ${\\n                    tableFilter === \'vip\'\\n                      ? \'bg-slate-800 text-slate-100\'\\n                      : \'text-slate-400 hover:text-slate-200\'\\n                  }`}\\n                >\\n                  {t.filterVip}\\n                </button>\\n              </div>\\n            </div>\\n\\n            {/* B2B Customer Data Table */}\\n            <div className=\\\"overflow-x-auto border border-slate-800 rounded-xl\\\">\\n              <table className=\\\"w-full text-left border-collapse\\\">\\n                <thead>\\n                  <tr className=\\\"border-b border-slate-800 bg-slate-900/70 text-[12px] font-semibold text-slate-400\\\">\\n                    <th className=\\\"py-3.5 px-4\\\">{t.thCustomerName}</th>\\n                    <th className=\\\"py-3.5 px-4\\\">{t.thCustomerId}</th>\\n                    <th className=\\\"py-3.5 px-4\\\">{t.thActiveGrid}</th>\\n                    <th className=\\\"py-3.5 px-4 text-right\\\">\\n                      {t.thTotalRedeemed}\\n                    </th>\\n                    <th className=\\\"py-3.5 px-4 text-right\\\">\\n                      {t.thMerchantActions}\\n                    </th>\\n                  </tr>\\n                </thead>\\n                <tbody className=\\\"divide-y divide-slate-800/70 text-sm\\\">\\n                  {filteredCustomers.length === 0 ? (\\n                    <tr>\\n                      <td\\n                        colSpan={5}\\n                        className=\\\"py-10 text-center text-slate-400 text-sm\\\"\\n                      >\\n                        {t.noRecordsMatch} &ldquo;{searchQuery}&rdquo;.\\n                      </td>\\n                    </tr>\\n                  ) : (\\n                    filteredCustomers.map((customer) => {\\n                      const isSelected = customer.id === activeCustomer.id;\\n                      const displayName = customer.isLocalDevice\\n                        ? t.localDeviceMemberName\\n                        : customer.name;\\n                      return (\\n                        <tr\\n                          key={customer.id}\\n                          onClick={() => setSelectedCustomerId(customer.id)}\\n                          className={`transition-colors cursor-pointer ${\\n                            isSelected\\n                              ? \'bg-amber-400/[0.06] hover:bg-amber-400/[0.09]\'\\n                              : \'hover:bg-slate-900/60\'\\n                          }`}\\n                        >\\n                          <td className=\\\"py-3.5 px-4\\\">\\n                            <div className=\\\"font-semibold text-slate-100 flex items-center gap-2\\\">\\n                              <span>{displayName}</span>\\n                              {isSelected && (\\n                                <span className=\\\"text-[11px] font-normal text-amber-300\\\">\\n                                  {t.activeOn3dCard}\\n                                </span>\\n                              )}\\n                            </div>\\n                            <div className=\\\"text-xs text-slate-400\\\">\\n                              {customer.isLocalDevice\\n                                ? `${t.localDeviceTag} \302\267 ${customer.email}`\\n                                : `${customer.email} \302\267 ${customer.tier}`}\\n                            </div>\\n                          </td>\\n\\n                          <td className=\\\"py-3.5 px-4 font-mono tabular-nums text-xs text-slate-200\\\">\\n                            {customer.id}\\n                          </td>\\n\\n                          <td className=\\\"py-3.5 px-4\\\">\\n                            <div className=\\\"flex items-center gap-2.5\\\">\\n                              <span className=\\\"font-mono tabular-nums text-xs text-slate-300 w-12\\\">\\n                                {customer.currentStamps} / {MAX_STAMPS}\\n                              </span>\\n                              <div className=\\\"w-24 h-2 rounded-full bg-slate-800 overflow-hidden\\\">\\n                                <div\\n                                  className={`h-full transition-all ${\\n                                    customer.currentStamps === MAX_STAMPS\\n                                      ? \'bg-emerald-400\'\\n                                      : \'bg-amber-400\'\\n                                  }`}\\n                                  style={{\\n                                    width: `${\\n                                      (customer.currentStamps / MAX_STAMPS) * 100\\n                                    }%`,\\n                                  }}\\n                                />\\n                              </div>\\n                            </div>\\n                          </td>\\n\\n                          <td className=\\\"py-3.5 px-4 text-right font-mono tabular-nums font-semibold text-slate-100\\\">\\n                            {customer.totalRedeemedStamps}\\n                          </td>\\n\\n                          <td\\n                            className=\\\"py-3.5 px-4 text-right\\\"\\n                            onClick={(e) => e.stopPropagation()}\\n                          >\\n                            <div className=\\\"inline-flex items-center justify-end gap-2\\\">\\n                              <button\\n                                type=\\\"button\\\"\\n                                onClick={() =>\\n                                  updateCustomerStamps(customer.id, 1)\\n                                }\\n                                disabled={customer.currentStamps >= MAX_STAMPS}\\n                                className=\\\"px-2.5 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 disabled:opacity-40 text-xs font-medium text-slate-200 transition-colors cursor-pointer whitespace-nowrap\\\"\\n                              >\\n                                {t.btnStampPlus}\\n                              </button>\\n                              <button\\n                                type=\\\"button\\\"\\n                                onClick={() =>\\n                                  redeemCustomerReward(customer.id)\\n                                }\\n                                disabled={customer.currentStamps < MAX_STAMPS}\\n                                className={`px-2.5 py-1.5 rounded-lg text-xs font-semibold transition-colors cursor-pointer whitespace-nowrap ${\\n                                  customer.currentStamps === MAX_STAMPS\\n                                    ? \'bg-amber-400 hover:bg-amber-300 text-slate-950\'\\n                                    : \'bg-slate-900 text-slate-500 border border-slate-800 opacity-50\'\\n                                }`}\\n                              >\\n                                {t.btnRedeemAll}\\n                              </button>\\n                            </div>\\n                          </td>\\n                        </tr>\\n                      );\\n                    })\\n                  )}\\n                </tbody>\\n              </table>\\n            </div>\\n          </section>\\n        )}\\n      </main>\\n\\n      {/* =====================================================================\\n          SLIDE-UP ACTION MENU DRAWER\\n          Strictly triggered when the card flips to the back (isFlipped === true)\\n          Contains \'Add to Home Screen\' (PWA shortcut) and \'Email Backup\'\\n      ===================================================================== */}\\n      <aside\\n        aria-label=\\\"PWA Home Screen and Backup Slide-Up Action Menu\\\"\\n        aria-hidden={!isFlipped}\\n        className={`fixed left-0 right-0 bottom-0 z-40 transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] ${\\n          isFlipped\\n            ? \'translate-y-0 pointer-events-auto\'\\n            : \'translate-y-full pointer-events-none\'\\n        }`}\\n      >\\n        <div className=\\\"max-w-2xl mx-auto px-4\\\">\\n          <div className=\\\"rounded-t-3xl bg-[#141923]/95 backdrop-blur-xl border-t border-x border-slate-700/80 shadow-[0_-20px_50px_rgba(0,0,0,0.75)] px-6 pt-3 pb-6\\\">\\n            {/* Drag Handle Affordance */}\\n            <div className=\\\"w-10 h-1.5 bg-slate-600 rounded-full mx-auto mb-3\\\" />\\n\\n            <div className=\\\"flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-4\\\">\\n              <div className=\\\"flex items-center gap-2 text-xs text-slate-300\\\">\\n                <span className=\\\"font-semibold text-white\\\">\\n                  {t.drawerHeader}\\n                </span>\\n                <span aria-hidden=\\\"true\\\">\302\267</span>\\n                <span className=\\\"font-mono tabular-nums text-amber-300\\\">\\n                  {activeCustomer.id}\\n                </span>\\n                <span aria-hidden=\\\"true\\\">\302\267</span>\\n                <span className=\\\"text-slate-400\\\">\\n                  {activeCustomer.currentStamps}/{MAX_STAMPS} {t.stampsWord}\\n                </span>\\n              </div>\\n\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => setIsFlipped(false)}\\n                className=\\\"text-xs text-slate-400 hover:text-slate-200 self-end sm:self-auto cursor-pointer\\\"\\n              >\\n                {t.flipFrontToDismiss}\\n              </button>\\n            </div>\\n\\n            {/* 2 Action Buttons: \'Add to Home Screen\' (PWA) & \'Email Backup\' */}\\n            <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-3\\\">\\n              <button\\n                type=\\\"button\\\"\\n                onClick={handleAddToHomeScreenClick}\\n                className=\\\"min-h-[50px] px-4 py-3 rounded-xl bg-slate-950 hover:bg-slate-900 text-white border border-slate-700/90 flex items-center justify-center gap-2.5 text-xs font-semibold transition-all active:scale-[0.99] cursor-pointer whitespace-nowrap\\\"\\n              >\\n                <Home className=\\\"w-4 h-4 text-amber-400 shrink-0\\\" />\\n                <span>{t.btnAddToHomeScreen}</span>\\n                {isPwaInstalled && (\\n                  <Check className=\\\"w-3.5 h-3.5 text-emerald-400 ml-1 shrink-0\\\" />\\n                )}\\n              </button>\\n\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() =>\\n                  setActionModal({\\n                    type: \'email\',\\n                    emailInput: activeCustomer.email,\\n                  })\\n                }\\n                className=\\\"min-h-[50px] px-4 py-3 rounded-xl bg-amber-400 hover:bg-amber-300 text-slate-950 flex items-center justify-center gap-2.5 text-xs font-semibold transition-all active:scale-[0.99] cursor-pointer whitespace-nowrap\\\"\\n              >\\n                <Mail className=\\\"w-4 h-4 shrink-0\\\" />\\n                <span>{t.btnEmailBackup}</span>\\n              </button>\\n            </div>\\n          </div>\\n        </div>\\n      </aside>\\n\\n      {/* =====================================================================\\n          INTERACTIVE MODAL FOR \'ADD TO HOME SCREEN\' (PWA) OR \'EMAIL BACKUP\'\\n      ===================================================================== */}\\n      {actionModal.type && (\\n        <div\\n          role=\\\"dialog\\\"\\n          aria-modal=\\\"true\\\"\\n          className=\\\"fixed inset-0 z-50 bg-black/70 backdrop-blur-xs flex items-center justify-center p-4\\\"\\n          onClick={() => setActionModal({ type: null })}\\n        >\\n          <div\\n            className=\\\"w-full max-w-md rounded-2xl bg-[#141923] border border-slate-700 p-6 space-y-5 shadow-2xl\\\"\\n            onClick={(e) => e.stopPropagation()}\\n          >\\n            <div className=\\\"flex items-center justify-between border-b border-slate-800 pb-3\\\">\\n              <h3 className=\\\"text-base font-bold text-slate-100\\\">\\n                {actionModal.type === \'pwa\'\\n                  ? t.modalPwaTitle\\n                  : t.modalEmailTitle}\\n              </h3>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => setActionModal({ type: null })}\\n                className=\\\"p-1 text-slate-400 hover:text-white rounded-lg cursor-pointer\\\"\\n              >\\n                <X className=\\\"w-4 h-4\\\" />\\n              </button>\\n            </div>\\n\\n            {actionModal.type === \'pwa\' ? (\\n              <div className=\\\"space-y-4\\\">\\n                <div className=\\\"p-4 rounded-xl bg-slate-900 border border-slate-800 space-y-2.5 text-xs\\\">\\n                  <div className=\\\"flex items-center gap-3 pb-2 border-b border-slate-800\\\">\\n                    <div className=\\\"w-11 h-11 rounded-xl bg-[#4A4928] border border-amber-200/40 flex items-center justify-center font-bold text-[#EFE5D1] text-base shrink-0\\\">\\n                      sissi\\n                    </div>\\n                    <div>\\n                      <div className=\\\"font-semibold text-slate-100 text-sm\\\">\\n                        Sissi Heritage Loyalty Card\\n                      </div>\\n                      <div className=\\\"text-slate-400 text-[11px]\\\">\\n                        PWA Standalone Shortcut \302\267 /manifest.webmanifest\\n                      </div>\\n                    </div>\\n                  </div>\\n                  <div className=\\\"flex justify-between\\\">\\n                    <span className=\\\"text-slate-400\\\">{t.modalLocalIdLabel}</span>\\n                    <span className=\\\"font-mono tabular-nums text-amber-300 font-semibold\\\">\\n                      {activeCustomer.id}\\n                    </span>\\n                  </div>\\n                  <div className=\\\"flex justify-between\\\">\\n                    <span className=\\\"text-slate-400\\\">{t.modalStorageState}</span>\\n                    <span className=\\\"text-emerald-400 font-medium\\\">\\n                      {t.modalStoragePermanent}\\n                    </span>\\n                  </div>\\n                  <div className=\\\"flex justify-between\\\">\\n                    <span className=\\\"text-slate-400\\\">{t.modalSyncedBalance}</span>\\n                    <span className=\\\"font-mono tabular-nums text-slate-200\\\">\\n                      {activeCustomer.currentStamps} / {MAX_STAMPS}{\' \'}\\n                      {t.stampsWord}\\n                    </span>\\n                  </div>\\n                </div>\\n\\n                <div className=\\\"p-3.5 rounded-xl bg-slate-950/80 border border-slate-800/90 space-y-2 text-xs text-slate-300 leading-relaxed\\\">\\n                  <div className=\\\"font-semibold text-slate-100 flex items-center gap-1.5\\\">\\n                    <Share className=\\\"w-3.5 h-3.5 text-amber-400\\\" />\\n                    <span>{t.pwaInstructionsTitle}</span>\\n                  </div>\\n                  {isIOS ? (\\n                    <div className=\\\"space-y-1 text-slate-300\\\">\\n                      <p>{t.pwaIosStep1}</p>\\n                      <p>{t.pwaIosStep2}</p>\\n                    </div>\\n                  ) : (\\n                    <div className=\\\"space-y-1.5 text-slate-300\\\">\\n                      <p>{t.pwaAndroidStep}</p>\\n                      <p className=\\\"text-slate-400\\\">{t.pwaIosStep1}</p>\\n                      <p className=\\\"text-slate-400\\\">{t.pwaIosStep2}</p>\\n                    </div>\\n                  )}\\n                </div>\\n\\n                <div className=\\\"flex items-center justify-end gap-2\\\">\\n                  <button\\n                    type=\\\"button\\\"\\n                    onClick={() => setActionModal({ type: null })}\\n                    className=\\\"px-4 py-2 rounded-lg bg-slate-800 text-xs text-slate-300 hover:bg-slate-700 cursor-pointer\\\"\\n                  >\\n                    {t.btnClose}\\n                  </button>\\n                  <button\\n                    type=\\\"button\\\"\\n                    onClick={async () => {\\n                      if (deferredPrompt) {\\n                        await deferredPrompt.prompt();\\n                      }\\n                      setIsPwaInstalled(true);\\n                      try {\\n                        window.localStorage.setItem(\\n                          STORAGE_KEYS.PWA_SHORTCUT_PINNED,\\n                          \'true\'\\n                        );\\n                      } catch {}\\n                      setActionModal({ type: null });\\n                      triggerToast(t.toastPwaInstalled(activeCustomer.id));\\n                    }}\\n                    className=\\\"px-4 py-2 rounded-lg bg-amber-400 hover:bg-amber-300 text-slate-950 text-xs font-semibold cursor-pointer\\\"\\n                  >\\n                    {t.btnInstallPwaNow}\\n                  </button>\\n                </div>\\n              </div>\\n            ) : (\\n              <form\\n                onSubmit={(e) => {\\n                  e.preventDefault();\\n                  const targetEmail =\\n                    actionModal.emailInput || activeCustomer.email;\\n                  try {\\n                    window.localStorage.setItem(\\n                      STORAGE_KEYS.BACKUP_EMAIL,\\n                      targetEmail\\n                    );\\n                  } catch {}\\n                  setCustomers((prev) =>\\n                    prev.map((c) =>\\n                      c.id === activeCustomer.id\\n                        ? { ...c, email: targetEmail }\\n                        : c\\n                    )\\n                  );\\n                  setActionModal({ type: null });\\n                  triggerToast(\\n                    t.toastEmailSent(activeCustomer.id, targetEmail)\\n                  );\\n                }}\\n                className=\\\"space-y-4\\\"\\n              >\\n                <p className=\\\"text-xs text-slate-300 leading-relaxed\\\">\\n                  {t.emailModalDesc} (\\n                  <span className=\\\"font-mono tabular-nums text-amber-300\\\">\\n                    {activeCustomer.id}\\n                  </span>\\n                  ) {t.emailModalToAddress}\\n                </p>\\n                <div>\\n                  <label className=\\\"block text-xs text-slate-400 mb-1\\\">\\n                    {t.recipientEmailLabel}\\n                  </label>\\n                  <input\\n                    type=\\\"email\\\"\\n                    required\\n                    value={actionModal.emailInput ?? activeCustomer.email}\\n                    onChange={(e) =>\\n                      setActionModal((prev) => ({\\n                        ...prev,\\n                        emailInput: e.target.value,\\n                      }))\\n                    }\\n                    className=\\\"w-full h-10 px-3 rounded-lg bg-slate-950 border border-slate-800 text-sm text-slate-100 focus:outline-none focus:border-amber-400\\\"\\n                  />\\n                </div>\\n                <div className=\\\"flex items-center justify-end gap-2\\\">\\n                  <button\\n                    type=\\\"button\\\"\\n                    onClick={() => setActionModal({ type: null })}\\n                    className=\\\"px-4 py-2 rounded-lg bg-slate-800 text-xs text-slate-300 hover:bg-slate-700 cursor-pointer\\\"\\n                  >\\n                    {t.btnCancel}\\n                  </button>\\n                  <button\\n                    type=\\\"submit\\\"\\n                    className=\\\"px-4 py-2 rounded-lg bg-amber-400 hover:bg-amber-300 text-slate-950 text-xs font-semibold cursor-pointer\\\"\\n                  >\\n                    {t.btnSendRecovery}\\n                  </button>\\n                </div>\\n              </form>\\n            )}\\n          </div>\\n        </div>\\n      )}\\n\\n      {/* Offline Conne